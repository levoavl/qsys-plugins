-- <<< levo_assets.lua

LevoBrand = {
  Company = "levo AVL",
  Author  = "levo AVL | Elias Jenny",
  Address = { "Printzstraße 4", "76139 Karlsruhe", "Germany" },
  Web     = "www.levo.de",
  Mail    = "hello@levo.de",
  Repo    = "github.com/levoavl/qsys-plugins",
  License = "MIT License",

  -- levo AVL colour system (RGB for digital use)
  Colors = {
    Atlantic  = { 0, 70, 140 },     -- primary
    Amber     = { 255, 184, 48 },   -- accent, highlights, call-to-action
    Porcelain = { 245, 245, 243 },  -- light background
    Onyx      = { 25, 25, 25 },     -- text, contrast
    Mid       = { 120, 120, 120 },  -- secondary text (derived)
    AmberSoft = { 255, 219, 150 },  -- amber at reduced intensity, e.g. fading states (derived)
    Line      = { 214, 214, 210 },  -- hairlines, frames (derived from Porcelain)
    Haze      = { 172, 196, 222 },  -- secondary text on Atlantic (derived)
  },

  HeaderHeight = 40,
}

local C = LevoBrand.Colors

local function Image(asset, x, y, w)
  local h = math.floor(w * asset.Height / asset.Width + 0.5)
  return { Type = "Image", Image = asset.Data, Position = { x, y }, Size = { w, h } }, h
end

local function Text(text, x, y, w, h, size, color, style, align)
  return {
    Type = "Text", Text = text,
    Position = { x, y }, Size = { w, h },
    FontSize = size, FontStyle = style or "Regular",
    HTextAlign = align or "Left",
    Color = color or C.Onyx,
  }
end

-- Page background in Porcelain. Call first so everything else draws on top.
function LevoBrand.Background(graphics, width, height)
  table.insert(graphics, {
    Type = "GroupBox", Fill = C.Porcelain, StrokeWidth = 0, CornerRadius = 0,
    Position = { 0, 0 }, Size = { width, height },
  })
end

-- Atlantic header bar: small porcelain wordmark on the left, plugin name (bold)
-- and the current page on the right. Returns the y coordinate where page content
-- can start. `title` = plugin name, `subtitle` = page name (both optional).
function LevoBrand.Header(graphics, width, title, subtitle)
  local h = LevoBrand.HeaderHeight
  table.insert(graphics, {
    Type = "GroupBox", Fill = C.Atlantic, StrokeWidth = 0, CornerRadius = 0,
    Position = { 0, 0 }, Size = { width, h },
  })
  local logo, logoH = Image(LevoAssets.wordmark_porcelain, 12, 0, 68)
  logo.Position[2] = math.floor((h - logoH) / 2)
  table.insert(graphics, logo)
  if title and subtitle then
    table.insert(graphics, Text(title, 96, 4, width - 108, 18, 14, C.Porcelain, "Bold", "Right"))
    table.insert(graphics, Text(subtitle, 96, 21, width - 108, 14, 10, C.Haze, "Regular", "Right"))
  elseif title then
    table.insert(graphics, Text(title, 96, 0, width - 108, h, 14, C.Porcelain, "Bold", "Right"))
  end
  -- thin amber accent line under the header
  table.insert(graphics, {
    Type = "GroupBox", Fill = C.Amber, StrokeWidth = 0, CornerRadius = 0,
    Position = { 0, h }, Size = { width, 2 },
  })
  return h + 2
end

-- Plugin name without the "levo AVL~" library folder
function LevoBrand.PluginName(info)
  return (info.Name:gsub("^.-~", ""))
end

-- Content of the "About" page. `info` is the plugin's PluginInfo table.
function LevoBrand.About(graphics, x, y, width, info)
  local line = 18
  local logo, logoH = Image(LevoAssets.wordmark_atlantic, x, y, 160)
  table.insert(graphics, logo)
  y = y + logoH + 16

  local name = info.Name:gsub("^.-~", "")  -- strip the "levo AVL~" library folder
  table.insert(graphics, Text(name, x, y, width, 22, 16, C.Atlantic, "Bold"))
  y = y + 24
  table.insert(graphics, Text("Version " .. (info.BuildVersion or info.Version), x, y, width, line, 11, C.Mid))
  y = y + line + 12

  local rows = {
    LevoBrand.Company,
    LevoBrand.Address[1],
    LevoBrand.Address[2] .. ", " .. LevoBrand.Address[3],
    LevoBrand.Web .. "  ·  " .. LevoBrand.Mail,
  }
  for _, r in ipairs(rows) do
    table.insert(graphics, Text(r, x, y, width, line, 12, C.Onyx))
    y = y + line
  end
  y = y + 12

  table.insert(graphics, Text("Author: " .. LevoBrand.Author, x, y, width, line, 11, C.Onyx))
  y = y + line
  table.insert(graphics, Text("Source & updates: " .. LevoBrand.Repo, x, y, width, line, 11, C.Onyx))
  y = y + line
  table.insert(graphics, Text("Licensed under the " .. LevoBrand.License .. ". Provided as is, without warranty.",
    x, y, width, line, 11, C.Mid))
  y = y + line + 12

  table.insert(graphics, Text(
    "Not affiliated with or endorsed by QSC, LLC or the manufacturer of the controlled device. "
      .. "All trademarks belong to their respective owners.",
    x, y, width, line * 2, 10, C.Mid))
  return y + line * 2
end
-- <<< levo_brand.lua
-- >>> color_math.lua
-- (c) levo AVL | Elias Jenny - MIT License
-- Pure colour functions, used by the layout (swatch colours) and the runtime.
-- Colours are r, g, b in 0..1 unless noted otherwise.

ColorMath = {}

local function Clamp01(x)
  if x ~= x or x < 0 then return 0 end  -- x ~= x catches NaN
  if x > 1 then return 1 end
  return x
end
ColorMath.Clamp01 = Clamp01

function ColorMath.To255(x)
  return math.floor(Clamp01(x) * 255 + 0.5)
end

-- {r, g, b} in 0..255, as used by layout Color fields
function ColorMath.LayoutColor(r, g, b)
  return { ColorMath.To255(r), ColorMath.To255(g), ColorMath.To255(b) }
end

-- h 0..360, s and v 0..1
function ColorMath.HsvToRgb(h, s, v)
  s, v = Clamp01(s), Clamp01(v)
  local hh = (h % 360) / 60
  local i = math.floor(hh)
  local f = hh - i
  local p, q, t = v * (1 - s), v * (1 - s * f), v * (1 - s * (1 - f))
  if i == 0 then return v, t, p
  elseif i == 1 then return q, v, p
  elseif i == 2 then return p, v, t
  elseif i == 3 then return p, q, v
  elseif i == 4 then return t, p, v
  end
  return v, p, q
end

-- returns h 0..360, s 0..1, v 0..1 (h = 0 for greys)
function ColorMath.RgbToHsv(r, g, b)
  local max, min = math.max(r, g, b), math.min(r, g, b)
  local d = max - min
  local h = 0
  if d > 0 then
    if max == r then h = 60 * (((g - b) / d) % 6)
    elseif max == g then h = 60 * ((b - r) / d + 2)
    else h = 60 * ((r - g) / d + 4) end
  end
  return h, (max > 0) and (d / max) or 0, max
end

function ColorMath.ToHex(r, g, b)
  return string.format("#%02X%02X%02X", ColorMath.To255(r), ColorMath.To255(g), ColorMath.To255(b))
end

-- Accepts "#RRGGBB", "RRGGBB", "#RGB", "0xRRGGBB" (spaces ignored).
-- Returns r, g, b in 0..1 or nil for invalid input.
function ColorMath.ParseHex(s)
  if type(s) ~= "string" then return nil end
  s = s:gsub("%s", ""):gsub("^#", ""):gsub("^0[xX]", "")
  if #s == 3 then s = s:gsub(".", "%0%0") end
  if not s:match("^%x%x%x%x%x%x$") then return nil end
  return tonumber(s:sub(1, 2), 16) / 255, tonumber(s:sub(3, 4), 16) / 255, tonumber(s:sub(5, 6), 16) / 255
end

-- Black body approximation (Tanner Helland), good enough for LED white points.
-- k in Kelvin, valid 1000..40000.
function ColorMath.Kelvin(k)
  local t = math.max(1000, math.min(40000, k)) / 100
  local r, g, b
  if t <= 66 then
    r = 255
    g = 99.4708025861 * math.log(t) - 161.1195681661
    b = (t <= 19) and 0 or (138.5177312231 * math.log(t - 10) - 305.0447927307)
  else
    r = 329.698727446 * (t - 60) ^ -0.1332047592
    g = 288.1221695283 * (t - 60) ^ -0.0755148492
    b = 255
  end
  return Clamp01(r / 255), Clamp01(g / 255), Clamp01(b / 255)
end

-- Largest amount k (0..1) of emitter colour e that fits into c; c is reduced
-- by k * e in place. A fixture's white or amber LED is described by its colour e.
local function Extract(c, e)
  local k, any = 1, false
  for i = 1, 3 do
    if e[i] > 0.001 then
      any = true
      k = math.min(k, c[i] / e[i])
    end
  end
  if not any then return 0 end
  k = Clamp01(k)
  for i = 1, 3 do c[i] = Clamp01(c[i] - k * e[i]) end
  return k
end

-- Channel values for an LED layout ("RGB", "RGBW", "RGBA", "RGBWA").
-- opts.subtract: true = take the white/amber part out of RGB (accurate colour),
--                false = keep RGB and add white/amber on top (brighter).
-- opts.white / opts.amber: emitter colours { r, g, b }.
-- White is extracted before amber: it takes the common part, amber the warm rest.
-- Returns { R =, G =, B =, W =, A = } (W/A only when the layout has them).
function ColorMath.Mix(r, g, b, layout, opts)
  local c = { Clamp01(r), Clamp01(g), Clamp01(b) }
  local work = opts.subtract and c or { c[1], c[2], c[3] }
  local out = {}
  if layout:find("W", 1, true) then out.W = Extract(work, opts.white) end
  if layout:find("A", 1, true) then out.A = Extract(work, opts.amber) end
  out.R, out.G, out.B = c[1], c[2], c[3]
  return out
end

-- Inverse of Mix: the colour a set of channel values produces.
-- ch = { R =, G =, B =, W =, A = } in 0..1 (missing channels count as 0).
function ColorMath.Unmix(ch, opts)
  local r, g, b = ch.R or 0, ch.G or 0, ch.B or 0
  if opts.subtract then
    local w, a = ch.W or 0, ch.A or 0
    r = r + w * opts.white[1] + a * opts.amber[1]
    g = g + w * opts.white[2] + a * opts.amber[2]
    b = b + w * opts.white[3] + a * opts.amber[3]
  end
  return Clamp01(r), Clamp01(g), Clamp01(b)
end
-- <<< color_math.lua
-- >>> presets.lua
-- (c) levo AVL | Elias Jenny - MIT License
-- Fixed preset colours and the colour wheel, shared by layout and runtime.

ColorPresets = {
  { Name = "Red",     Hex = "#FF0000" },
  { Name = "Orange",  Hex = "#FF7F00" },
  { Name = "Amber",   Hex = "#FFBF00" },
  { Name = "Yellow",  Hex = "#FFFF00" },
  { Name = "Lime",    Hex = "#7FFF00" },
  { Name = "Green",   Hex = "#00FF00" },
  { Name = "Spring",  Hex = "#00FF7F" },
  { Name = "Cyan",    Hex = "#00FFFF" },
  { Name = "Azure",   Hex = "#007FFF" },
  { Name = "Blue",    Hex = "#0000FF" },
  { Name = "Violet",  Hex = "#7F00FF" },
  { Name = "Magenta", Hex = "#FF00FF" },
  { Name = "Rose",    Hex = "#FF007F" },
  { Name = "Warm White",    Hex = "#FFB46B" },  -- ~3000 K
  { Name = "Neutral White", Hex = "#FFDBBA" },  -- ~4500 K
  { Name = "White",   Hex = "#FFFFFF" },
}

-- Colour wheel on a d x d grid of cells (d odd, centre cell = white):
-- hue = angle (red on top, clockwise), saturation = distance from the centre,
-- always at full brightness. Returns hue, saturation of a cell, or nil when the
-- cell lies outside the circle.
function WheelCell(row, col, d)
  local c = (d + 1) / 2
  local radius = (d - 1) / 2
  local dx, dy = col - c, row - c
  local dist = math.sqrt(dx * dx + dy * dy)
  if dist > radius + 0.5 then return nil end
  local hue = math.deg(math.atan(dx, -dy)) % 360  -- Lua 5.3: two-argument atan
  return hue, math.min(1, dist / radius)
end
-- <<< presets.lua

PageNames = { "Presets", "Picker", "Outputs", "Setup", "About" }

-- LED layouts that always get level outputs
OutputLayouts = { "RGB", "RGBW", "RGBA", "RGBWA" }
ChannelNames = { R = "Red", G = "Green", B = "Blue", W = "White", A = "Amber", D = "Dimmer" }

-- Settings derived from the properties (also used at runtime via `Properties`)
function PickerConfig(props)
  local function num(name, default, min, max)
    local p = props[name]
    local v = math.floor(tonumber(p and p.Value) or default)
    return math.max(min, math.min(max, v))
  end
  local function str(name, default)
    local p = props[name]
    return (p and p.Value) or default
  end
  local cfg = {
    UserPresets = num("User Presets", 8, 0, 32),
    WheelSize = num("Picker Resolution", 17, 11, 31),
    SeparateDimmer = str("Dimmer", "Scale Outputs") == "Separate Output",
    Subtract = str("White/Amber Mixing", "Subtract (accurate)") == "Subtract (accurate)",
    LinkLayout = str("Console Link", "RGB"),
  }
  if cfg.WheelSize % 2 == 0 then cfg.WheelSize = cfg.WheelSize + 1 end  -- odd: one centre cell
  -- channels of the console link, in order (D = dimmer when it is a separate output)
  cfg.LinkChannels = {}
  if cfg.LinkLayout ~= "Off" then
    for ch in cfg.LinkLayout:gmatch(".") do cfg.LinkChannels[#cfg.LinkChannels + 1] = ch end
    if cfg.SeparateDimmer then cfg.LinkChannels[#cfg.LinkChannels + 1] = "D" end
  end
  return cfg
end

function GetColor(props)
  return LevoBrand.Colors.Atlantic
end

function GetPrettyName(props)
  return PluginInfo.Name:gsub("^.-~", "") .. "\n" .. PluginInfo.BuildVersion
end

function GetPages(props)
  local pages = {}
  for _, name in ipairs(PageNames) do
    table.insert(pages, { name = name })
  end
  return pages
end

function GetProperties()
  local props = {}
  -- >>> properties.lua
-- (c) levo AVL | Elias Jenny - MIT License
table.insert(props, { Name = "User Presets",   Type = "integer", Min = 0, Max = 32, Value = 8 })
-- colour wheel diameter in cells (odd; even values are rounded up)
table.insert(props, { Name = "Picker Resolution", Type = "integer", Min = 11, Max = 31, Value = 17 })
table.insert(props, {
  -- Scale Outputs: the dimmer is multiplied into every colour channel.
  -- Separate Output: colour channels stay at full level, the dimmer gets its own output.
  Name = "Dimmer",
  Type = "enum",
  Choices = { "Scale Outputs", "Separate Output" },
  Value = "Scale Outputs",
})
table.insert(props, {
  Name = "White/Amber Mixing",
  Type = "enum",
  Choices = { "Subtract (accurate)", "Add (brighter)" },
  Value = "Subtract (accurate)",
})
table.insert(props, {
  -- Percent controls (0-100 %) with input and output pin, for two-way wiring to
  -- console faders, e.g. the levo AVL grandMA2 plugin.
  Name = "Console Link",
  Type = "enum",
  Choices = { "Off", "RGB", "RGBW", "RGBA", "RGBWA" },
  Value = "RGB",
})
table.insert(props, {
  Name = "Debug Print",
  Type = "enum",
  Choices = { "None", "Basic", "Verbose" },
  Value = "None",
})
-- <<< properties.lua
  return props
end

function RectifyProperties(props)
  -- >>> rectify.lua
-- (c) levo AVL | Elias Jenny - MIT License
if props.plugin_show_debug.Value == false then
  props["Debug Print"].IsHidden = true
end
-- <<< rectify.lua
  return props
end

function GetPins(props)
  local pins = {}
  return pins
end

function GetControls(props)
  local ctrls = {}
  -- >>> controls.lua
-- (c) levo AVL | Elias Jenny - MIT License
local cfg = PickerConfig(props)

local function Add(def)
  def.Count = def.Count or 1
  if def.UserPin == nil then def.UserPin = true end
  table.insert(ctrls, def)
end
local function Level(name, pinStyle)  -- 0..255
  Add({ Name = name, ControlType = "Knob", ControlUnit = "Integer", Min = 0, Max = 255, PinStyle = pinStyle })
end
local function Percent(name, pinStyle)
  Add({ Name = name, ControlType = "Knob", ControlUnit = "Percent", Min = 0, Max = 100, PinStyle = pinStyle })
end
local function Trigger(name) Add({ Name = name, ControlType = "Button", ButtonType = "Trigger", PinStyle = "Input" }) end
local function TextIn(name) Add({ Name = name, ControlType = "Text", PinStyle = "Both" }) end
local function Swatch(name) Add({ Name = name, ControlType = "Indicator", IndicatorType = "Text", PinStyle = "Output" }) end

-- Current colour (each one is an input and shows the current state)
TextIn("Hex")
Level("Red", "Both")
Level("Green", "Both")
Level("Blue", "Both")
Add({ Name = "Hue", ControlType = "Knob", ControlUnit = "Integer", Min = 0, Max = 360, PinStyle = "Both" })
Percent("Saturation", "Both")
Percent("Brightness", "Both")
Add({ Name = "Kelvin", ControlType = "Knob", ControlUnit = "Integer", Min = 1000, Max = 10000, PinStyle = "Both" })
Percent("Dimmer", "Both")
Add({ Name = "Fade Time", ControlType = "Knob", ControlUnit = "Seconds", Min = 0, Max = 10, PinStyle = "Both" })
Swatch("Preview")
Add({ Name = "Status", ControlType = "Indicator", IndicatorType = "Status", PinStyle = "Output" })

-- Fixed presets
for i = 1, #ColorPresets do Trigger("Preset " .. i) end

-- Colour wheel cells: plugin UI only, no pins (a few hundred cells)
for row = 1, cfg.WheelSize do
  for col = 1, cfg.WheelSize do
    if WheelCell(row, col, cfg.WheelSize) then
      Add({ Name = ("Wheel %d.%d"):format(row, col), ControlType = "Button", ButtonType = "Trigger", UserPin = false })
    end
  end
end

-- User presets: press = recall, press while Store is on = save current colour
Add({ Name = "Store", ControlType = "Button", ButtonType = "Toggle", PinStyle = "Both" })
for i = 1, cfg.UserPresets do
  Trigger("User " .. i)
  Swatch("User " .. i .. " Swatch")
  TextIn("User " .. i .. " Hex")  -- holds the preset, persists with the design
end

-- LED calibration: colour of the white and amber emitters
TextIn("White LED Color")
TextIn("Amber LED Color")

-- Level outputs 0..255
for _, lay in ipairs(OutputLayouts) do
  for ch in lay:gmatch(".") do Level(lay .. " " .. ch, "Output") end
end
if cfg.SeparateDimmer then Level("Dimmer Level", "Output") end

-- Console link: percent, input + output pin for two-way wiring
for _, ch in ipairs(cfg.LinkChannels) do Percent("Link " .. ChannelNames[ch], "Both") end
-- <<< controls.lua
  return ctrls
end

function GetControlLayout(props)
  local layout, graphics = {}, {}
  local CurrentPage = PageNames[props["page_index"].Value]
  -- >>> layout.lua
-- (c) levo AVL | Elias Jenny - MIT License
local C = LevoBrand.Colors
local cfg = PickerConfig(props)
local M = 16  -- page margin

local W = 480
local content = {}  -- page graphics, drawn after background and header

local function Label(text, x, y, w, h, opts)
  opts = opts or {}
  table.insert(content, {
    Type = "Text", Text = text, Position = { x, y }, Size = { w, h or 18 },
    FontSize = opts.size or 11, FontStyle = opts.style or "Regular",
    HTextAlign = opts.align or "Left", Color = opts.color or C.Onyx,
  })
end

local function Section(text, y)
  Label(text, M, y, W - 2 * M, 20, { size = 13, style = "Bold", color = C.Atlantic })
  table.insert(content, {
    Type = "GroupBox", Fill = C.Amber, StrokeWidth = 0, CornerRadius = 0,
    Position = { M, y + 20 }, Size = { W - 2 * M, 2 },
  })
  return y + 28
end

local function Place(name, pretty, x, y, w, h, extra)
  local def = { PrettyName = pretty, Position = { x, y }, Size = { w, h } }
  for k, v in pairs(extra or {}) do def[k] = v end
  layout[name] = def
end

-- Colour button with a static layout colour (presets, wheel). Never recoloured at runtime.
local function ColorButton(name, pretty, x, y, w, h, r, g, b, flat)
  local col = ColorMath.LayoutColor(r, g, b)
  local def = { Style = "Button", Legend = "", Color = col, OffColor = col, CornerRadius = 2 }
  if flat then def.CornerRadius, def.StrokeWidth, def.Margin = 0, 0, 0 end
  Place(name, pretty, x, y, w, h, def)
end

-- Current colour bar, shown on every colour page
local function ColorBar(y)
  Place("Preview", "Color~Preview", M, y, 76, 76, { Style = "Text", Color = C.Line, CornerRadius = 2 })
  local x = M + 84
  Label("Hex", x - 8, y + 2, 52, 18, { align = "Right" })
  Place("Hex", "Color~Hex", x + 50, y, 84, 22, { Style = "Text", FontSize = 12 })
  Label("Fade", x + 146, y + 2, 40, 18, { align = "Right" })
  Place("Fade Time", "Color~Fade Time", x + 192, y, 56, 22, { Style = "Text" })
  local cx = x
  for _, ch in ipairs({ { "R", "Red" }, { "G", "Green" }, { "B", "Blue" } }) do
    Label(ch[1], cx - 8, y + 29, 52, 18, { align = "Right" })
    Place(ch[2], "Color~" .. ch[2], cx + 50, y + 27, 44, 22, { Style = "Text" })
    cx = cx + 92
  end
  Label("Dimmer", x - 8, y + 56, 52, 18, { align = "Right" })
  Place("Dimmer", "Color~Dimmer", x + 50, y + 56, 228, 18, { Style = "Fader", Color = C.Atlantic })
  return y + 92
end

local y = LevoBrand.HeaderHeight + 2 + 12
local H = 300

if CurrentPage == "Presets" then
  y = ColorBar(y)
  y = Section("Presets", y)
  local cols, cw = 8, (W - 2 * M) // 8
  for i, p in ipairs(ColorPresets) do
    local col, row = (i - 1) % cols, (i - 1) // cols
    local x, cy = M + col * cw, y + row * 52
    ColorButton("Preset " .. i, "Presets~" .. p.Name, x, cy, cw - 6, 30, ColorMath.ParseHex(p.Hex))
    Label(p.Name, x, cy + 31, cw - 6, 14, { size = 9, color = C.Mid, align = "Center" })
  end
  y = y + math.ceil(#ColorPresets / cols) * 52 + 4

  if cfg.UserPresets > 0 then
    y = Section("User Presets", y)
    Place("Store", "User Presets~Store", W - M - 72, y - 30, 72, 20,
      { Style = "Button", Legend = "Store", FontSize = 10, Color = C.Amber })
    for i = 1, cfg.UserPresets do
      local col, row = (i - 1) % cols, (i - 1) // cols
      local x, cy = M + col * cw, y + row * 54
      Place("User " .. i .. " Swatch", "User Presets~User " .. i .. "~Swatch", x, cy, cw - 6, 26,
        { Style = "Text", Color = C.Line, CornerRadius = 2 })
      Place("User " .. i, "User Presets~User " .. i .. "~Recall", x, cy + 28, cw - 6, 18,
        { Style = "Button", Legend = tostring(i), FontSize = 10, Color = C.Amber })
    end
    y = y + math.ceil(cfg.UserPresets / cols) * 54
  end
  H = y + M

elseif CurrentPage == "Picker" then
  y = ColorBar(y)
  y = Section("Picker", y)
  -- colour wheel (hue x saturation at full brightness), brightness fader to its right
  local d = cfg.WheelSize
  local cell = 320 // d
  local side = cell * d
  local x0 = M + (W - 2 * M - side - 40) // 2
  for row = 1, d do
    for col = 1, d do
      local hue, sat = WheelCell(row, col, d)
      if hue then
        local r, g, b = ColorMath.HsvToRgb(hue, sat, 1)  -- multiple returns only expand as the last argument
        ColorButton(("Wheel %d.%d"):format(row, col), ("Picker~Wheel~Row %d~Column %d"):format(row, col),
          x0 + (col - 1) * cell, y + (row - 1) * cell, cell, cell, r, g, b, true)
      end
    end
  end
  Place("Brightness", "Adjust~Brightness", x0 + side + 18, y, 22, side, { Style = "Fader", Color = C.Atlantic })
  y = y + side + 12
  y = Section("Adjust", y)
  for _, f in ipairs({ "Hue", "Saturation" }) do
    Label(f, M, y, 76, 18, { align = "Right" })
    Place(f, "Adjust~" .. f, M + 84, y, W - 2 * M - 84, 18, { Style = "Fader", Color = C.Atlantic })
    y = y + 26
  end
  Label("Kelvin", M, y + 2, 76, 18, { align = "Right" })
  Place("Kelvin", "Adjust~Kelvin", M + 84, y, 64, 22, { Style = "Text" })
  Label("1000 - 10000 K, sets a white point", M + 156, y + 2, 220, 18, { size = 10, color = C.Mid })
  H = y + 22 + M

elseif CurrentPage == "Outputs" then
  y = Section("Levels (0-255)", y)
  local colX = { R = 0, G = 1, B = 2, W = 3, A = 4 }
  local x0, cw = M + 76, 58
  for _, ch in ipairs({ "R", "G", "B", "W", "A" }) do
    Label(ChannelNames[ch], x0 + colX[ch] * cw, y, cw - 6, 16, { size = 10, color = C.Mid, align = "Center" })
  end
  y = y + 18
  for _, lay in ipairs(OutputLayouts) do
    Label(lay, M, y + 2, 68, 18, { style = "Bold", align = "Right" })
    for ch in lay:gmatch(".") do
      Place(lay .. " " .. ch, "Outputs~" .. lay .. "~" .. ChannelNames[ch], x0 + colX[ch] * cw, y, cw - 6, 22,
        { Style = "Text", IsReadOnly = true })
    end
    y = y + 28
  end
  if cfg.SeparateDimmer then
    Label("Dimmer", M, y + 2, 68, 18, { style = "Bold", align = "Right" })
    Place("Dimmer Level", "Outputs~Dimmer Level", x0, y, cw - 6, 22, { Style = "Text", IsReadOnly = true })
    y = y + 28
  end
  y = y + 8
  if #cfg.LinkChannels > 0 then
    y = Section("Console Link (" .. cfg.LinkLayout .. ", %)", y)
    local lx, lw = M, 80
    for _, ch in ipairs(cfg.LinkChannels) do
      local n = ChannelNames[ch]
      Label(n, lx, y, lw - 6, 16, { size = 10, color = C.Mid, align = "Center" })
      Place("Link " .. n, "Console Link~" .. n, lx, y + 18, lw - 6, 22, { Style = "Text", IsReadOnly = true })
      lx = lx + lw
    end
    y = y + 48
    Label("Wire each Link pin both ways to a console fader (out -> fader, fader -> in).",
      M, y, W - 2 * M, 16, { size = 10, color = C.Mid })
    y = y + 18
  end
  H = y + M

elseif CurrentPage == "Setup" then
  y = Section("LED Calibration", y)
  Label("White LED", M, y + 2, 76, 18, { align = "Right" })
  Place("White LED Color", "Setup~White LED Color", M + 84, y, 84, 22, { Style = "Text" })
  Label("Amber LED", M + 184, y + 2, 76, 18, { align = "Right" })
  Place("Amber LED Color", "Setup~Amber LED Color", M + 268, y, 84, 22, { Style = "Text" })
  y = y + 28
  Label("Hex color of the fixture's white and amber LEDs. Defaults: #FFFFFF, #FFBF00.",
    M, y, W - 2 * M, 16, { size = 10, color = C.Mid })
  y = y + 28

  if cfg.UserPresets > 0 then
    y = Section("User Presets", y)
    local cols, cw = 4, (W - 2 * M) // 4
    for i = 1, cfg.UserPresets do
      local col, row = (i - 1) % cols, (i - 1) // cols
      local x, cy = M + col * cw, y + row * 28
      Label(tostring(i), x, cy + 2, 22, 18, { align = "Right", color = C.Mid })
      Place("User " .. i .. " Hex", "User Presets~User " .. i .. "~Hex", x + 28, cy, cw - 40, 22, { Style = "Text" })
    end
    y = y + math.ceil(cfg.UserPresets / cols) * 28 + 8
  end

  y = Section("Status", y)
  Place("Status", "Status", M, y, W - 2 * M, 22)
  H = y + 22 + M

elseif CurrentPage == "About" then
  H = LevoBrand.About(content, M, y, W - 2 * M, PluginInfo) + M
end

LevoBrand.Background(graphics, W, H)
LevoBrand.Header(graphics, W, LevoBrand.PluginName(PluginInfo), CurrentPage)
for _, g in ipairs(content) do table.insert(graphics, g) end
-- <<< layout.lua
  return layout, graphics
end

if Controls then
  -- >>> runtime.lua
-- (c) levo AVL | Elias Jenny - MIT License
-- Runtime code: only runs on the Core or in Emulation mode. No network, pure logic.

local DebugLevel = ({ None = 0, Basic = 1, Verbose = 2 })[Properties["Debug Print"].Value] or 0
local Cfg = PickerConfig(Properties)

local TICK = 0.05          -- timer resolution (s), also the fade step
local FEEDBACK_HOLD = 1.0  -- after writing the console link, link input is only checked after this time
local FEEDBACK_TOL = 0.6   -- link input within this many % of what was sent counts as our own echo
local DEFAULT_WHITE, DEFAULT_AMBER = "#FFFFFF", "#FFBF00"
local EMPTY_SWATCH = string.format("#%02X%02X%02X", table.unpack(LevoBrand.Colors.Line))

local Now = 0              -- monotonic time in seconds, advanced by the main timer

-- The main timer only runs while something is pending (fade, link hold time). WakeTimer is used by the control handlers and so keeps the
-- timer referenced - on the Core a timer nothing references is garbage collected.
local MainTimer = Timer.New()
local TimerRunning = false
local function WakeTimer()
  if not TimerRunning then
    TimerRunning = true
    MainTimer:Start(TICK)
  end
end

local function Log(level, msg)
  if level <= DebugLevel then print(("[Color Picker] %s"):format(msg)) end
end

---------------------------------------------------------------------------
-- Control helpers (only write when the value changes)
---------------------------------------------------------------------------
local function SetValue(name, v)
  local c = Controls[name]
  if c and math.abs(c.Value - v) > 1e-6 then c.Value = v end
end

local function SetString(name, s)
  local c = Controls[name]
  if c and c.String ~= s then c.String = s end
end

local SwatchColors = {}  -- control name -> colour written last (avoid redundant writes)
local function SetSwatch(name, hex)
  if SwatchColors[name] ~= hex then
    SwatchColors[name] = hex
    Controls[name].Color = hex
  end
end

local STATUS = { OK = 0, Compromised = 1, Fault = 2, NotPresent = 3, Missing = 4, Initializing = 5 }
local function SetStatus(value, text)
  local c = Controls.Status
  if c.Value ~= value then c.Value = value end
  if c.String ~= text then c.String = text end
end

local function Warn(text)
  SetStatus(STATUS.Compromised, text)
  Log(1, "Warning: " .. text)
end

local function NormalizeHex(s)
  local r, g, b = ColorMath.ParseHex(s)
  if r then return ColorMath.ToHex(r, g, b) end
  return nil
end

---------------------------------------------------------------------------
-- State
---------------------------------------------------------------------------
-- Colour at full brightness of the dimmer: r, g, b 0..1; dim 0..1.
-- hue / sat are kept separately so they survive greys and black.
local State = { r = 1, g = 1, b = 1, dim = 1, hue = 0, sat = 0 }
local Fade = nil                 -- { from = {r,g,b}, to = {r,g,b}, t0, dur }
local LinkSent = {}              -- link channel -> last value written (%)
local LinkWrittenAt = -math.huge
local LinkPending = false        -- link input arrived during the hold time
local MixOpts = { subtract = Cfg.Subtract, white = { 1, 1, 1 }, amber = { 1, 0.749, 0 } }

local function Round2(x) return math.floor(x * 100 + 0.5) / 100 end

---------------------------------------------------------------------------
-- Outputs and display
---------------------------------------------------------------------------
local function WriteOutputs(writeLink)
  local r, g, b = State.r, State.g, State.b
  local scale = Cfg.SeparateDimmer and 1 or State.dim
  for _, lay in ipairs(OutputLayouts) do
    local mix = ColorMath.Mix(r, g, b, lay, MixOpts)
    for ch in lay:gmatch(".") do SetValue(lay .. " " .. ch, ColorMath.To255(mix[ch] * scale)) end
  end
  if Cfg.SeparateDimmer then SetValue("Dimmer Level", ColorMath.To255(State.dim)) end

  if writeLink and #Cfg.LinkChannels > 0 then
    local mix = ColorMath.Mix(r, g, b, Cfg.LinkLayout, MixOpts)
    for _, ch in ipairs(Cfg.LinkChannels) do
      local v = (ch == "D") and State.dim or mix[ch] * scale
      v = Round2(ColorMath.Clamp01(v) * 100)
      LinkSent[ch] = v
      SetValue("Link " .. ChannelNames[ch], v)
    end
    LinkWrittenAt = Now
    WakeTimer()  -- advances Now through the hold time
  end
end

-- skip: "rgb" / "hsv" = the user is moving these controls, don't write them back
local function ShowColor(skip)
  local r, g, b = State.r, State.g, State.b
  local hex = ColorMath.ToHex(r, g, b)
  SetString("Hex", hex)
  if skip ~= "rgb" then
    SetValue("Red", ColorMath.To255(r))
    SetValue("Green", ColorMath.To255(g))
    SetValue("Blue", ColorMath.To255(b))
  end
  local h, s, v = ColorMath.RgbToHsv(r, g, b)
  if skip ~= "hsv" then
    if v > 0.002 then
      if s > 0.002 then State.hue = h end
      State.sat = s
    end
    SetValue("Hue", math.floor(State.hue + 0.5))
    SetValue("Saturation", Round2(State.sat * 100))
    SetValue("Brightness", Round2(v * 100))
  end
  SetValue("Dimmer", Round2(State.dim * 100))
  SetSwatch("Preview", hex)
end

local function ClearWarning()
  if Controls.Status.Value ~= STATUS.OK then SetStatus(STATUS.OK, "OK") end
end

-- Set a new colour. opts.fade: use the fade time (discrete selections),
-- opts.skip: see ShowColor.
local function ApplyColor(r, g, b, opts)
  opts = opts or {}
  r, g, b = ColorMath.Clamp01(r), ColorMath.Clamp01(g), ColorMath.Clamp01(b)
  ClearWarning()
  local dur = opts.fade and Controls["Fade Time"].Value or 0
  if dur >= TICK then
    Fade = { from = { State.r, State.g, State.b }, to = { r, g, b }, t0 = Now, dur = dur }
    WakeTimer()
    Log(2, ("Fade to %s in %.1f s"):format(ColorMath.ToHex(r, g, b), dur))
    return
  end
  Fade = nil
  State.r, State.g, State.b = r, g, b
  ShowColor(opts.skip)
  WriteOutputs(true)
  Log(2, "Color " .. ColorMath.ToHex(r, g, b))
end

local function FadeStep()
  local t = math.min(1, (Now - Fade.t0) / Fade.dur)
  local f, to = Fade.from, Fade.to
  State.r = f[1] + (to[1] - f[1]) * t
  State.g = f[2] + (to[2] - f[2]) * t
  State.b = f[3] + (to[3] - f[3]) * t
  if t >= 1 then Fade = nil end
  ShowColor()
  WriteOutputs(true)
end

---------------------------------------------------------------------------
-- Console link feedback
---------------------------------------------------------------------------
local function LinkName(ch) return "Link " .. ChannelNames[ch] end

-- true when every link input still matches what we wrote (= our own echo)
local function LinkInSync()
  for _, ch in ipairs(Cfg.LinkChannels) do
    local sent = LinkSent[ch]
    if sent == nil or math.abs(Controls[LinkName(ch)].Value - sent) > FEEDBACK_TOL then return false end
  end
  return true
end

-- The console changed: take its levels as the new colour without writing back.
local function AdoptLink()
  local ch = {}
  for _, k in ipairs(Cfg.LinkChannels) do
    local v = Controls[LinkName(k)].Value
    ch[k] = ColorMath.Clamp01(v / 100)
    LinkSent[k] = v
  end
  local r, g, b = ColorMath.Unmix(ch, MixOpts)
  local dim = State.dim
  if Cfg.SeparateDimmer then
    if ch.D then dim = ch.D end
  else
    -- Console levels include the dimmer: divide it out, raise the dimmer if the
    -- console is brighter than the dimmer allows. All channels at 0 = dimmer 0,
    -- the colour is kept.
    local m = math.max(r, g, b)
    if m <= 0.002 then
      dim, r, g, b = 0, State.r, State.g, State.b
    else
      if m > dim then dim = m end
      r, g, b = r / dim, g / dim, b / dim
    end
  end
  Fade = nil
  State.r, State.g, State.b = ColorMath.Clamp01(r), ColorMath.Clamp01(g), ColorMath.Clamp01(b)
  State.dim = ColorMath.Clamp01(dim)
  ShowColor()
  WriteOutputs(false)
  Log(1, ("Console link changed -> %s, dimmer %d %%"):format(ColorMath.ToHex(State.r, State.g, State.b),
    math.floor(State.dim * 100 + 0.5)))
end

local function OnLinkInput(ctl)
  if LinkInSync() then return end  -- echo of our own write
  if Fade or (Now - LinkWrittenAt) < FEEDBACK_HOLD then
    LinkPending = true             -- console may still report old values, check later
    WakeTimer()
    Log(2, "Link input held during fade/hold time")
    return
  end
  AdoptLink()
end

---------------------------------------------------------------------------
-- LED calibration
---------------------------------------------------------------------------
local function LoadEmitter(name, key, default, warn)
  local c = Controls[name]
  local hex = NormalizeHex(c.String)
  if not hex then
    if warn and c.String ~= "" then Warn(("%s: invalid hex '%s'"):format(name, c.String)) end
    hex = MixOpts[key .. "Hex"] or default
  end
  SetString(name, hex)
  MixOpts[key .. "Hex"] = hex
  MixOpts[key] = { ColorMath.ParseHex(hex) }
end

---------------------------------------------------------------------------
-- User presets
---------------------------------------------------------------------------
local function ShowUser(i)
  local hex = NormalizeHex(Controls["User " .. i .. " Hex"].String)
  SetSwatch("User " .. i .. " Swatch", hex or EMPTY_SWATCH)
  SetString("User " .. i .. " Swatch", hex and "" or "empty")
end

---------------------------------------------------------------------------
-- Event handlers
---------------------------------------------------------------------------
Controls.Hex.EventHandler = function(c)
  local r, g, b = ColorMath.ParseHex(c.String)
  if not r then
    Warn(("Invalid hex '%s'"):format(c.String))
    SetString("Hex", ColorMath.ToHex(State.r, State.g, State.b))
    return
  end
  ApplyColor(r, g, b, { fade = true })
end

local function OnRgb()
  ApplyColor(Controls.Red.Value / 255, Controls.Green.Value / 255, Controls.Blue.Value / 255, { skip = "rgb" })
end
Controls.Red.EventHandler = OnRgb
Controls.Green.EventHandler = OnRgb
Controls.Blue.EventHandler = OnRgb

local function OnHsv()
  State.hue = Controls.Hue.Value
  State.sat = Controls.Saturation.Value / 100
  local r, g, b = ColorMath.HsvToRgb(State.hue, State.sat, Controls.Brightness.Value / 100)
  ApplyColor(r, g, b, { skip = "hsv" })
end
Controls.Hue.EventHandler = OnHsv
Controls.Saturation.EventHandler = OnHsv
Controls.Brightness.EventHandler = OnHsv

Controls.Kelvin.EventHandler = function(c)
  ApplyColor(ColorMath.Kelvin(c.Value))
end

Controls.Dimmer.EventHandler = function(c)
  State.dim = ColorMath.Clamp01(c.Value / 100)
  WriteOutputs(true)
end

for i, p in ipairs(ColorPresets) do
  local r, g, b = ColorMath.ParseHex(p.Hex)
  Controls["Preset " .. i].EventHandler = function()
    Log(1, "Preset " .. p.Name)
    ApplyColor(r, g, b, { fade = true })
  end
end

local WheelN = Cfg.WheelSize
for row = 1, WheelN do
  for col = 1, WheelN do
    local hue, sat = WheelCell(row, col, WheelN)
    if hue then
      Controls[("Wheel %d.%d"):format(row, col)].EventHandler = function()
        -- keep the brightness; from black a wheel choice gives full brightness
        local _, _, v = ColorMath.RgbToHsv(State.r, State.g, State.b)
        if v < 0.05 then v = 1 end
        if sat > 0 then State.hue = hue end  -- the white centre keeps the hue
        State.sat = sat
        local r, g, b = ColorMath.HsvToRgb(hue, sat, v)
        ApplyColor(r, g, b, { fade = true })
      end
    end
  end
end

for i = 1, Cfg.UserPresets do
  local hexName = "User " .. i .. " Hex"
  Controls["User " .. i].EventHandler = function()
    if Controls.Store.Boolean then
      local hex = ColorMath.ToHex(State.r, State.g, State.b)
      SetString(hexName, hex)
      Controls.Store.Boolean = false
      ShowUser(i)
      Log(1, ("User %d stored: %s"):format(i, hex))
      return
    end
    local r, g, b = ColorMath.ParseHex(Controls[hexName].String)
    if not r then
      Log(1, ("User %d is empty"):format(i))
      return
    end
    Log(1, ("User %d recalled"):format(i))
    ApplyColor(r, g, b, { fade = true })
  end
  Controls[hexName].EventHandler = function(c)
    if c.String ~= "" then
      local hex = NormalizeHex(c.String)
      if hex then SetString(hexName, hex) else Warn(("User %d: invalid hex '%s'"):format(i, c.String)) end
    end
    ShowUser(i)
  end
end

Controls["White LED Color"].EventHandler = function()
  LoadEmitter("White LED Color", "white", DEFAULT_WHITE, true)
  WriteOutputs(true)
end
Controls["Amber LED Color"].EventHandler = function()
  LoadEmitter("Amber LED Color", "amber", DEFAULT_AMBER, true)
  WriteOutputs(true)
end

for _, ch in ipairs(Cfg.LinkChannels) do
  Controls[LinkName(ch)].EventHandler = OnLinkInput
end

---------------------------------------------------------------------------
-- Timer: fades and delayed link checks
---------------------------------------------------------------------------
MainTimer.EventHandler = function()
  Now = Now + TICK
  if Fade then FadeStep() end
  if LinkPending and not Fade and (Now - LinkWrittenAt) >= FEEDBACK_HOLD then
    LinkPending = false
    if not LinkInSync() then AdoptLink() end
  end
  -- nothing pending: stop until the next WakeTimer
  if not Fade and not LinkPending and (Now - LinkWrittenAt) >= FEEDBACK_HOLD then
    MainTimer:Stop()
    TimerRunning = false
  end
end

---------------------------------------------------------------------------
-- Start
---------------------------------------------------------------------------
SetStatus(STATUS.Initializing, "Starting")
LoadEmitter("White LED Color", "white", DEFAULT_WHITE, false)
LoadEmitter("Amber LED Color", "amber", DEFAULT_AMBER, false)

-- Control values persist with the design / on the Core. An empty Hex field means
-- a fresh instance: start with white at full level.
local r, g, b = ColorMath.ParseHex(Controls.Hex.String)
if r then
  State.r, State.g, State.b = r, g, b
  State.dim = ColorMath.Clamp01(Controls.Dimmer.Value / 100)
  State.hue = Controls.Hue.Value
  State.sat = Controls.Saturation.Value / 100
  Log(1, "Restored " .. ColorMath.ToHex(r, g, b))
else
  State.dim = 1
  SetValue("Kelvin", 5600)
  Log(1, "Fresh instance, starting with white")
end
for i = 1, Cfg.UserPresets do ShowUser(i) end
ShowColor()
WriteOutputs(false)  -- the console keeps its state on start; its feedback is adopted when it arrives

SetStatus(STATUS.OK, "OK")
Log(1, ("Started, build %s - link %s, %d user preset(s)"):format(
  PluginInfo.BuildVersion, Cfg.LinkLayout, Cfg.UserPresets))
-- <<< runtime.lua
end
