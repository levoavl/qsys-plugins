PluginInfo = {
  Name         = "levo AVL~Color Picker",  -- "Folder~Name" in the Q-SYS schematic library
  Version      = "0.1",
  BuildVersion = "0.1",  -- versions are major.minor, see source/README.md
  Id           = "1b0b9461-55f3-4851-b3dc-41d681d875e5",
  Author       = "levo AVL | Elias Jenny",
  Description  = "Colour picker with presets, HSV, Kelvin and hex entry. Outputs RGB, RGBW, RGBA and RGBWA "
    .. "levels and a bidirectional link for lighting console faders.",
  ShowDebug    = true,
}
