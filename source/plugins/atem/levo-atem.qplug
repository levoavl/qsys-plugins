PluginInfo = {
  Name         = "levo AVL~ATEM Switcher",  -- "Folder~Name" in the Q-SYS schematic library
  Version      = "0.1",
  BuildVersion = "0.1",  -- versions are major.minor, see source/README.md
  Id           = "540f6f58-c34c-4c96-b2cc-1430d6b79789",
  Author       = "levo AVL | Elias Jenny",
  Description  = "Control Blackmagic ATEM switchers (all models, multi M/E) with feedback: "
    .. "program/preview, transitions, keyers, aux, SuperSource, media, macros, audio, streaming and recording.",
  ShowDebug    = true,
}
