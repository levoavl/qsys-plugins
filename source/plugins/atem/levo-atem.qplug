-- <<< atem_models.lua
-- >>> atem_topology.lua
-- (c) levo AVL | Elias Jenny - MIT License
-- Switcher topology: what the selected model (or the "Custom" settings) offers.
-- Used at design time (controls, pins, layout) and at runtime.

AtemTopology = {}

local T = AtemTopology

T.CUSTOM = "Custom"
T.DEFAULT_MODEL = "ATEM Mini Extreme"

-- ATEM internal port types (InPr)
T.Port = {
  External = 0, Black = 1, ColorBars = 2, ColorGenerator = 3, MediaPlayerFill = 4,
  MediaPlayerKey = 5, SuperSource = 6, ExternalDirect = 7,
  MEOutput = 128, Auxiliary = 129, Mask = 130, MultiViewer = 131, AudioMonitor = 132,
}

-- Source availability bits (InPr)
T.Avail = { Auxiliary = 1, Multiviewer = 2, SuperSourceArt = 4, SuperSourceBox = 8, KeySource = 16 }

T.TransitionStyles = { "Mix", "Dip", "Wipe", "DVE", "Stinger" }

-- Frames per second per ATEM video mode (VidM), as used for rates ("s:ff").
-- Interlaced modes count frames, 23.98/29.97/59.94 count like 24/30/60.
T.ModeFps = {
  [0] = 30, 25, 30, 25, 50, 60, 25, 30, 24, 24, 25, 30, 50, 60,
  24, 24, 25, 30, 50, 60, 24, 24, 25, 30, 50, 60, 30, 60,
}

-- 25 frames at 25 fps -> "1:00"
function T.FormatRate(frames, fps)
  fps = fps or 25
  return ("%d:%02d"):format(frames // fps, frames % fps)
end

-- "1:00" -> 25 (at 25 fps); a plain number is taken as frames. nil if invalid.
function T.ParseRate(text, fps)
  fps = fps or 25
  text = tostring(text or ""):gsub("%s", "")
  local s, f = text:match("^(%d+)[:%.,](%d+)$")
  local frames
  if s then
    frames = tonumber(s) * fps + tonumber(f)
  else
    frames = tonumber(text:match("^(%d+)$") or "")
  end
  if not frames or frames < 1 or frames > 250 then return nil end
  return math.floor(frames)
end

function T.ModelNames()
  local names = {}
  for _, m in ipairs(AtemModels) do names[#names + 1] = m.Name end
  table.sort(names)
  names[#names + 1] = T.CUSTOM
  return names
end

local function FindModel(name)
  for _, m in ipairs(AtemModels) do
    if m.Name == name then return m end
  end
end

function T.ModelById(id)
  for _, m in ipairs(AtemModels) do
    if m.Id == id then return m end
  end
end

local function Unpack(flat, width)
  local rows = {}
  for i = 1, #flat, width do
    local row = {}
    for k = 0, width - 1 do row[k + 1] = flat[i + k] end
    rows[#rows + 1] = row
  end
  return rows
end

-- Generic source list for the "Custom" model, modelled on the real switchers
local function CustomSources(c)
  local P, A = T.Port, T.Avail
  local allMe = (1 << c.MEs) - 1
  local base = A.Auxiliary | A.Multiviewer | A.KeySource
  if c.SuperSources > 0 then base = base | A.SuperSourceArt | A.SuperSourceBox end
  local list = {}
  local function add(id, port, sa, me) list[#list + 1] = { id, port, sa, me } end
  add(0, P.Black, base, allMe)
  for i = 1, c.Inputs do add(i, P.External, base, allMe) end
  add(1000, P.ColorBars, base, allMe)
  add(2001, P.ColorGenerator, base & ~A.KeySource, allMe)
  add(2002, P.ColorGenerator, base & ~A.KeySource, allMe)
  for i = 1, c.MediaPlayers do
    add(3000 + i * 10, P.MediaPlayerFill, base, allMe)
    add(3001 + i * 10, P.MediaPlayerKey, base, allMe)
  end
  for i = 1, c.SuperSources do
    add(5999 + i, P.SuperSource, base & ~A.SuperSourceArt & ~A.SuperSourceBox, allMe)
  end
  for i = 1, c.MEs do add(7000 + i, P.MEOutput, A.Auxiliary | A.Multiviewer, 0) end
  for i = 1, c.Aux do add(8000 + i, P.Auxiliary, A.Multiviewer, 0) end
  for n = 1, c.MEs do
    -- the output of M/E n can be used on the M/Es before it (re-entry)
    local me = (1 << (n - 1)) - 1
    add(10000 + n * 10, P.MEOutput, A.Auxiliary | A.Multiviewer | (n > 1 and A.SuperSourceBox or 0), me)
    add(10001 + n * 10, P.MEOutput, A.Auxiliary | A.Multiviewer | (n > 1 and A.SuperSourceBox or 0), me)
  end
  return list
end

local function PropValue(props, name, default)
  local p = props[name]
  if p == nil or p.Value == nil then return default end
  return p.Value
end

local function PropInt(props, name, default, min, max)
  local v = math.floor(tonumber(PropValue(props, name, default)) or default)
  return math.max(min, math.min(max, v))
end

-- Resolve the topology from the plugin properties.
function T.Resolve(props)
  local name = PropValue(props, "Model", T.DEFAULT_MODEL)
  local m = FindModel(name)
  local topo
  if m then
    topo = {
      Name = m.Name, Id = m.Id, MEs = m.MEs, USKs = m.USKs, DSKs = m.DSKs,
      SuperSources = m.SuperSources, Aux = m.Aux, MediaPlayers = m.MediaPlayers,
      Stills = m.Stills, Clips = m.Clips, Macros = m.Macros,
      Streaming = m.Streaming, Recording = m.Recording, RecordISO = m.RecordISO,
      Audio = m.Audio, AudioInputs = Unpack(m.AudioInputs, 2), Sources = Unpack(m.Sources, 4),
    }
  else
    local c = {
      MEs = PropInt(props, "Custom M/Es", 1, 1, 4),
      Inputs = PropInt(props, "Custom Inputs", 8, 1, 80),
      USKs = PropInt(props, "Custom Keyers per M/E", 4, 0, 4),
      DSKs = PropInt(props, "Custom Downstream Keyers", 2, 0, 4),
      Aux = PropInt(props, "Custom Aux Outputs", 2, 0, 48),
      MediaPlayers = PropInt(props, "Custom Media Players", 2, 0, 4),
      SuperSources = PropInt(props, "Custom SuperSources", 0, 0, 2),
    }
    local audio = PropValue(props, "Custom Audio", "Fairlight")
    local audioInputs = {}
    if audio ~= "None" then
      for i = 1, c.Inputs do audioInputs[#audioInputs + 1] = { i, 1 } end
    end
    topo = {
      Name = T.CUSTOM, Id = nil, MEs = c.MEs, USKs = c.USKs, DSKs = c.DSKs,
      SuperSources = c.SuperSources, Aux = c.Aux, MediaPlayers = c.MediaPlayers,
      Stills = 20, Clips = 0, Macros = 100,
      Streaming = PropValue(props, "Custom Streaming / Recording", false) == true,
      Recording = PropValue(props, "Custom Streaming / Recording", false) == true,
      RecordISO = false,
      Audio = audio, AudioInputs = audioInputs, Sources = CustomSources(c),
    }
  end
  topo.SourceById = {}
  for _, s in ipairs(topo.Sources) do topo.SourceById[s[1]] = s end
  return topo
end

---------------------------------------------------------------------------
-- Source names
---------------------------------------------------------------------------
-- Key: stable part of control names ("ME1 Program Input 3"), never changes with
-- the names set on the switcher. Short: default button legend.
function T.SourceKey(id)
  if id == 0 then return "Black", "BLK" end
  if id >= 1 and id < 1000 then return "Input " .. id, tostring(id) end
  if id == 1000 then return "Bars", "BARS" end
  if id == 2001 or id == 2002 then return "Color " .. (id - 2000), "COL" .. (id - 2000) end
  if id == 3210 then return "Thunderbolt", "TB" end
  if id == 3211 then return "Thunderbolt Key", "TBK" end
  if id > 3000 and id < 3100 then
    local n = (id - 3000) // 10
    if id % 10 == 1 then return "MP" .. n .. " Key", "MP" .. n .. "K" end
    return "MP" .. n, "MP" .. n
  end
  if id >= 4000 and id < 5000 then return "Key Mask " .. ((id - 4000) // 10), "MSK" end
  if id >= 5000 and id < 6000 then return "DSK Mask " .. ((id - 5000) // 10), "MSK" end
  if id == 6000 then return "SuperSource", "SS" end
  if id > 6000 and id < 6010 then return "SuperSource " .. (id - 5999), "SS" .. (id - 5999) end
  if id > 7000 and id < 7100 then return "Clean Feed " .. (id - 7000), "CF" .. (id - 7000) end
  if id > 8000 and id < 8100 then return "Aux " .. (id - 8000), "AUX" .. (id - 8000) end
  if id > 9000 and id < 9100 then return "Multiview " .. (id - 9000), "MV" .. (id - 9000) end
  if id >= 10010 and id < 10100 then
    local n = (id - 10000) // 10
    if id % 10 == 1 then return "ME" .. n .. " PVW", "M" .. n .. "PV" end
    return "ME" .. n .. " PGM", "M" .. n .. "PG"
  end
  if id > 11000 and id < 11100 then return "Direct " .. (id - 11000), "DIR" .. (id - 11000) end
  return "Source " .. id, tostring(id)
end

-- Order like ATEM Software Control: external inputs first, then Black, Bars,
-- colours, media players ... (stable: keeps the given order inside both groups).
-- portOf(id) returns the internal port type of a source.
function T.SortSources(ids, portOf)
  local inputs, rest = {}, {}
  for _, id in ipairs(ids) do
    if portOf(id) == T.Port.External then inputs[#inputs + 1] = id else rest[#rest + 1] = id end
  end
  for _, id in ipairs(rest) do inputs[#inputs + 1] = id end
  return inputs
end

local function TopoPort(topo)
  return function(id)
    local s = topo.SourceById[id]
    return s and s[2]
  end
end

-- Sources that get a button on the M/E buses. Mode: "All Sources" | "Inputs Only" | "None"
local ME_BUTTON_PORTS = {
  [T.Port.External] = true, [T.Port.Black] = true, [T.Port.ColorBars] = true,
  [T.Port.ColorGenerator] = true, [T.Port.MediaPlayerFill] = true,
  [T.Port.SuperSource] = true, [T.Port.MEOutput] = true,
}

function T.MEButtonSources(topo, me, mode)
  local ids = {}
  if mode == "None" then return ids end
  local bit = 1 << (me - 1)
  for _, s in ipairs(topo.Sources) do
    local id, port, _, meAvail = s[1], s[2], s[3], s[4]
    if meAvail & bit ~= 0 then
      if (mode == "Inputs Only" and port == T.Port.External) or (mode ~= "Inputs Only" and ME_BUTTON_PORTS[port]) then
        ids[#ids + 1] = id
      end
    end
  end
  return T.SortSources(ids, TopoPort(topo))
end

-- All sources that can go on an M/E bus (combo boxes)
function T.MESources(topo, me)
  local ids, bit = {}, 1 << (me - 1)
  for _, s in ipairs(topo.Sources) do
    if s[4] & bit ~= 0 then ids[#ids + 1] = s[1] end
  end
  return T.SortSources(ids, TopoPort(topo))
end

-- Source availability for aux n (the Mini Extreme has extra bits for aux 1 / 2)
function T.AuxAvailable(aux, sa)
  if sa & T.Avail.Auxiliary ~= 0 then return true end
  if aux == 1 and sa & 32 ~= 0 then return true end
  if aux == 2 and sa & 64 ~= 0 then return true end
  return false
end

-- Button sources for aux, SuperSource boxes: same ports as the M/E buttons
local function ButtonSources(topo, mode, accept)
  local ids = {}
  if mode == "None" then return ids end
  for _, s in ipairs(topo.Sources) do
    local id, port, sa = s[1], s[2], s[3]
    if accept(sa) and ((mode == "Inputs Only" and port == T.Port.External)
        or (mode ~= "Inputs Only" and ME_BUTTON_PORTS[port])) then
      ids[#ids + 1] = id
    end
  end
  return T.SortSources(ids, TopoPort(topo))
end

function T.AuxButtonSources(topo, aux, mode)
  return ButtonSources(topo, mode, function(sa) return T.AuxAvailable(aux, sa) end)
end

function T.BoxButtonSources(topo, mode)
  return ButtonSources(topo, mode, function(sa) return sa & T.Avail.SuperSourceBox ~= 0 end)
end

T.BOXES = 4   -- boxes per SuperSource
T.AUX_PER_PAGE = 8

function T.AuxMode(props)
  return PropValue(props, "Aux Buttons", "All Sources")
end

-- All button grids in page order. A source name is placed under the first grid
-- that contains the source (a control can only be placed once in the layout).
function T.Grids(topo, props)
  local mode, auxMode = T.ButtonMode(props), T.AuxMode(props)
  local grids = {}
  for me = 1, topo.MEs do
    grids[#grids + 1] = { key = "me" .. me, ids = T.MEButtonSources(topo, me, mode) }
  end
  for aux = 1, topo.Aux do
    grids[#grids + 1] = { key = "aux" .. aux, ids = T.AuxButtonSources(topo, aux, auxMode) }
  end
  local boxIds = T.BoxButtonSources(topo, mode)
  for ss = 1, topo.SuperSources do
    for box = 1, T.BOXES do
      grids[#grids + 1] = { key = "ss" .. ss .. "." .. box, ids = boxIds }
    end
  end
  return grids
end

-- { grid key -> list of source ids whose name goes under that grid }, and the
-- list of all named sources in order
function T.NamePlacement(topo, props)
  local seen, owner, all = {}, {}, {}
  for _, g in ipairs(T.Grids(topo, props)) do
    owner[g.key] = {}
    for _, id in ipairs(g.ids) do
      if not seen[id] then
        seen[id] = true
        table.insert(owner[g.key], id)
        all[#all + 1] = id
      end
    end
  end
  return owner, all
end

-- Pages of the plugin
function T.Pages(topo)
  local pages = {}
  for me = 1, topo.MEs do pages[#pages + 1] = "M/E " .. me end
  if topo.USKs > 0 or topo.DSKs > 0 then pages[#pages + 1] = "Keyers" end
  if topo.Aux > 0 then
    if topo.Aux <= T.AUX_PER_PAGE then
      pages[#pages + 1] = "Aux"
    else
      for first = 1, topo.Aux, T.AUX_PER_PAGE do
        pages[#pages + 1] = ("Aux %d-%d"):format(first, math.min(topo.Aux, first + T.AUX_PER_PAGE - 1))
      end
    end
  end
  for ss = 1, topo.SuperSources do
    pages[#pages + 1] = topo.SuperSources > 1 and ("SuperSource " .. ss) or "SuperSource"
  end
  pages[#pages + 1] = "Setup"
  pages[#pages + 1] = "About"
  return pages
end

function T.ButtonMode(props)
  return PropValue(props, "Source Buttons", "All Sources")
end
-- <<< atem_topology.lua

function PageList(props)
  return AtemTopology.Pages(AtemTopology.Resolve(props))
end

function GetColor(props)
  return LevoBrand.Colors.Atlantic
end

function GetPrettyName(props)
  local model = props and props["Model"] and props["Model"].Value or ""
  return PluginInfo.Name:gsub("^.-~", "") .. "\n" .. model .. "\n" .. PluginInfo.BuildVersion
end

function GetPages(props)
  local pages = {}
  for _, name in ipairs(PageList(props)) do
    table.insert(pages, { name = name })
  end
  return pages
end

function GetProperties()
  local props = {}
  -- >>> properties.lua
-- (c) levo AVL | Elias Jenny - MIT License
table.insert(props, {
  Name = "Model",
  Type = "enum",
  Choices = AtemTopology.ModelNames(),
  Value = AtemTopology.DEFAULT_MODEL,
})
-- Only used with Model = Custom
table.insert(props, { Name = "Custom M/Es", Type = "integer", Min = 1, Max = 4, Value = 1 })
table.insert(props, { Name = "Custom Inputs", Type = "integer", Min = 1, Max = 80, Value = 8 })
table.insert(props, { Name = "Custom Keyers per M/E", Type = "integer", Min = 0, Max = 4, Value = 4 })
table.insert(props, { Name = "Custom Downstream Keyers", Type = "integer", Min = 0, Max = 4, Value = 2 })
table.insert(props, { Name = "Custom Aux Outputs", Type = "integer", Min = 0, Max = 48, Value = 2 })
table.insert(props, { Name = "Custom Media Players", Type = "integer", Min = 0, Max = 4, Value = 2 })
table.insert(props, { Name = "Custom SuperSources", Type = "integer", Min = 0, Max = 2, Value = 0 })
table.insert(props, {
  Name = "Custom Audio", Type = "enum", Choices = { "Fairlight", "Classic", "None" }, Value = "Fairlight",
})
table.insert(props, { Name = "Custom Streaming / Recording", Type = "boolean", Value = false })

table.insert(props, {
  -- Buttons per source on the M/E buses. The combo boxes always list every source.
  Name = "Source Buttons",
  Type = "enum",
  Choices = { "All Sources", "Inputs Only", "None" },
  Value = "All Sources",
})
table.insert(props, {
  -- Buttons per source on every aux output (combo boxes always list every source).
  -- Large switchers: up to 48 aux x 100 sources - use "Inputs Only" or "None" there.
  Name = "Aux Buttons",
  Type = "enum",
  Choices = { "All Sources", "Inputs Only", "None" },
  Value = "All Sources",
})
table.insert(props, {
  -- "Device Names" writes the switcher's short source names as button legends.
  -- That overrides any legend set on UCI copies of the buttons, hence off by default.
  Name = "Button Legends",
  Type = "enum",
  Choices = { "Default Names", "Device Names" },
  Value = "Default Names",
})
table.insert(props, {
  Name = "Debug Print",
  Type = "enum",
  Choices = { "None", "Basic", "Verbose" },
  Value = "None",
})
-- <<< properties.lua
  return props
end

function RectifyProperties(props)
  -- >>> rectify.lua
-- (c) levo AVL | Elias Jenny - MIT License
local custom = props["Model"].Value == AtemTopology.CUSTOM
for _, name in ipairs({
  "Custom M/Es", "Custom Inputs", "Custom Keyers per M/E", "Custom Downstream Keyers",
  "Custom Aux Outputs", "Custom Media Players", "Custom SuperSources", "Custom Audio",
  "Custom Streaming / Recording",
}) do
  props[name].IsHidden = not custom
end
if props.plugin_show_debug.Value == false then
  props["Debug Print"].IsHidden = true
end
-- <<< rectify.lua
  return props
end

function GetPins(props)
  local pins = {}
  return pins
end

function GetControls(props)
  local ctrls = {}
  -- >>> controls.lua
-- (c) levo AVL | Elias Jenny - MIT License
local topo = AtemTopology.Resolve(props)
local mode = AtemTopology.ButtonMode(props)

local function Add(def)
  def.Count = def.Count or 1
  if def.UserPin == nil then def.UserPin = true end
  table.insert(ctrls, def)
end
local function TextOut(name) Add({ Name = name, ControlType = "Indicator", IndicatorType = "Text", PinStyle = "Output" }) end
local function Led(name)     Add({ Name = name, ControlType = "Indicator", IndicatorType = "Led", PinStyle = "Output" }) end
local function Toggle(name)  Add({ Name = name, ControlType = "Button", ButtonType = "Toggle", PinStyle = "Both" }) end
local function Trigger(name) Add({ Name = name, ControlType = "Button", ButtonType = "Trigger", PinStyle = "Input" }) end
local function TextIn(name)  Add({ Name = name, ControlType = "Text", PinStyle = "Both" }) end
local function Int(name, min, max)
  Add({ Name = name, ControlType = "Knob", ControlUnit = "Integer", Min = min, Max = max, PinStyle = "Both" })
end
local function Float(name)
  Add({ Name = name, ControlType = "Knob", ControlUnit = "Float", Min = 0, Max = 1, PinStyle = "Both" })
end

-- Connection
TextIn("IP Address")
Trigger("Reconnect")
Add({ Name = "Status", ControlType = "Indicator", IndicatorType = "Status", PinStyle = "Output" })
Led("Connected")
TextOut("Device")
TextOut("Protocol Version")
TextOut("Last Error")
TextOut("Reconnects")

-- Source names as reported by the switcher (for UCI labels)
local _, named = AtemTopology.NamePlacement(topo, props)
for _, id in ipairs(named) do
  TextOut("Name " .. AtemTopology.SourceKey(id))
end

-- M/E blocks
for me = 1, topo.MEs do
  local p = "ME" .. me .. " "
  TextIn(p .. "Program")   -- combo box: source name
  TextIn(p .. "Preview")
  for _, id in ipairs(AtemTopology.MEButtonSources(topo, me, mode)) do
    local key = AtemTopology.SourceKey(id)
    Toggle(p .. "Program " .. key)
    Toggle(p .. "Preview " .. key)
  end
  Trigger(p .. "Cut")
  Toggle(p .. "Auto")              -- lit while a transition runs
  Float(p .. "T-Bar")
  Led(p .. "In Transition")
  Toggle(p .. "Fade to Black")     -- lit while black / fading
  TextIn(p .. "Fade to Black Rate")   -- "s:ff" like ATEM Software Control
  TextIn(p .. "Transition Style")  -- combo box
  for _, style in ipairs(AtemTopology.TransitionStyles) do Toggle(p .. "Style " .. style) end
  TextIn(p .. "Transition Rate")      -- "s:ff"
  Toggle(p .. "Preview Transition")
  Toggle(p .. "Next Background")
  for k = 1, topo.USKs do
    Toggle(p .. "Next Key " .. k)
    Toggle(p .. "Key " .. k .. " On Air")
    TextIn(p .. "Key " .. k .. " Fill")   -- combo box
    TextIn(p .. "Key " .. k .. " Key")    -- combo box (key / cut source)
    TextOut(p .. "Key " .. k .. " Type")
  end
end

-- Downstream keyers
for n = 1, topo.DSKs do
  local p = "DSK " .. n .. " "
  Toggle(p .. "On Air")
  Toggle(p .. "Tie")
  Toggle(p .. "Auto")              -- lit while the DSK mixes
  Led(p .. "In Transition")
  TextIn(p .. "Rate")              -- "s:ff"
  TextIn(p .. "Fill")              -- combo box
  TextIn(p .. "Key")               -- combo box
end

-- Aux outputs
local auxMode = AtemTopology.AuxMode(props)
for aux = 1, topo.Aux do
  TextIn("Aux " .. aux)            -- combo box
  for _, id in ipairs(AtemTopology.AuxButtonSources(topo, aux, auxMode)) do
    Toggle("Aux " .. aux .. " " .. AtemTopology.SourceKey(id))
  end
end

-- SuperSource boxes
local boxIds = AtemTopology.BoxButtonSources(topo, mode)
for ss = 1, topo.SuperSources do
  for box = 1, AtemTopology.BOXES do
    local p = "SS" .. ss .. " Box " .. box .. " "
    Toggle(p .. "Enable")
    TextIn(p .. "Source")          -- combo box
    for _, id in ipairs(boxIds) do Toggle(p .. AtemTopology.SourceKey(id)) end
  end
end
-- <<< controls.lua
  return ctrls
end

function GetControlLayout(props)
  local layout, graphics = {}, {}
  local CurrentPage = PageList(props)[props["page_index"].Value] or "Setup"
  -- >>> layout.lua
-- (c) levo AVL | Elias Jenny - MIT License
local C = LevoBrand.Colors
local topo = AtemTopology.Resolve(props)
local mode = AtemTopology.ButtonMode(props)
local M = 16  -- page margin

local function Label(text, x, y, w, h, opts)
  opts = opts or {}
  table.insert(graphics, {
    Type = "Text", Text = text, Position = { x, y }, Size = { w, h or 18 },
    FontSize = opts.size or 11, FontStyle = opts.style or "Regular",
    HTextAlign = opts.align or "Left", Color = opts.color or C.Onyx,
  })
end

local function Section(text, x, y, w)
  Label(text, x, y, w, 20, { size = 13, style = "Bold", color = C.Atlantic })
  table.insert(graphics, {
    Type = "GroupBox", Fill = C.Amber, StrokeWidth = 0, CornerRadius = 0,
    Position = { x, y + 20 }, Size = { w, 2 },
  })
  return y + 28
end

local function Place(name, pretty, x, y, w, h, extra)
  local def = { PrettyName = pretty, Position = { x, y }, Size = { w, h } }
  for k, v in pairs(extra or {}) do def[k] = v end
  layout[name] = def
end

local function Button(name, pretty, legend, x, y, w, h, color, extra)
  local def = { Style = "Button", Legend = legend, FontSize = 11, FontStyle = "Bold", Color = color or C.Amber }
  for k, v in pairs(extra or {}) do def[k] = v end
  Place(name, pretty, x, y, w, h, def)
end

local W, H = 640, 400
local y = LevoBrand.HeaderHeight + 2 + 10

local BW, BH, GAP = 60, 40, 4   -- source buttons
local NAME_H = 16
local nameOwner = AtemTopology.NamePlacement(topo, props)
local FLAT = { Style = "Text", Color = C.Porcelain, StrokeWidth = 0, FontSize = 11, TextColor = C.Onyx, HTextAlign = "Left" }

local function GridShape(n)
  local rows = math.max(1, math.ceil(n / 16))
  return math.max(1, math.ceil(n / rows)), rows
end

-- Buttons for `ids`; name(id) -> control name, pretty(id) -> pretty name
local function SourceGrid(ids, x, gy, color, name, pretty)
  local cols, rows = GridShape(#ids)
  for i, id in ipairs(ids) do
    local _, short = AtemTopology.SourceKey(id)
    local col, row = (i - 1) % cols, (i - 1) // cols
    Button(name(id), pretty(id), short, x + col * (BW + GAP), gy + row * (BH + GAP), BW, BH, color)
  end
  return rows * (BH + GAP)
end

-- Source names (from the switcher) in the grid columns of `ids`, for the ones
-- this grid owns. Returns the height used (0 when there is nothing to place).
local function NameGrid(gridKey, ids, x, gy)
  local owned = {}
  for _, id in ipairs(nameOwner[gridKey] or {}) do owned[id] = true end
  if not next(owned) then return 0 end
  local cols, rows = GridShape(#ids)
  for i, id in ipairs(ids) do
    if owned[id] then
      local key = AtemTopology.SourceKey(id)
      local col, row = (i - 1) % cols, (i - 1) // cols
      Place("Name " .. key, "Source Names~" .. key, x + col * (BW + GAP), gy + row * (NAME_H + 2), BW, NAME_H,
        { Style = "Text", Color = C.Porcelain, StrokeWidth = 0, FontSize = 9, TextColor = C.Mid, HTextAlign = "Center" })
    end
  end
  return rows * (NAME_H + 2) + 4
end

local function GridWidth(n)
  local cols = GridShape(n)
  return cols * (BW + GAP) - GAP
end

local function NoButtons(prop, x, gy, w)
  Label("Source buttons are off (property \"" .. prop .. "\") - use the combo box.", x, gy, w, 18,
    { size = 10, color = C.Mid })
  return 24
end

local meIndex = CurrentPage and tonumber(CurrentPage:match("^M/E (%d+)$"))
local auxFirst, auxLast = nil, nil
if CurrentPage == "Aux" then
  auxFirst, auxLast = 1, topo.Aux
elseif CurrentPage then
  local f, l = CurrentPage:match("^Aux (%d+)%-(%d+)$")
  if f then auxFirst, auxLast = tonumber(f), tonumber(l) end
end
local ssIndex = nil
if CurrentPage == "SuperSource" then ssIndex = 1
elseif CurrentPage then ssIndex = tonumber(CurrentPage:match("^SuperSource (%d+)$")) end

if meIndex then
  local me = meIndex
  local p = "ME" .. me .. " "
  local g = "M/E " .. me .. "~"
  local ids = AtemTopology.MEButtonSources(topo, me, mode)
  local contentW = math.max(GridWidth(#ids), 760)
  W = M * 2 + contentW

  local function Bus(bus, color)
    y = Section(bus, M, y, contentW)
    Label(bus .. " source", M + contentW - 330, y - 28, 120, 20, { align = "Right", color = C.Mid })
    Place(p .. bus, g .. bus .. "~Source", M + contentW - 200, y - 28, 200, 20, { Style = "ComboBox" })
    if #ids == 0 then
      y = y + NoButtons("Source Buttons", M, y, contentW)
    else
      y = y + SourceGrid(ids, M, y, color,
        function(id) return p .. bus .. " " .. AtemTopology.SourceKey(id) end,
        function(id) return g .. bus .. "~" .. AtemTopology.SourceKey(id) end) + 4
    end
  end
  Bus("Preview", C.TallyGreen)
  y = y + NameGrid("me" .. me, ids, M, y)
  Bus("Program", C.TallyRed)
  y = y + 4

  -- Transition area: settings on the left, Cut / Auto / T-bar / FTB on the right
  y = Section("Transition", M, y, contentW)
  local top = y
  local lx, lw = M, 96
  local SW = 64
  Label("Style", lx, y + 6, lw - 8, 18, { align = "Right" })
  for i, style in ipairs(AtemTopology.TransitionStyles) do
    Button(p .. "Style " .. style, g .. "Transition~Style " .. style, style:upper(),
      lx + lw + (i - 1) * (SW + GAP), y, SW, 30, C.Atlantic, { FontSize = 10 })
  end
  y = y + 36
  Label("Next", lx, y + 6, lw - 8, 18, { align = "Right" })
  Button(p .. "Next Background", g .. "Transition~Next Background", "BKGD", lx + lw, y, SW, 30, C.Amber, { FontSize = 10 })
  for k = 1, topo.USKs do
    Button(p .. "Next Key " .. k, g .. "Transition~Next Key " .. k, "KEY " .. k,
      lx + lw + k * (SW + GAP), y, SW, 30, C.Amber, { FontSize = 10 })
  end
  y = y + 36
  if topo.USKs > 0 then
    Label("Key On Air", lx, y + 6, lw - 8, 18, { align = "Right" })
    for k = 1, topo.USKs do
      Button(p .. "Key " .. k .. " On Air", g .. "Keyers~Key " .. k .. " On Air", "ON AIR",
        lx + lw + k * (SW + GAP), y, SW, 30, C.TallyRed, { FontSize = 10 })
    end
    y = y + 36
  end
  Label("Rate", lx, y + 3, lw - 8, 18, { align = "Right" })
  Place(p .. "Transition Rate", g .. "Transition~Rate", lx + lw, y, SW, 22, { Style = "Text" })
  Label("Style", lx + lw + SW + 12, y + 3, 40, 18, { align = "Right" })
  Place(p .. "Transition Style", g .. "Transition~Style", lx + lw + SW + 56, y, 120, 22, { Style = "ComboBox" })
  y = y + 30
  Label("Preview Trans.", lx, y + 6, lw - 8, 18, { align = "Right" })
  Button(p .. "Preview Transition", g .. "Transition~Preview Transition", "PREV TRANS", lx + lw, y, SW * 2 + GAP, 30,
    C.Amber, { FontSize = 10 })
  local leftBottom = y + 36

  -- right block
  local rx = M + contentW - 300
  y = top
  Button(p .. "Cut", g .. "Transition~Cut", "CUT", rx, y, 90, 56, C.Atlantic, { FontSize = 14 })
  Button(p .. "Auto", g .. "Transition~Auto", "AUTO", rx, y + 64, 90, 56, C.TallyRed, { FontSize = 14 })
  Label("In Transition", rx - 4, y + 128, 80, 16, { size = 10, color = C.Mid })
  Place(p .. "In Transition", g .. "Transition~In Transition", rx + 76, y + 128, 14, 14, { Color = C.Amber })
  Place(p .. "T-Bar", g .. "Transition~T-Bar", rx + 110, y, 44, 150, { Style = "Fader", Color = C.Atlantic })
  Button(p .. "Fade to Black", g .. "Fade to Black~Fade to Black", "FTB", rx + 190, y, 90, 56, C.TallyRed, { FontSize = 14 })
  Label("FTB rate", rx + 190, y + 64, 90, 16, { size = 10, color = C.Mid })
  Place(p .. "Fade to Black Rate", g .. "Fade to Black~Rate", rx + 190, y + 80, 90, 22, { Style = "Text" })
  y = math.max(leftBottom, top + 160)

  -- Downstream keyers act on the program output: on the first M/E page
  if me == 1 and topo.DSKs > 0 then
    y = Section("Downstream Keys", M, y, contentW)
    local gw = 380
    for n = 1, topo.DSKs do
      local col, row = (n - 1) % 2, (n - 1) // 2
      local x, ry = M + col * gw, y + row * 38
      local d, dg = "DSK " .. n .. " ", "DSK " .. n .. "~"
      Label("DSK " .. n, x, ry + 7, 44, 18, { style = "Bold" })
      Button(d .. "Tie", dg .. "Tie", "TIE", x + 48, ry, 56, 30, C.Amber, { FontSize = 10 })
      Button(d .. "On Air", dg .. "On Air", "ON AIR", x + 108, ry, 64, 30, C.TallyRed, { FontSize = 10 })
      Button(d .. "Auto", dg .. "Auto", "AUTO", x + 176, ry, 56, 30, C.TallyRed, { FontSize = 10 })
      Place(d .. "In Transition", dg .. "In Transition", x + 238, ry + 8, 14, 14, { Color = C.Amber })
      Label("Rate", x + 256, ry + 7, 36, 18, { align = "Right", size = 10, color = C.Mid })
      Place(d .. "Rate", dg .. "Rate", x + 296, ry + 4, 60, 22, { Style = "Text" })
    end
    y = y + math.ceil(topo.DSKs / 2) * 38
  end
  H = y + M

elseif CurrentPage == "Keyers" then
  W = 760
  local cw = W - 2 * M
  local function Header(cols)
    for _, c in ipairs(cols) do Label(c[1], c[2], y, c[3], 16, { size = 10, color = C.Mid }) end
    y = y + 18
  end
  for me = 1, (topo.USKs > 0 and topo.MEs or 0) do
    local p, g = "ME" .. me .. " ", "M/E " .. me .. "~"
    y = Section((topo.MEs > 1 and ("M/E " .. me .. " ") or "") .. "Upstream Keys", M, y, cw)
    Header({ { "Type", M + 70, 80 }, { "Fill source", M + 170, 200 }, { "Key source", M + 390, 200 } })
    for k = 1, topo.USKs do
      local q = p .. "Key " .. k .. " "
      Label("Key " .. k, M, y + 2, 60, 18, { style = "Bold" })
      Place(q .. "Type", g .. "Keyers~Key " .. k .. " Type", M + 70, y, 90, 22, FLAT)
      Place(q .. "Fill", g .. "Keyers~Key " .. k .. " Fill", M + 170, y, 200, 22, { Style = "ComboBox" })
      Place(q .. "Key", g .. "Keyers~Key " .. k .. " Key", M + 390, y, 200, 22, { Style = "ComboBox" })
      y = y + 28
    end
    y = y + 6
  end
  if topo.DSKs > 0 then
    y = Section("Downstream Keys", M, y, cw)
    Header({ { "Fill source", M + 170, 200 }, { "Key source", M + 390, 200 } })
    for n = 1, topo.DSKs do
      local d, dg = "DSK " .. n .. " ", "DSK " .. n .. "~"
      Label("DSK " .. n, M, y + 2, 60, 18, { style = "Bold" })
      Place(d .. "Fill", dg .. "Fill", M + 170, y, 200, 22, { Style = "ComboBox" })
      Place(d .. "Key", dg .. "Key", M + 390, y, 200, 22, { Style = "ComboBox" })
      y = y + 28
    end
    Label("On Air, Tie, Auto and Rate of the downstream keys are on page M/E 1.", M, y + 2, cw, 16,
      { size = 10, color = C.Mid })
    y = y + 22
  end
  H = y + M

elseif auxFirst then
  local auxMode = AtemTopology.AuxMode(props)
  local widest = 0
  for aux = auxFirst, auxLast do
    widest = math.max(widest, GridWidth(#AtemTopology.AuxButtonSources(topo, aux, auxMode)))
  end
  local contentW = math.max(widest, 760)
  W = M * 2 + contentW
  for aux = auxFirst, auxLast do
    local ids = AtemTopology.AuxButtonSources(topo, aux, auxMode)
    y = Section("Aux " .. aux, M, y, contentW)
    Label("Source", M + contentW - 330, y - 28, 120, 20, { align = "Right", color = C.Mid })
    Place("Aux " .. aux, "Aux " .. aux .. "~Source", M + contentW - 200, y - 28, 200, 20, { Style = "ComboBox" })
    if #ids == 0 then
      y = y + NoButtons("Aux Buttons", M, y, contentW)
    else
      y = y + SourceGrid(ids, M, y, C.Amber,
        function(id) return "Aux " .. aux .. " " .. AtemTopology.SourceKey(id) end,
        function(id) return "Aux " .. aux .. "~" .. AtemTopology.SourceKey(id) end)
      y = y + NameGrid("aux" .. aux, ids, M, y) + 6
    end
  end
  H = y + M

elseif ssIndex then
  local ss = ssIndex
  local ids = AtemTopology.BoxButtonSources(topo, mode)
  local contentW = math.max(GridWidth(#ids), 760)
  W = M * 2 + contentW
  for box = 1, AtemTopology.BOXES do
    local p, g = "SS" .. ss .. " Box " .. box .. " ", "Box " .. box .. "~"
    y = Section("Box " .. box, M, y, contentW)
    Button(p .. "Enable", g .. "Enable", "ENABLE", M + contentW - 420, y - 30, 80, 24, C.Amber, { FontSize = 10 })
    Label("Source", M + contentW - 330, y - 28, 120, 20, { align = "Right", color = C.Mid })
    Place(p .. "Source", g .. "Source", M + contentW - 200, y - 28, 200, 20, { Style = "ComboBox" })
    if #ids == 0 then
      y = y + NoButtons("Source Buttons", M, y, contentW)
    else
      y = y + SourceGrid(ids, M, y, C.Amber,
        function(id) return p .. AtemTopology.SourceKey(id) end,
        function(id) return g .. AtemTopology.SourceKey(id) end)
      y = y + NameGrid("ss" .. ss .. "." .. box, ids, M, y) + 6
    end
  end
  H = y + M

elseif CurrentPage == "Setup" then
  local lw, fx = 120, M + 128
  W = 760
  y = Section("Connection", M, y, W - 2 * M)
  local function Row(label, name, pretty, w, extra)
    Label(label, M, y + 1, lw, 20, { align = "Right" })
    Place(name, pretty, fx, y, w, 22, extra)
    y = y + 28
  end
  Row("IP Address", "IP Address", "Setup~IP Address", 160, { Style = "Text" })
  Label("Status", M, y + 1, lw, 20, { align = "Right" })
  Place("Status", "Status", fx, y, 360, 22)
  Button("Reconnect", "Setup~Reconnect", "Reconnect", fx + 370, y, 100, 22, C.Amber, { FontSize = 11, FontStyle = "Regular" })
  y = y + 28
  Label("Connected", M, y, lw, 18, { align = "Right" })
  Place("Connected", "Connected", fx, y + 1, 16, 16, { Color = C.Amber })
  y = y + 26
  Label("Plugin model", M, y + 1, lw, 20, { align = "Right" })
  Label(topo.Name, fx + 4, y + 1, 400, 20)
  y = y + 26
  Row("Device", "Device", "Setup~Device", 360, FLAT)
  Row("Protocol", "Protocol Version", "Setup~Protocol Version", 120, FLAT)
  Row("Last Error", "Last Error", "Debug~Last Error", 560, { Style = "Text" })
  Row("Reconnects", "Reconnects", "Debug~Reconnects", 80, { Style = "Text" })
  y = y + 6

  H = y + M

elseif CurrentPage == "About" then
  y = y + 4
  local endY = LevoBrand.About(graphics, M, y, W - 2 * M, PluginInfo)
  Label("ATEM protocol handling based on Sofie ATEM Connection (NRK, MIT License); model data from the",
    M, endY + 8, W - 2 * M, 16, { size = 10, color = C.Mid })
  Label("Bitfocus Companion module bmd-atem (Bitfocus AS, MIT License). ATEM is a trademark of Blackmagic Design.",
    M, endY + 24, W - 2 * M, 16, { size = 10, color = C.Mid })
  H = endY + 52
end

-- Background and header go below everything else: prepend them.
local front = {}
LevoBrand.Background(front, W, H)
LevoBrand.Header(front, W, LevoBrand.PluginName(PluginInfo), CurrentPage)
for i = #front, 1, -1 do table.insert(graphics, 1, front[i]) end
-- <<< layout.lua
  return layout, graphics
end

if Controls then
  -- >>> atem_protocol.lua
-- (c) levo AVL | Elias Jenny - MIT License
--
-- Blackmagic ATEM switcher protocol: UDP port 9910, reliable sessions on top of UDP.
-- The protocol is not officially documented. Packet handling follows the
-- reverse-engineered implementation in Sofie ATEM Connection
-- (https://github.com/Sofie-Automation/sofie-atem-connection, MIT License,
-- Copyright (c) 2023 Norsk rikskringkasting AS).
--
-- Packet: 12 byte header + commands
--   0-1   flags (5 bit) << 11 | packet length (11 bit)
--   2-3   session id
--   4-5   acknowledged packet id (AckReply)
--   6-7   retransmit from packet id (RetransmitRequest)
--   10-11 packet id (AckRequest)
-- Command: 2 byte length (incl. 8 byte header), 2 bytes 0, 4 char name, data.
-- Commands never span packets; packets can arrive out of order or twice.

AtemProtocol = {}
local P = AtemProtocol

local byte, char = string.byte, string.char

P.PORT = 9910
P.MAX_PACKET = 1416          -- same as ATEM Software Control
P.MAX_ID = 1 << 15           -- packet ids are 15 bit

P.Flag = { AckRequest = 0x01, Hello = 0x02, Retransmit = 0x04, RetransmitRequest = 0x08, AckReply = 0x10 }

---------------------------------------------------------------------------
-- Binary helpers. Offsets are 0-based like in the protocol notes.
---------------------------------------------------------------------------
function P.U8(s, o) return byte(s, o + 1) or 0 end
function P.U16(s, o)
  local a, b = byte(s, o + 1, o + 2)
  return ((a or 0) << 8) | (b or 0)
end
function P.S16(s, o)
  local v = P.U16(s, o)
  return v >= 0x8000 and v - 0x10000 or v
end
function P.U32(s, o) return (P.U16(s, o) << 16) | P.U16(s, o + 2) end
function P.S32(s, o)
  local v = P.U32(s, o)
  return v >= 0x80000000 and v - 0x100000000 or v
end
function P.Bool(s, o) return P.U8(s, o) ~= 0 end
-- Null-terminated string in a fixed-size field
function P.Str(s, o, len)
  local raw = s:sub(o + 1, o + len)
  local z = raw:find("\0", 1, true)
  return z and raw:sub(1, z - 1) or raw
end

function P.W8(v) return char(math.floor(v) & 0xFF) end
function P.W16(v)
  v = math.floor(v) & 0xFFFF
  return char(v >> 8, v & 0xFF)
end
function P.W32(v)
  v = math.floor(v) & 0xFFFFFFFF
  return char(v >> 24, (v >> 16) & 0xFF, (v >> 8) & 0xFF, v & 0xFF)
end
function P.Pad(n) return string.rep("\0", n) end
-- Fixed-size string field, null padded
function P.WStr(s, len)
  s = (s or ""):sub(1, len)
  return s .. P.Pad(len - #s)
end

function P.Hex(s, max)
  s = max and s:sub(1, max) or s
  return (s:gsub(".", function(c) return ("%02x"):format(byte(c)) end))
end

-- One command, ready to be put into a packet
function P.Command(name, data)
  return P.W16(#data + 8) .. "\0\0" .. name .. data
end

-- Split a packet payload into commands: calls fn(name, data) for each
function P.SplitCommands(payload, fn)
  local pos, n = 0, #payload
  while pos + 8 <= n do
    local len = P.U16(payload, pos)
    if len < 8 or pos + len > n then return false end
    fn(payload:sub(pos + 5, pos + 8), payload:sub(pos + 9, pos + len))
    pos = pos + len
  end
  return true
end

local function Header(flags, length, session, ackId, packetId)
  return P.W16((flags << 11) | length) .. P.W16(session) .. P.W16(ackId or 0)
    .. "\0\0\0\0" .. P.W16(packetId or 0)
end

P.HELLO = Header(P.Flag.Hello, 20, 0x53AB, 0, 0) .. char(0x01) .. P.Pad(7)
-- byte 9 of the hello is 0x3a in the original client; keep it for compatibility
P.HELLO = P.HELLO:sub(1, 9) .. char(0x3a) .. P.HELLO:sub(11)

-- Is packet id `id` covered by an acknowledgement up to `ackId` (with 15 bit wrap)?
function P.Covered(ackId, id)
  local half = P.MAX_ID // 2
  local diff = (ackId - id) % P.MAX_ID
  return diff < half
end

---------------------------------------------------------------------------
-- Session: handshake, acknowledgements, retransmits, ordered delivery.
-- Transport-independent: the owner feeds received datagrams into Receive()
-- and calls Tick(now) regularly; outgoing datagrams go to opts.Transmit.
---------------------------------------------------------------------------
local Session = {}
Session.__index = Session

local HELLO_RETRY = 1.0       -- resend hello while waiting for an answer
local RX_TIMEOUT = 5.0        -- nothing received for this long -> connection lost
local RESEND_AFTER = 0.08     -- unacknowledged packet is resent after this time
local MAX_RESENDS = 10
local MAX_IN_FLIGHT = 16      -- packets waiting for an ack before we hold back
local MAX_OUT_OF_ORDER = 256
local STALL_TIMEOUT = 5.0     -- inbound stuck behind a lost packet for this long

-- opts: Transmit(data), OnConnected(), OnCommand(name, data), OnLost(reason), Log(level, msg)
function P.NewSession(opts)
  local s = setmetatable({ opts = opts }, Session)
  s:Reset()
  s.phase = "closed"
  return s
end

function Session:Reset()
  self.sessionId = 0
  self.nextId = 1
  self.lastRxId = 0
  self.inFlight = {}
  self.outOfOrder, self.outOfOrderCount = {}, 0
  self.stalledSince = nil
  self.queue, self.queueData = {}, {}
  self.lastRx = 0
  self.helloAt = 0
  self.txPackets, self.rxPackets, self.resends = 0, 0, 0
end

function Session:Log(level, msg)
  if self.opts.Log then self.opts.Log(level, msg) end
end

function Session:Raw(data)
  self.txPackets = self.txPackets + 1
  self.opts.Transmit(data)
end

function Session:Connect(now)
  self:Reset()
  self.phase = "hello"
  self.helloAt = now
  self.lastRx = now
  self:Raw(P.HELLO)
end

function Session:Close()
  self.phase = "closed"
  self.queue, self.queueData = {}, {}
  self.inFlight = {}
end

function Session:IsOpen() return self.phase == "open" end

function Session:Lost(reason)
  if self.phase == "closed" then return end
  self:Close()
  self.opts.OnLost(reason)
end

function Session:SendAck(id)
  self:Raw(Header(P.Flag.AckReply, 12, self.sessionId, id, 0))
end

function Session:Deliver(payload)
  if #payload == 0 then return end
  local ok = P.SplitCommands(payload, self.opts.OnCommand)
  if not ok then self:Log(1, "Malformed packet payload: " .. P.Hex(payload, 32)) end
end

function Session:Receive(pkt, now)
  if self.phase == "closed" or #pkt < 12 then return end
  local b0 = P.U8(pkt, 0)
  local flags = b0 >> 3
  local length = P.U16(pkt, 0) & 0x07FF
  if length ~= #pkt then
    self:Log(2, ("Dropped packet: length %d, header says %d"):format(#pkt, length))
    return
  end
  self.rxPackets = self.rxPackets + 1
  self.lastRx = now
  self.sessionId = P.U16(pkt, 2)
  local remoteId = P.U16(pkt, 10)

  if flags & P.Flag.Hello ~= 0 then
    -- hello answer: the switcher accepted us, the state dump follows
    if self.phase == "hello" then
      self.phase = "open"
      self.lastRxId = remoteId
      self.outOfOrder, self.outOfOrderCount = {}, 0
      self:SendAck(remoteId)
      self.opts.OnConnected()
    else
      self:SendAck(remoteId)
    end
    return
  end
  if self.phase ~= "open" then return end

  if flags & P.Flag.RetransmitRequest ~= 0 then
    local from = P.U16(pkt, 6) % P.MAX_ID
    self:Log(2, "Switcher asked for resend from packet " .. from)
    if not self:ResendFrom(from, now) then return end
  end

  if flags & P.Flag.AckRequest ~= 0 and remoteId < P.MAX_ID then
    local distance = (remoteId - self.lastRxId) % P.MAX_ID
    if distance == 1 then
      self.lastRxId = remoteId
      self:Deliver(pkt:sub(13))
      -- buffered packets that are now in sequence
      local nextId = (self.lastRxId + 1) % P.MAX_ID
      local buffered = self.outOfOrder[nextId]
      while buffered and self.phase == "open" do
        self.outOfOrder[nextId] = nil
        self.outOfOrderCount = self.outOfOrderCount - 1
        self.lastRxId = nextId
        self:Deliver(buffered)
        nextId = (nextId + 1) % P.MAX_ID
        buffered = self.outOfOrder[nextId]
      end
      self.stalledSince = self.outOfOrderCount > 0 and now or nil
      if self.phase == "open" then self:SendAck(self.lastRxId) end
    elseif distance > 1 and distance <= MAX_OUT_OF_ORDER then
      if not self.outOfOrder[remoteId] then
        if self.outOfOrderCount == 0 then self.stalledSince = now end
        self.outOfOrder[remoteId] = pkt:sub(13)
        self.outOfOrderCount = self.outOfOrderCount + 1
      end
    elseif P.Covered(self.lastRxId, remoteId) then
      -- a resend of something we already have: our ack got lost
      self:SendAck(self.lastRxId)
    end
  end

  if flags & P.Flag.AckReply ~= 0 then
    local ackId = P.U16(pkt, 4)
    local keep = {}
    for _, p in ipairs(self.inFlight) do
      if not P.Covered(ackId, p.id) then keep[#keep + 1] = p end
    end
    self.inFlight = keep
  end
end

function Session:ResendFrom(from, now)
  local index
  for i, p in ipairs(self.inFlight) do
    if p.id == from then index = i break end
  end
  if not index then
    self:Lost("Switcher asked for a packet that is no longer available")
    return false
  end
  for i = index, #self.inFlight do
    local p = self.inFlight[i]
    p.sentAt, p.resends = now, p.resends + 1
    self.resends = self.resends + 1
    self:Raw(p.data)
  end
  return true
end

-- Queue a command. Commands with the same coalesce key replace each other while
-- they wait (e.g. T-bar moves): only the latest value is sent.
function Session:Queue(cmd, coalesceKey)
  if self.phase ~= "open" then return false end
  if coalesceKey then
    if self.queueData[coalesceKey] == nil then self.queue[#self.queue + 1] = coalesceKey end
    self.queueData[coalesceKey] = cmd
  else
    self.queue[#self.queue + 1] = cmd
  end
  return true
end

function Session:Flush(now)
  while #self.queue > 0 and #self.inFlight < MAX_IN_FLIGHT do
    local payload = {}
    local size = 12
    while #self.queue > 0 do
      local item = self.queue[1]
      local cmd = self.queueData[item] or item
      if size + #cmd > P.MAX_PACKET and size > 12 then break end
      table.remove(self.queue, 1)
      self.queueData[item] = nil
      payload[#payload + 1] = cmd
      size = size + #cmd
    end
    local id = self.nextId
    self.nextId = (self.nextId + 1) % P.MAX_ID
    local data = Header(P.Flag.AckRequest, size, self.sessionId, 0, id) .. table.concat(payload)
    self.inFlight[#self.inFlight + 1] = { id = id, data = data, sentAt = now, resends = 0 }
    self:Raw(data)
  end
end

function Session:Tick(now)
  if self.phase == "hello" then
    if now - self.lastRx > RX_TIMEOUT then
      self:Lost("No answer from switcher")
    elseif now - self.helloAt >= HELLO_RETRY then
      self.helloAt = now
      self:Raw(P.HELLO)
    end
    return
  end
  if self.phase ~= "open" then return end

  if now - self.lastRx > RX_TIMEOUT then
    self:Lost("Switcher stopped responding")
    return
  end
  if self.stalledSince and now - self.stalledSince > STALL_TIMEOUT then
    self:Lost("Inbound stalled waiting for packet " .. ((self.lastRxId + 1) % P.MAX_ID))
    return
  end

  local first = self.inFlight[1]
  if first and now - first.sentAt > RESEND_AFTER then
    if first.resends >= MAX_RESENDS then
      self:Lost("Packet " .. first.id .. " was never acknowledged")
      return
    end
    self:Log(2, "Resending from packet " .. first.id)
    if not self:ResendFrom(first.id, now) then return end
  end

  self:Flush(now)
end
-- <<< atem_protocol.lua
  -- >>> atem_state.lua
-- (c) levo AVL | Elias Jenny - MIT License
--
-- ATEM command encoding and state decoding. Command layouts follow Sofie ATEM
-- Connection (MIT License, Copyright (c) 2023 Norsk rikskringkasting AS).
-- Indexes inside the protocol are 0-based; everything in this table is 1-based
-- (M/E 1 = me[1]) except source ids, which are the switcher's own numbers.

AtemState = {}
local S = AtemState
local P = AtemProtocol

function S.New()
  return {
    version = 0,          -- protocol version, e.g. 0x00020020 = 2.32
    product = "",
    modelId = nil,
    top = nil,            -- topology reported by the switcher
    keyCount = {},        -- upstream keyers per M/E
    inputs = {},          -- [source id] = { long, short, port, sa, me, default }
    inputOrder = {},
    me = {},
    dsk = {},             -- [n] = { onAir, inTransition, isAuto, tie, rate, fill, key }
    aux = {},             -- [n] = source id
    ss = {},              -- [n] = { boxes = { [b] = { enabled, source } } }
    initDone = false,
  }
end

local function ME(st, i)
  local m = st.me[i]
  if not m then
    m = {
      program = nil, preview = nil, inTransition = false, remaining = 0, handle = 0,
      style = 0, selection = 1, nextStyle = 0, nextSelection = 1, previewTransition = false,
      ftbBlack = false, ftbInTransition = false, ftbRate = 0,
      rates = {}, keyOnAir = {}, keys = {},
    }
    st.me[i] = m
  end
  return m
end
S.ME = ME

function S.VersionString(v)
  if not v or v == 0 then return "" end
  return ("%d.%d"):format(v >> 16, v & 0xFFFF)
end

-- Decoders: name -> function(st, data) returning a change key (or nil)
local D = {}

D["_ver"] = function(st, d)
  st.version = P.U32(d, 0)
  return "device"
end

D["_pin"] = function(st, d)
  st.product = P.Str(d, 0, 40)
  st.modelId = P.U8(d, 40)
  return "device"
end

D["_top"] = function(st, d)
  -- one extra byte (multiviewers) since protocol 2.30
  local o = st.version > 0x0002001d and 1 or 0
  st.top = {
    MEs = P.U8(d, 0), sources = P.U8(d, 1), DSKs = P.U8(d, 2), Aux = P.U8(d, 3),
    MediaPlayers = P.U8(d, 5), DVEs = P.U8(d, 8 + o), Stingers = P.U8(d, 9 + o),
    SuperSources = P.U8(d, 10 + o),
  }
  return "device"
end

D["_MeC"] = function(st, d)
  st.keyCount[P.U8(d, 0) + 1] = P.U8(d, 1)
  return "device"
end

D["VidM"] = function(st, d)
  st.videoMode = P.U8(d, 0)
  return "video"
end

D["InPr"] = function(st, d)
  local id = P.U16(d, 0)
  local inp = st.inputs[id]
  if not inp then
    inp = {}
    st.inputs[id] = inp
    st.inputOrder[#st.inputOrder + 1] = id
  end
  inp.long = P.Str(d, 2, 20)
  inp.short = P.Str(d, 22, 4)
  inp.default = P.U8(d, 26) == 1
  inp.port = P.U8(d, 32)
  inp.sa = P.U8(d, 34)
  inp.me = P.U8(d, 35)
  return "input"
end

D["PrgI"] = function(st, d)
  ME(st, P.U8(d, 0) + 1).program = P.U16(d, 2)
  return "me"
end

D["PrvI"] = function(st, d)
  ME(st, P.U8(d, 0) + 1).preview = P.U16(d, 2)
  return "me"
end

D["TrPs"] = function(st, d)
  local m = ME(st, P.U8(d, 0) + 1)
  m.inTransition = P.U8(d, 1) == 1
  m.remaining = P.U8(d, 2)
  m.handle = P.U16(d, 4)
  return "me"
end

D["TrSS"] = function(st, d)
  local m = ME(st, P.U8(d, 0) + 1)
  m.style = P.U8(d, 1)
  m.selection = P.U8(d, 2)
  m.nextStyle = P.U8(d, 3)
  m.nextSelection = P.U8(d, 4)
  return "me"
end

D["TrPr"] = function(st, d)
  ME(st, P.U8(d, 0) + 1).previewTransition = P.U8(d, 1) == 1
  return "me"
end

-- transition rates per style: 0 Mix, 1 Dip, 2 Wipe, 3 DVE
D["TMxP"] = function(st, d) ME(st, P.U8(d, 0) + 1).rates[0] = P.U8(d, 1) return "me" end
D["TDpP"] = function(st, d) ME(st, P.U8(d, 0) + 1).rates[1] = P.U8(d, 1) return "me" end
D["TWpP"] = function(st, d) ME(st, P.U8(d, 0) + 1).rates[2] = P.U8(d, 1) return "me" end
D["TDvP"] = function(st, d) ME(st, P.U8(d, 0) + 1).rates[3] = P.U8(d, 1) return "me" end

D["FtbS"] = function(st, d)
  local m = ME(st, P.U8(d, 0) + 1)
  m.ftbBlack = P.U8(d, 1) == 1
  m.ftbInTransition = P.U8(d, 2) == 1
  return "me"
end

D["FtbP"] = function(st, d)
  ME(st, P.U8(d, 0) + 1).ftbRate = P.U8(d, 1)
  return "me"
end

D["KeOn"] = function(st, d)
  ME(st, P.U8(d, 0) + 1).keyOnAir[P.U8(d, 1) + 1] = P.U8(d, 2) == 1
  return "me"
end

-- protocol 2.29 (firmware 8.0.1) and later
local function V801(st) return st.version >= 0x0002001d end
-- protocol 2.28 (firmware 8.0) and later
local function V80(st) return st.version >= 0x0002001c end
S.V80, S.V801 = V80, V801

local function Dsk(st, i)
  local d = st.dsk[i]
  if not d then
    d = { onAir = false, inTransition = false, isAuto = false, tie = false, rate = 0 }
    st.dsk[i] = d
  end
  return d
end

D["DskS"] = function(st, d)
  local k = Dsk(st, P.U8(d, 0) + 1)
  k.onAir = P.U8(d, 1) == 1
  k.inTransition = P.U8(d, 2) == 1
  k.isAuto = P.U8(d, 3) == 1
  return "dsk"
end

D["DskP"] = function(st, d)
  local k = Dsk(st, P.U8(d, 0) + 1)
  k.tie = P.U8(d, 1) == 1
  k.rate = P.U8(d, 2)
  return "dsk"
end

D["DskB"] = function(st, d)
  local k = Dsk(st, P.U8(d, 0) + 1)
  k.fill = P.U16(d, 2)
  k.key = P.U16(d, 4)
  return "dsk"
end

D["AuxS"] = function(st, d)
  st.aux[P.U8(d, 0) + 1] = P.U16(d, 2)
  return "aux"
end

D["KeBP"] = function(st, d)
  local m = ME(st, P.U8(d, 0) + 1)
  local k = P.U8(d, 1) + 1
  m.keys[k] = { type = P.U8(d, 2), fill = P.U16(d, 6), key = P.U16(d, 8) }
  return "me"
end

D["SSBP"] = function(st, d)
  local ssId, box, i = 0, nil, 0
  if V80(st) then
    ssId, box, i = P.U8(d, 0), P.U8(d, 1), 2
  else
    box = P.U8(d, 0)
  end
  local ss = st.ss[ssId + 1] or { boxes = {} }
  st.ss[ssId + 1] = ss
  ss.boxes[box + 1] = { enabled = P.U8(d, i > 0 and 2 or 1) == 1, source = P.U16(d, i + 2) }
  return "ss"
end

D["InCm"] = function(st, d)
  st.initDone = true
  return "init"
end

S.Decoders = D

-- Apply one received command. Returns change key, M/E index (if any) or nil when
-- the command is not handled.
function S.Apply(st, name, data)
  local fn = D[name]
  if not fn then return nil end
  local ok, key = pcall(fn, st, data)
  if not ok then return "error", key end
  local index = nil
  if key == "me" or key == "dsk" or key == "aux" then
    index = P.U8(data, 0) + 1
  elseif key == "ss" then
    index = V80(st) and P.U8(data, 0) + 1 or 1
  end
  return key, index
end

---------------------------------------------------------------------------
-- Encoders (me, keyer: 1-based)
---------------------------------------------------------------------------
local C = P.Command
local W8, W16 = P.W8, P.W16

S.Cmd = {}
local Cmd = S.Cmd

function Cmd.Program(me, source) return C("CPgI", W8(me - 1) .. "\0" .. W16(source)) end
function Cmd.Preview(me, source) return C("CPvI", W8(me - 1) .. "\0" .. W16(source)) end
function Cmd.Cut(me) return C("DCut", W8(me - 1) .. "\0\0\0") end
function Cmd.Auto(me) return C("DAut", W8(me - 1) .. "\0\0\0") end
function Cmd.FadeToBlack(me) return C("FtbA", W8(me - 1) .. "\0\0\0") end
function Cmd.FadeToBlackRate(me, rate) return C("FtbC", W8(1) .. W8(me - 1) .. W8(rate) .. "\0") end
function Cmd.TransitionPosition(me, pos) return C("CTPs", W8(me - 1) .. "\0" .. W16(pos)) end
function Cmd.PreviewTransition(me, on) return C("CTPr", W8(me - 1) .. W8(on and 1 or 0) .. "\0\0") end
function Cmd.NextStyle(me, style) return C("CTTp", W8(1) .. W8(me - 1) .. W8(style) .. "\0") end
function Cmd.NextSelection(me, mask) return C("CTTp", W8(2) .. W8(me - 1) .. "\0" .. W8(mask)) end
function Cmd.KeyOnAir(me, key, on) return C("CKOn", W8(me - 1) .. W8(key - 1) .. W8(on and 1 or 0) .. "\0") end

-- Downstream keyers (n: 1-based)
function Cmd.DskOnAir(n, on) return C("CDsL", W8(n - 1) .. W8(on and 1 or 0) .. "\0\0") end
function Cmd.DskTie(n, on) return C("CDsT", W8(n - 1) .. W8(on and 1 or 0) .. "\0\0") end
function Cmd.DskRate(n, rate) return C("CDsR", W8(n - 1) .. W8(rate) .. "\0\0") end
function Cmd.DskFill(n, source) return C("CDsF", W8(n - 1) .. "\0" .. W16(source)) end
function Cmd.DskKey(n, source) return C("CDsC", W8(n - 1) .. "\0" .. W16(source)) end
function Cmd.DskAuto(st, n)
  if S.V801(st) then return C("DDsA", "\0" .. W8(n - 1) .. "\0\0") end
  return C("DDsA", W8(n - 1) .. "\0\0\0")
end

function Cmd.Aux(aux, source) return C("CAuS", W8(1) .. W8(aux - 1) .. W16(source)) end

function Cmd.KeyFill(me, key, source) return C("CKeF", W8(me - 1) .. W8(key - 1) .. W16(source)) end
function Cmd.KeyKey(me, key, source) return C("CKeC", W8(me - 1) .. W8(key - 1) .. W16(source)) end

-- SuperSource box: flags 1 = enabled, 2 = source
function Cmd.SuperSourceBox(st, ss, box, enabled, source)
  local flag = (enabled ~= nil and 1 or 0) | (source and 2 or 0)
  if S.V80(st) then
    return C("CSBP", W16(flag) .. W8(ss - 1) .. W8(box - 1) .. W8(enabled and 1 or 0) .. "\0"
      .. W16(source or 0) .. P.Pad(16))
  end
  return C("CSBP", W16(flag) .. W8(box - 1) .. W8(enabled and 1 or 0) .. W16(source or 0) .. P.Pad(18))
end

-- Transition rate of a style (0 Mix, 1 Dip, 2 Wipe, 3 DVE); nil for styles without rate
function Cmd.TransitionRate(me, style, rate)
  rate = math.max(1, math.min(250, math.floor(rate)))
  if style == 0 then return C("CTMx", W8(me - 1) .. W8(rate) .. "\0\0") end
  if style == 1 then return C("CTDp", W8(1) .. W8(me - 1) .. W8(rate) .. P.Pad(5)) end
  if style == 2 then return C("CTWp", W16(1) .. W8(me - 1) .. W8(rate) .. P.Pad(16)) end
  if style == 3 then return C("CTDv", W16(1) .. W8(me - 1) .. W8(rate) .. P.Pad(16)) end
  return nil
end
-- <<< atem_state.lua
  -- >>> runtime.lua
-- (c) levo AVL | Elias Jenny - MIT License
-- Runtime code: only runs on the Core or in Emulation mode.

local DebugLevel = ({ None = 0, Basic = 1, Verbose = 2 })[Properties["Debug Print"].Value] or 0
local Topo = AtemTopology.Resolve(Properties)
local ButtonMode = AtemTopology.ButtonMode(Properties)
local DeviceLegends = Properties["Button Legends"].Value == "Device Names"
local Cmd = AtemState.Cmd

local TICK = 0.02             -- main timer resolution (s)
local TBAR_HOLD = 0.5         -- ignore T-bar feedback this long after a user move
local BACKOFF = { 1, 2, 4, 8, 15, 30 }

local Now = 0                 -- monotonic time in seconds, advanced by the main timer

local function Log(level, msg)
  if level <= DebugLevel then print(("[ATEM] %s"):format(msg)) end
end

---------------------------------------------------------------------------
-- Control helpers (only write when the value changes)
---------------------------------------------------------------------------
local function SetString(name, s)
  local c = Controls[name]
  s = s or ""
  if c and c.String ~= s then c.String = s end
end

local function SetBool(name, b)
  local c = Controls[name]
  if c and c.Boolean ~= b then c.Boolean = b end
end

local function SetPosition(name, p)
  local c = Controls[name]
  if not c then return end
  p = math.max(0, math.min(1, p or 0))
  if math.abs(c.Position - p) > 0.0005 then c.Position = p end
end

local function SetLegend(name, text)
  local c = Controls[name]
  if c then pcall(function() if c.Legend ~= text then c.Legend = text end end) end
end

local function SetChoices(name, list)
  local c = Controls[name]
  if c then pcall(function() c.Choices = list end) end
end

local STATUS = { OK = 0, Compromised = 1, Fault = 2, NotPresent = 3, Missing = 4, Initializing = 5 }
local function SetStatus(value, text)
  local c = Controls.Status
  if c.Value ~= value then c.Value = value end
  SetString("Status", text)
end

local function SetError(text)
  SetString("Last Error", text)
  if text ~= "" then Log(1, "Error: " .. text) end
end

---------------------------------------------------------------------------
-- State and source names
---------------------------------------------------------------------------
local St = AtemState.New()
local Ready = false            -- state dump complete

-- Button sources per bus (fixed by the design)
local AuxMode = AtemTopology.AuxMode(Properties)
local MEButtons, AuxButtons = {}, {}
for me = 1, Topo.MEs do MEButtons[me] = AtemTopology.MEButtonSources(Topo, me, ButtonMode) end
for aux = 1, Topo.Aux do AuxButtons[aux] = AtemTopology.AuxButtonSources(Topo, aux, AuxMode) end
local BoxButtons = AtemTopology.BoxButtonSources(Topo, ButtonMode)
local _, NameSources = AtemTopology.NamePlacement(Topo, Properties)
local KeyTypes = { [0] = "Luma", "Chroma", "Pattern", "DVE" }

local function Key(id) return (AtemTopology.SourceKey(id)) end

local function LongName(id)
  local inp = St.inputs[id]
  if inp and inp.long ~= "" then return inp.long end
  return Key(id)
end

local function ShortName(id)
  local inp = St.inputs[id]
  if inp and inp.short ~= "" then return inp.short end
  local _, short = AtemTopology.SourceKey(id)
  return short
end

-- Combo box groups: which sources a combo offers, name <-> id per group
local Combos = {}   -- name -> { controls = {...}, accept = fn(port, sa, me), byId, byName }
local function AddCombo(name, controls, accept)
  Combos[name] = { controls = controls, accept = accept, byId = {}, byName = {} }
end
for me = 1, Topo.MEs do
  local bit = 1 << (me - 1)
  AddCombo("me" .. me, { "ME" .. me .. " Program", "ME" .. me .. " Preview" },
    function(port, sa, meAvail) return meAvail & bit ~= 0 end)
end
do
  local keyControls = {}
  for me = 1, Topo.MEs do
    for k = 1, Topo.USKs do
      keyControls[#keyControls + 1] = "ME" .. me .. " Key " .. k .. " Fill"
      keyControls[#keyControls + 1] = "ME" .. me .. " Key " .. k .. " Key"
    end
  end
  for n = 1, Topo.DSKs do
    keyControls[#keyControls + 1] = "DSK " .. n .. " Fill"
    keyControls[#keyControls + 1] = "DSK " .. n .. " Key"
  end
  AddCombo("key", keyControls, function(port, sa) return sa & AtemTopology.Avail.KeySource ~= 0 end)
end
for aux = 1, Topo.Aux do
  AddCombo("aux" .. aux, { "Aux " .. aux }, function(port, sa) return AtemTopology.AuxAvailable(aux, sa) end)
end
do
  local boxControls = {}
  for ss = 1, Topo.SuperSources do
    for box = 1, AtemTopology.BOXES do boxControls[#boxControls + 1] = "SS" .. ss .. " Box " .. box .. " Source" end
  end
  AddCombo("box", boxControls, function(port, sa) return sa & AtemTopology.Avail.SuperSourceBox ~= 0 end)
end

-- Sources of the switcher (after the state dump), else of the model table
local function AllSources()
  local list = {}
  if Ready and next(St.inputs) then
    for _, id in ipairs(St.inputOrder) do
      local inp = St.inputs[id]
      list[#list + 1] = { id, inp.port, inp.sa, inp.me }
    end
  else
    list = Topo.Sources
  end
  return list
end

local function BuildCombos()
  local sources = AllSources()
  local portOf = {}
  for _, s in ipairs(sources) do portOf[s[1]] = s[2] end
  for _, combo in pairs(Combos) do
    local ids = {}
    for _, s in ipairs(sources) do
      if combo.accept(s[2], s[3], s[4]) then ids[#ids + 1] = s[1] end
    end
    ids = AtemTopology.SortSources(ids, function(id) return portOf[id] end)
    local count = {}
    for _, id in ipairs(ids) do
      local n = LongName(id)
      count[n] = (count[n] or 0) + 1
    end
    local names, byId, byName = {}, {}, {}
    for _, id in ipairs(ids) do
      local n = LongName(id)
      if count[n] > 1 then n = n .. " (" .. Key(id) .. ")" end
      names[#names + 1] = n
      byId[id], byName[n] = n, id
    end
    combo.byId, combo.byName = byId, byName
    for _, c in ipairs(combo.controls) do SetChoices(c, names) end
  end
end

local function ComboName(group, id)
  if id == nil then return "" end
  return Combos[group].byId[id] or LongName(id)
end

local function ComboId(group, name)
  return Combos[group].byName[name]
end

local function RenderNames()
  for _, id in ipairs(NameSources) do
    SetString("Name " .. Key(id), Ready and LongName(id) or "")
  end
  if DeviceLegends and Ready then
    local function legends(prefixes, ids)
      for _, id in ipairs(ids) do
        for _, p in ipairs(prefixes) do SetLegend(p .. Key(id), ShortName(id)) end
      end
    end
    for me = 1, Topo.MEs do legends({ "ME" .. me .. " Program ", "ME" .. me .. " Preview " }, MEButtons[me]) end
    for aux = 1, Topo.Aux do legends({ "Aux " .. aux .. " " }, AuxButtons[aux]) end
    for ss = 1, Topo.SuperSources do
      for box = 1, AtemTopology.BOXES do legends({ "SS" .. ss .. " Box " .. box .. " " }, BoxButtons) end
    end
  end
end

---------------------------------------------------------------------------
-- Rendering
---------------------------------------------------------------------------
local TBarTouched = {}   -- [me] = time of the last user move

-- frame rate for "s:ff" rates; 25 until the switcher reports its video mode
local function Fps()
  return St.videoMode and AtemTopology.ModeFps[St.videoMode] or 25
end

local function RenderME(me)
  local m = Ready and St.me[me] or nil
  local p = "ME" .. me .. " "
  m = m or { inTransition = false, handle = 0, ftbBlack = false, ftbInTransition = false, ftbRate = 0,
    nextStyle = -1, nextSelection = 0, previewTransition = false, rates = {}, keyOnAir = {}, keys = {} }

  for _, id in ipairs(MEButtons[me]) do
    local key = Key(id)
    SetBool(p .. "Program " .. key, m.program == id)
    SetBool(p .. "Preview " .. key, m.preview == id)
  end
  SetString(p .. "Program", ComboName("me" .. me, m.program))
  SetString(p .. "Preview", ComboName("me" .. me, m.preview))

  SetBool(p .. "Auto", m.inTransition)
  SetBool(p .. "In Transition", m.inTransition)
  if Now - (TBarTouched[me] or -100) > TBAR_HOLD then
    SetPosition(p .. "T-Bar", m.inTransition and m.handle / 10000 or 0)
  end
  SetBool(p .. "Fade to Black", m.ftbBlack or m.ftbInTransition)
  SetString(p .. "Fade to Black Rate", m.ftbRate > 0 and AtemTopology.FormatRate(m.ftbRate, Fps()) or "")

  for i, style in ipairs(AtemTopology.TransitionStyles) do
    SetBool(p .. "Style " .. style, m.nextStyle == i - 1)
  end
  SetString(p .. "Transition Style", AtemTopology.TransitionStyles[m.nextStyle + 1] or "")
  local rate = m.rates[m.nextStyle]
  SetString(p .. "Transition Rate", (rate and rate > 0) and AtemTopology.FormatRate(rate, Fps()) or "")
  SetBool(p .. "Preview Transition", m.previewTransition)
  SetBool(p .. "Next Background", m.nextSelection & 1 ~= 0)
  for k = 1, Topo.USKs do
    local q = p .. "Key " .. k .. " "
    SetBool(p .. "Next Key " .. k, m.nextSelection & (1 << k) ~= 0)
    SetBool(q .. "On Air", m.keyOnAir[k] == true)
    local key = m.keys[k]
    SetString(q .. "Fill", key and ComboName("key", key.fill) or "")
    SetString(q .. "Key", key and ComboName("key", key.key) or "")
    SetString(q .. "Type", key and (KeyTypes[key.type] or ("Type " .. key.type)) or "")
  end
end

local function RenderDSK(n)
  local d = Ready and St.dsk[n] or {}
  local p = "DSK " .. n .. " "
  SetBool(p .. "On Air", d.onAir == true)
  SetBool(p .. "Tie", d.tie == true)
  SetBool(p .. "Auto", d.isAuto == true and d.inTransition == true)
  SetBool(p .. "In Transition", d.inTransition == true)
  SetString(p .. "Rate", (d.rate or 0) > 0 and AtemTopology.FormatRate(d.rate, Fps()) or "")
  SetString(p .. "Fill", ComboName("key", d.fill))
  SetString(p .. "Key", ComboName("key", d.key))
end

local function RenderAux(aux)
  local src = Ready and St.aux[aux] or nil
  for _, id in ipairs(AuxButtons[aux]) do SetBool("Aux " .. aux .. " " .. Key(id), src == id) end
  SetString("Aux " .. aux, ComboName("aux" .. aux, src))
end

local function RenderSS(ss)
  local boxes = Ready and St.ss[ss] and St.ss[ss].boxes or {}
  for box = 1, AtemTopology.BOXES do
    local b = boxes[box] or {}
    local p = "SS" .. ss .. " Box " .. box .. " "
    SetBool(p .. "Enable", b.enabled == true)
    for _, id in ipairs(BoxButtons) do SetBool(p .. Key(id), b.source == id) end
    SetString(p .. "Source", ComboName("box", b.source))
  end
end

local Dirty = { me = {}, dsk = {}, aux = {}, ss = {}, names = false }

local function RenderAll()
  BuildCombos()
  RenderNames()
  for me = 1, Topo.MEs do RenderME(me) end
  for n = 1, Topo.DSKs do RenderDSK(n) end
  for aux = 1, Topo.Aux do RenderAux(aux) end
  for ss = 1, Topo.SuperSources do RenderSS(ss) end
  Dirty = { me = {}, dsk = {}, aux = {}, ss = {}, names = false }
end

local function RenderDirty()
  if Dirty.names then
    RenderAll()
    return
  end
  for me in pairs(Dirty.me) do if me <= Topo.MEs then RenderME(me) end end
  for n in pairs(Dirty.dsk) do if n <= Topo.DSKs then RenderDSK(n) end end
  for aux in pairs(Dirty.aux) do if aux <= Topo.Aux then RenderAux(aux) end end
  for ss in pairs(Dirty.ss) do if ss <= Topo.SuperSources then RenderSS(ss) end end
  Dirty = { me = {}, dsk = {}, aux = {}, ss = {}, names = false }
end

---------------------------------------------------------------------------
-- Device info and model check
---------------------------------------------------------------------------
local function RenderDevice()
  local text = St.product
  local model = St.modelId and AtemTopology.ModelById(St.modelId)
  if model and text == "" then text = model.Name end
  SetString("Device", text)
  SetString("Protocol Version", AtemState.VersionString(St.version))
end

-- Compare the switcher with the plugin's model setting
local function CheckModel()
  local top = St.top or {}
  if Topo.Id then
    if St.modelId and St.modelId ~= Topo.Id then
      local actual = AtemTopology.ModelById(St.modelId)
      return ("Switcher is %s - plugin is set to %s"):format(
        actual and actual.Name or (St.product ~= "" and St.product or ("model " .. St.modelId)), Topo.Name)
    end
    return nil
  end
  local problems = {}
  if top.MEs and top.MEs < Topo.MEs then problems[#problems + 1] = top.MEs .. " M/E" end
  local keys = St.keyCount[1]
  if keys and keys < Topo.USKs then problems[#problems + 1] = keys .. " keyers per M/E" end
  if top.DSKs and top.DSKs < Topo.DSKs then problems[#problems + 1] = top.DSKs .. " DSK" end
  if top.Aux and top.Aux < Topo.Aux then problems[#problems + 1] = top.Aux .. " aux" end
  if #problems > 0 then
    return "Switcher only has " .. table.concat(problems, ", ") .. " - check the Custom properties"
  end
  return nil
end

---------------------------------------------------------------------------
-- Connection
---------------------------------------------------------------------------
local Conn = {
  ip = "",
  phase = "idle",       -- idle | connecting | syncing | ready | waiting (backoff)
  retryAt = nil,
  attempt = 0,
  reconnects = 0,
  syncStart = 0,
  unknown = {},
}

local Udp = UdpSocket.New()
local UdpOpen = false

local function OpenUdp()
  if UdpOpen then return true end
  local ok, err = pcall(function() Udp:Open() end)
  if not ok then
    SetError("Could not open UDP socket: " .. tostring(err))
    return false
  end
  UdpOpen = true
  return true
end

local function SetPhase(phase)
  Conn.phase = phase
  SetBool("Connected", phase == "syncing" or phase == "ready")
end

local Session -- forward
local Connect

local function ScheduleRetry(reason)
  Conn.attempt = Conn.attempt + 1
  local delay = BACKOFF[math.min(Conn.attempt, #BACKOFF)]
  Conn.retryAt = Now + delay
  Conn.retryReason = reason or "Not connected"
  Ready = false
  SetPhase("waiting")
  RenderAll()
  SetStatus(STATUS.Missing, ("%s - retry in %ds"):format(Conn.retryReason, delay))
  Log(1, ("%s, retry in %ds"):format(reason or "Disconnected", delay))
end

local function OnInitDone()
  Ready = true
  SetPhase("ready")
  Conn.attempt = 0
  RenderDevice()
  RenderAll()
  local problem = CheckModel()
  if problem then
    SetError(problem)
    SetStatus(STATUS.Compromised, problem)
  else
    SetStatus(STATUS.OK, "OK")
  end
  local inputs = 0
  for _ in pairs(St.inputs) do inputs = inputs + 1 end
  Log(1, ("State received in %.1fs: %s, protocol %s, %d M/E, %d sources"):format(
    Now - Conn.syncStart, St.product, AtemState.VersionString(St.version),
    St.top and St.top.MEs or 0, inputs))
end

local function OnCommand(name, data)
  local key, me = AtemState.Apply(St, name, data)
  if key == nil then
    if DebugLevel >= 2 and not Conn.unknown[name] then
      Conn.unknown[name] = true
      Log(2, ("Not handled: %s (%d bytes)"):format(name, #data))
    end
    return
  end
  if key == "error" then
    Log(1, ("Could not parse %s (%d bytes): %s"):format(name, #data, tostring(me)))
    return
  end
  if DebugLevel >= 2 and Ready then Log(2, ("< %s %s"):format(name, AtemProtocol.Hex(data, 24))) end
  if key == "me" or key == "dsk" or key == "aux" or key == "ss" then
    if me then Dirty[key][me] = true end
  elseif key == "input" then
    Dirty.names = true
  elseif key == "device" then
    if Ready then RenderDevice() end
  elseif key == "video" then
    Dirty.names = true   -- rates are shown in s:ff: render everything
  elseif key == "init" then
    OnInitDone()
  end
end

Session = AtemProtocol.NewSession({
  Transmit = function(data)
    if DebugLevel >= 2 and #data > 12 then Log(2, "> " .. AtemProtocol.Hex(data:sub(13), 48)) end
    local ok, err = pcall(function() Udp:Send(Conn.ip, AtemProtocol.PORT, data) end)
    if not ok then Log(1, "Send failed: " .. tostring(err)) end
  end,
  OnConnected = function()
    SetPhase("syncing")
    Conn.syncStart = Now
    SetStatus(STATUS.Initializing, "Connected, receiving switcher state")
    Log(1, "Connected to " .. Conn.ip)
  end,
  OnCommand = OnCommand,
  OnLost = function(reason)
    SetError(reason)
    ScheduleRetry(Conn.phase == "connecting" and "No answer from switcher" or "Connection lost")
  end,
  Log = Log,
})

Udp.EventHandler = function(_, packet)
  if packet.Address ~= Conn.ip then return end
  Session:Receive(packet.Data, Now)
end

local function ValidIp(ip)
  local a, b, c, d = ip:match("^(%d+)%.(%d+)%.(%d+)%.(%d+)$")
  if not a then return false end
  for _, v in ipairs({ a, b, c, d }) do
    if tonumber(v) > 255 then return false end
  end
  return true
end

Connect = function()
  Session:Close()
  Ready = false
  St = AtemState.New()
  Conn.retryAt = nil
  Conn.ip = Controls["IP Address"].String:gsub("^%s+", ""):gsub("%s+$", "")
  RenderDevice()
  if Conn.ip == "" then
    SetPhase("idle")
    RenderAll()
    SetStatus(STATUS.Missing, "No IP address set")
    return
  end
  if not ValidIp(Conn.ip) then
    SetPhase("idle")
    RenderAll()
    SetStatus(STATUS.Fault, "Invalid IP address: " .. Conn.ip)
    return
  end
  if not OpenUdp() then
    SetPhase("idle")
    SetStatus(STATUS.Fault, "Could not open UDP socket")
    return
  end
  SetPhase("connecting")
  RenderAll()
  SetStatus(STATUS.Initializing, "Connecting to " .. Conn.ip)
  Log(1, ("Connecting to %s:%d"):format(Conn.ip, AtemProtocol.PORT))
  Session:Connect(Now)
end

-- Send a command; dropped (with a log line) when not connected
local function Send(cmd, what, coalesceKey)
  if not Ready then
    Log(1, "Not connected - dropped: " .. what)
    return false
  end
  if coalesceKey == nil then Log(1, what) end
  Session:Queue(cmd, coalesceKey)
  Session:Flush(Now)
  return true
end

---------------------------------------------------------------------------
-- Main timer
---------------------------------------------------------------------------
local MainTimer = Timer.New()
-- Keep long-lived objects reachable from a global. Objects only held by locals
-- can be garbage collected on the Core and silently stop working.
AtemRuntime = { Timer = MainTimer, Udp = Udp, Session = Session, Conn = Conn }

MainTimer.EventHandler = function()
  Now = Now + TICK
  if Conn.phase == "waiting" and Conn.retryAt then
    if Now >= Conn.retryAt then
      Conn.reconnects = Conn.reconnects + 1
      SetString("Reconnects", tostring(Conn.reconnects))
      Connect()
      return
    end
    -- count down in the status text
    SetString("Status", ("%s - retry in %ds"):format(Conn.retryReason, math.ceil(Conn.retryAt - Now - 1e-6)))
  end
  Session:Tick(Now)
  if Ready then RenderDirty() end
end

---------------------------------------------------------------------------
-- User input
---------------------------------------------------------------------------
local function AfterInput(me)
  -- toggles flip on press: show the switcher's state again until feedback arrives
  RenderME(me)
end

for me = 1, Topo.MEs do
  local p = "ME" .. me .. " "

  for _, bus in ipairs({ "Program", "Preview" }) do
    local make = bus == "Program" and Cmd.Program or Cmd.Preview
    for _, id in ipairs(MEButtons[me]) do
      local key = AtemTopology.SourceKey(id)
      Controls[p .. bus .. " " .. key].EventHandler = function()
        Send(make(me, id), ("M/E %d %s: %s"):format(me, bus, key))
        AfterInput(me)
      end
    end
    Controls[p .. bus].EventHandler = function(c)
      local id = ComboId("me" .. me, c.String)
      if id then
        Send(make(me, id), ("M/E %d %s: %s"):format(me, bus, c.String))
      else
        Log(1, ("M/E %d %s: unknown source '%s'"):format(me, bus, c.String))
      end
      AfterInput(me)
    end
  end

  Controls[p .. "Cut"].EventHandler = function()
    Send(Cmd.Cut(me), ("M/E %d Cut"):format(me))
  end
  Controls[p .. "Auto"].EventHandler = function()
    Send(Cmd.Auto(me), ("M/E %d Auto"):format(me))
    AfterInput(me)
  end
  Controls[p .. "T-Bar"].EventHandler = function(c)
    TBarTouched[me] = Now
    local pos = math.floor(c.Position * 10000 + 0.5)
    Send(Cmd.TransitionPosition(me, pos), ("M/E %d T-bar %d"):format(me, pos), "tbar" .. me)
  end
  Controls[p .. "Fade to Black"].EventHandler = function()
    Send(Cmd.FadeToBlack(me), ("M/E %d Fade to Black"):format(me))
    AfterInput(me)
  end
  Controls[p .. "Fade to Black Rate"].EventHandler = function(c)
    local frames = AtemTopology.ParseRate(c.String, Fps())
    if frames then
      Send(Cmd.FadeToBlackRate(me, frames), ("M/E %d FTB rate %s (%d frames)"):format(me, c.String, frames), "ftbrate" .. me)
    else
      Log(1, ("M/E %d: invalid FTB rate '%s' (use s:ff, e.g. 1:00)"):format(me, c.String))
    end
    AfterInput(me)
  end

  local function SetStyle(index)
    Send(Cmd.NextStyle(me, index - 1), ("M/E %d style %s"):format(me, AtemTopology.TransitionStyles[index]))
    AfterInput(me)
  end
  for i, style in ipairs(AtemTopology.TransitionStyles) do
    Controls[p .. "Style " .. style].EventHandler = function() SetStyle(i) end
  end
  Controls[p .. "Transition Style"].EventHandler = function(c)
    for i, style in ipairs(AtemTopology.TransitionStyles) do
      if style == c.String then SetStyle(i) return end
    end
    AfterInput(me)
  end
  Controls[p .. "Transition Rate"].EventHandler = function(c)
    local m = St.me[me]
    local style = m and m.nextStyle or 0
    local frames = AtemTopology.ParseRate(c.String, Fps())
    local cmd = frames and Cmd.TransitionRate(me, style, frames)
    if cmd then
      Send(cmd, ("M/E %d %s rate %s (%d frames)"):format(me, AtemTopology.TransitionStyles[style + 1], c.String, frames),
        "rate" .. me)
    elseif not frames then
      Log(1, ("M/E %d: invalid rate '%s' (use s:ff, e.g. 1:00)"):format(me, c.String))
    else
      Log(1, ("M/E %d: %s has no rate"):format(me, AtemTopology.TransitionStyles[style + 1] or "?"))
    end
    AfterInput(me)
  end
  Controls[p .. "Preview Transition"].EventHandler = function()
    local m = St.me[me]
    Send(Cmd.PreviewTransition(me, not (m and m.previewTransition)), ("M/E %d Preview Transition"):format(me))
    AfterInput(me)
  end

  -- Next transition: background and keys form a bit mask that must not be empty
  local function ToggleNext(bit, what)
    local m = St.me[me]
    if m then
      local mask = m.nextSelection ~ bit
      if mask == 0 then
        Log(1, ("M/E %d: at least one element must stay selected for the next transition"):format(me))
      else
        Send(Cmd.NextSelection(me, mask), ("M/E %d Next %s"):format(me, what))
      end
    end
    AfterInput(me)
  end
  Controls[p .. "Next Background"].EventHandler = function() ToggleNext(1, "Background") end
  for k = 1, Topo.USKs do
    Controls[p .. "Next Key " .. k].EventHandler = function() ToggleNext(1 << k, "Key " .. k) end
    Controls[p .. "Key " .. k .. " On Air"].EventHandler = function()
      local m = St.me[me]
      local on = not (m and m.keyOnAir[k])
      Send(Cmd.KeyOnAir(me, k, on), ("M/E %d Key %d %s"):format(me, k, on and "on air" or "off air"))
      AfterInput(me)
    end
  end
end

-- Upstream keyer sources
for me = 1, Topo.MEs do
  for k = 1, Topo.USKs do
    local q = "ME" .. me .. " Key " .. k .. " "
    for _, part in ipairs({ "Fill", "Key" }) do
      Controls[q .. part].EventHandler = function(c)
        local id = ComboId("key", c.String)
        if id then
          local make = part == "Fill" and Cmd.KeyFill or Cmd.KeyKey
          Send(make(me, k, id), ("M/E %d Key %d %s: %s"):format(me, k, part, c.String))
        end
        RenderME(me)
      end
    end
  end
end

-- Downstream keyers
for n = 1, Topo.DSKs do
  local p = "DSK " .. n .. " "
  local function D() return St.dsk[n] or {} end
  Controls[p .. "On Air"].EventHandler = function()
    local on = not D().onAir
    Send(Cmd.DskOnAir(n, on), ("DSK %d %s"):format(n, on and "on air" or "off air"))
    RenderDSK(n)
  end
  Controls[p .. "Tie"].EventHandler = function()
    local on = not D().tie
    Send(Cmd.DskTie(n, on), ("DSK %d tie %s"):format(n, on and "on" or "off"))
    RenderDSK(n)
  end
  Controls[p .. "Auto"].EventHandler = function()
    Send(Cmd.DskAuto(St, n), ("DSK %d auto"):format(n))
    RenderDSK(n)
  end
  Controls[p .. "Rate"].EventHandler = function(c)
    local frames = AtemTopology.ParseRate(c.String, Fps())
    if frames then
      Send(Cmd.DskRate(n, frames), ("DSK %d rate %s (%d frames)"):format(n, c.String, frames), "dskrate" .. n)
    else
      Log(1, ("DSK %d: invalid rate '%s' (use s:ff, e.g. 1:00)"):format(n, c.String))
    end
    RenderDSK(n)
  end
  for _, part in ipairs({ "Fill", "Key" }) do
    Controls[p .. part].EventHandler = function(c)
      local id = ComboId("key", c.String)
      if id then
        local make = part == "Fill" and Cmd.DskFill or Cmd.DskKey
        Send(make(n, id), ("DSK %d %s: %s"):format(n, part, c.String))
      end
      RenderDSK(n)
    end
  end
end

-- Aux outputs
for aux = 1, Topo.Aux do
  for _, id in ipairs(AuxButtons[aux]) do
    Controls["Aux " .. aux .. " " .. Key(id)].EventHandler = function()
      Send(Cmd.Aux(aux, id), ("Aux %d: %s"):format(aux, Key(id)))
      RenderAux(aux)
    end
  end
  Controls["Aux " .. aux].EventHandler = function(c)
    local id = ComboId("aux" .. aux, c.String)
    if id then
      Send(Cmd.Aux(aux, id), ("Aux %d: %s"):format(aux, c.String))
    else
      Log(1, ("Aux %d: unknown source '%s'"):format(aux, c.String))
    end
    RenderAux(aux)
  end
end

-- SuperSource boxes
for ss = 1, Topo.SuperSources do
  for box = 1, AtemTopology.BOXES do
    local p = "SS" .. ss .. " Box " .. box .. " "
    local function B()
      local s = St.ss[ss]
      return s and s.boxes[box] or {}
    end
    Controls[p .. "Enable"].EventHandler = function()
      local on = not B().enabled
      Send(Cmd.SuperSourceBox(St, ss, box, on, nil), ("SuperSource %d box %d %s"):format(ss, box, on and "on" or "off"))
      RenderSS(ss)
    end
    local function SetSource(id, what)
      Send(Cmd.SuperSourceBox(St, ss, box, nil, id), ("SuperSource %d box %d: %s"):format(ss, box, what))
      RenderSS(ss)
    end
    for _, id in ipairs(BoxButtons) do
      Controls[p .. Key(id)].EventHandler = function() SetSource(id, Key(id)) end
    end
    Controls[p .. "Source"].EventHandler = function(c)
      local id = ComboId("box", c.String)
      if id then SetSource(id, c.String) else RenderSS(ss) end
    end
  end
end

Controls["IP Address"].EventHandler = function()
  Conn.attempt = 0
  Connect()
end
Controls.Reconnect.EventHandler = function()
  Conn.attempt = 0
  Conn.reconnects = Conn.reconnects + 1
  SetString("Reconnects", tostring(Conn.reconnects))
  Connect()
end

---------------------------------------------------------------------------
-- Start
---------------------------------------------------------------------------
SetString("Reconnects", "0")
SetError("")
for me = 1, Topo.MEs do
  SetChoices("ME" .. me .. " Transition Style", AtemTopology.TransitionStyles)
end
RenderAll()
Log(1, ("Started, build %s - model %s, %d M/E"):format(PluginInfo.BuildVersion, Topo.Name, Topo.MEs))
MainTimer:Start(TICK)
Connect()
-- <<< runtime.lua
end
