  ["speaker_group"] = { o = "M339-220h441v-640H339v640Zm0 60q-23 0-41-18.5T280-220v-640q0-23 18-41.5t41-18.5h441q23 0 41.5 18.5T840-860v640q0 23-18.5 41.5T780-160H339Zm221-473q33.75 0 57.38-23Q641-679 641-714q0-32.92-23.62-55.96Q593.75-793 560-793q-32.92 0-55.96 23.04T481-714q0 35 23.04 58T560-633Zm1 346q57.17 0 97.59-40.5Q699-368 699-427t-40.41-99.5Q618.17-567 561-567q-58.83 0-100.41 40.5Q419-486 419-427t41.59 99.5Q502.17-287 561-287Zm-2.47-60Q525-347 502-370.26q-23-23.27-23-56.5 0-33.24 23-56.74t56.53-23.5q33.53 0 57 23.26Q639-460.47 639-427.24q0 33.24-23.47 56.74t-57 23.5ZM489.1-40H220q-23 0-41.5-18.5T160-100v-670q0-12.75 8.68-21.38 8.67-8.62 21.5-8.62 12.82 0 21.32 8.62 8.5 8.63 8.5 21.38v670h269.28q12.72 0 21.22 8.68 8.5 8.67 8.5 21.5 0 12.82-8.6 21.32-8.59 8.5-21.3 8.5ZM339-860v640-640Z", f = "M339-160q-23 0-41-18.5T280-220v-640q0-23 18-41.5t41-18.5h441q23 0 41.5 18.5T840-860v640q0 23-18.5 41.5T780-160H339Zm221-473q33.75 0 57.38-23Q641-679 641-714q0-32.92-23.62-55.96Q593.75-793 560-793q-32.92 0-55.96 23.04T481-714q0 35 23.04 58T560-633Zm1 346q57.17 0 97.59-40.5Q699-368 699-427t-40.41-99.5Q618.17-567 561-567q-58.83 0-100.41 40.5Q419-486 419-427t41.59 99.5Q502.17-287 561-287Zm-2.47-60Q525-347 502-370.26q-23-23.27-23-56.5 0-33.24 23-56.74t56.53-23.5q33.53 0 57 23.26Q639-460.47 639-427.24q0 33.24-23.47 56.74t-57 23.5ZM489.1-40H220q-23 0-41.5-18.5T160-100v-670q0-12.75 8.68-21.38 8.67-8.62 21.5-8.62 12.82 0 21.32 8.62 8.5 8.63 8.5 21.38v670h269.28q12.72 0 21.22 8.68 8.5 8.67 8.5 21.5 0 12.82-8.6 21.32-8.59 8.5-21.3 8.5Z" },
}
MenuIconNames = {}
for k in pairs(MenuIcons) do table.insert(MenuIconNames, k) end
table.sort(MenuIconNames)
-- <<< icons.lua

PageNames = { "Control", "Setup", "About" }

function GetColor(props)
  return LevoBrand.Colors.Atlantic
end

function GetPrettyName(props)
  return PluginInfo.Name:gsub("^.-~", "") .. "\n" .. PluginInfo.BuildVersion
end

function GetPages(props)
  local pages = {}
  for _, name in ipairs(PageNames) do
    table.insert(pages, { name = name })
  end
  return pages
end

function GetProperties()
  local props = {}
  -- >>> properties.lua
-- (c) levo AVL | Elias Jenny - MIT License
-- Only settings that change the number or size of controls live here.
-- Everything else is on the Setup page and can be changed live.
table.insert(props, { Name = "Menu Count",   Type = "integer", Min = 2, Max = 12, Value = 4 })
table.insert(props, { Name = "Orientation",  Type = "enum", Choices = { "Horizontal", "Vertical" }, Value = "Horizontal" })
table.insert(props, { Name = "Item Width",   Type = "integer", Min = 30, Max = 4000, Value = 200 })
table.insert(props, { Name = "Item Height",  Type = "integer", Min = 30, Max = 2000, Value = 60 })
table.insert(props, {
  Name = "Debug Print",
  Type = "enum",
  Choices = { "None", "Basic", "Verbose" },
  Value = "None",
})
-- <<< properties.lua
  return props
end

function RectifyProperties(props)
  -- >>> rectify.lua
-- (c) levo AVL | Elias Jenny - MIT License
if props.plugin_show_debug.Value == false then
  props["Debug Print"].IsHidden = true
end
-- <<< rectify.lua
  return props
end

function GetPins(props)
  local pins = {}
  return pins
end

function GetControls(props)
  local ctrls = {}
  -- >>> controls.lua
-- (c) levo AVL | Elias Jenny - MIT License
local n   = props["Menu Count"].Value

local function Add(def)
  def.Count = def.Count or 1
  if def.UserPin == nil then def.UserPin = false end
  table.insert(ctrls, def)
end
local function Combo(name, count) Add({ Name = name, ControlType = "Text", Count = count }) end
local function Text(name, count)  Add({ Name = name, ControlType = "Text", Count = count }) end
local function Toggle(name)       Add({ Name = name, ControlType = "Button", ButtonType = "Toggle" }) end
local function Int(name, min, max)
  Add({ Name = name, ControlType = "Knob", ControlUnit = "Integer", Min = min, Max = max })
end

-- Menu items: these go onto the UCI. Their look is drawn by the plugin.
Add({ Name = "Menu", ControlType = "Button", ButtonType = "Toggle", Count = n, UserPin = true, PinStyle = "Both" })
Add({ Name = "Menu Active", ControlType = "Indicator", IndicatorType = "Led", Count = n, UserPin = true, PinStyle = "Output" })
Add({ Name = "Active Menu", ControlType = "Knob", ControlUnit = "Integer", Min = 1, Max = n, UserPin = true, PinStyle = "Both" })
Add({ Name = "Lock", ControlType = "Button", ButtonType = "Toggle", UserPin = true, PinStyle = "Both" })
Add({ Name = "Status", ControlType = "Indicator", IndicatorType = "Status", UserPin = true, PinStyle = "Output" })

-- Setup: look (live)
Combo("Content")
Combo("Font")
Int("Font Size", 8, 72)
Toggle("Bold Active")
Int("Icon Size", 12, 300)
Toggle("Fill Active Icon")
Int("Item Gap", 0, 200)
Int("Width Correction", -200, 400)
Int("Height Correction", -200, 400)
Int("Corner Radius", 0, 300)
Combo("Rounded Corners")
Combo("Indicator Style")
Combo("Line Position")
Int("Indicator Size", 1, 40)
Int("Indicator Margin X", 0, 200)
Int("Indicator Margin Y", 0, 200)
Toggle("Dividers")
Int("Divider Length", 5, 100)
Int("Divider Width", 1, 10)
Int("Animation Time", 0, 2000)
for _, c in ipairs({ "Background", "Text", "Active Text", "Indicator", "Divider" }) do Text("Color " .. c) end

-- Setup: items and navigation
Add({ Name = "Label", ControlType = "Text", Count = n, UserPin = true, PinStyle = "Both" })
Combo("Icon", n)
Text("Page", n)
Text("Layers", n)
Text("Panels")
Combo("Add Panel")
Text("UCI Name")
Combo("Layer Transition")

-- Marks that the defaults have been written once
Text("Defaults Set")
-- <<< controls.lua
  return ctrls
end

function GetControlLayout(props)
  local layout, graphics = {}, {}
  local CurrentPage = PageNames[props["page_index"].Value]
  -- >>> layout.lua
-- (c) levo AVL | Elias Jenny - MIT License
local n        = props["Menu Count"].Value
local vertical = props["Orientation"].Value == "Vertical"
local IW, IH   = props["Item Width"].Value, props["Item Height"].Value
-- Buttons overlap by 2 px: Q-SYS leaves a thin inset around a button icon, the overlap hides it.
-- Visible gaps come from Item Gap, drawn inside the SVG.
local SP       = -2
local C   = LevoBrand.Colors
local M   = 16
local ROW = 24

local barW = vertical and IW or (n * IW + (n - 1) * SP)
local barH = vertical and (n * IH + (n - 1) * SP) or IH

local function Label(text, x, ly, w, align, color, style)
  table.insert(graphics, {
    Type = "Text", Text = text, Position = { x, ly }, Size = { w, 20 },
    FontSize = 12, FontStyle = style or "Regular", HTextAlign = align or "Right", Color = color or C.Onyx,
  })
end

local function Section(text, x, ly, w)
  Label(text, x, ly, w, "Left", C.Atlantic, "Bold")
  return ly + 24
end

-- The menu bar at real size, so the items can be copied onto a UCI together
local function Bar(x0, y0)
  for i = 1, n do
    local x  = vertical and x0 or (x0 + (i - 1) * (IW + SP))
    local iy = vertical and (y0 + (i - 1) * (IH + SP)) or y0
    layout["Menu " .. i] = { PrettyName = "Menu~" .. i, Style = "Button",
      Position = { x, iy }, Size = { IW, IH }, Margin = 0, Padding = 0, StrokeWidth = 0 }
  end
end

if CurrentPage == "Control" then
  local W = math.max(520, barW + 2 * M + (vertical and 40 or 0))
  local H = LevoBrand.HeaderHeight + 2 + 16 + 24 + barH + (vertical and 0 or 24) + 100
  LevoBrand.Background(graphics, W, H)
  local y = LevoBrand.Header(graphics, W, LevoBrand.PluginName(PluginInfo), CurrentPage) + 16
  Label("Menu bar - select all items and copy them onto the UCI", M, y, W - 2 * M, "Left", C.Atlantic, "Bold")
  y = y + 24
  Bar(M, y)
  for i = 1, n do
    local x  = vertical and M or (M + (i - 1) * (IW + SP))
    local iy = vertical and (y + (i - 1) * (IH + SP)) or y
    local lx = vertical and (M + IW + 16) or (x + IW / 2 - 6)
    local ly = vertical and (iy + IH / 2 - 6) or (y + IH + 8)
    layout["Menu Active " .. i] = { PrettyName = "Menu Active~" .. i, Style = "Led",
      Position = { lx, ly }, Size = { 12, 12 } }
  end
  y = y + barH + (vertical and 16 or 32)
  Label("Active Menu", M, y, 100)
  layout["Active Menu"] = { PrettyName = "Active Menu", Style = "Text", Position = { M + 108, y }, Size = { 60, 20 } }
  Label("Lock", M + 180, y, 60)
  layout["Lock"] = { PrettyName = "Lock", Style = "Button", Legend = "Lock", Position = { M + 248, y }, Size = { 60, 20 } }
  y = y + 32
  Label("Status", M, y, 100)
  layout["Status"] = { PrettyName = "Status", Position = { M + 108, y }, Size = { W - 2 * M - 108, 20 } }

elseif CurrentPage == "Setup" then
  -- live preview on top, settings below in two columns
  local colW = 330
  local W = math.max(2 * colW + 3 * M, barW + 2 * M)
  local x1, x2 = M, 2 * M + colW
  local lw = 120                       -- label width
  local cx1, cx2 = x1 + lw + 8, x2 + lw + 8

  local rowsLook = 26
  local rowsItems = n + 11
  local H = LevoBrand.HeaderHeight + 2 + 16 + 24 + barH + 24 + math.max(rowsLook, rowsItems) * ROW + 3 * 24 + 40
  LevoBrand.Background(graphics, W, H)
  local y = LevoBrand.Header(graphics, W, LevoBrand.PluginName(PluginInfo), CurrentPage) + 16
  Label("Preview", M, y, W - 2 * M, "Left", C.Atlantic, "Bold")
  y = y + 24
  Bar(M, y)
  y = y + barH + 24
  local yTop = y

  -- Left column: look
  local function Field(name, label, style, col, ly, w)
    local x = col == 1 and x1 or x2
    Label(label, x, ly, lw)
    local def = { PrettyName = "Setup~" .. name, Style = style, Position = { (col == 1 and cx1 or cx2), ly }, Size = { w or 120, 20 } }
    if style == "Button" then def.Legend = "On" end
    layout[name] = def
    return ly + ROW
  end

  y = Section("Content", x1, y, colW)
  y = Field("Content", "Content", "ComboBox", 1, y)
  y = Field("Font", "Font", "ComboBox", 1, y)
  y = Field("Font Size", "Font Size", "Text", 1, y, 60)
  y = Field("Bold Active", "Bold Active", "Button", 1, y, 60)
  y = Field("Icon Size", "Icon Size", "Text", 1, y, 60)
  y = Field("Fill Active Icon", "Fill Active Icon", "Button", 1, y, 60)
  y = y + 6
  y = Section("Shape", x1, y, colW)
  y = Field("Item Gap", "Item Gap", "Text", 1, y, 60)
  y = Field("Width Correction", "Width Correction", "Text", 1, y, 60)
  y = Field("Height Correction", "Height Correction", "Text", 1, y, 60)
  y = Field("Corner Radius", "Corner Radius", "Text", 1, y, 60)
  y = Field("Rounded Corners", "Rounded Corners", "ComboBox", 1, y)
  y = Field("Dividers", "Dividers", "Button", 1, y, 60)
  y = Field("Divider Length", "Divider Length %", "Text", 1, y, 60)
  y = Field("Divider Width", "Divider Width", "Text", 1, y, 60)
  y = y + 6
  y = Section("Indicator", x1, y, colW)
  y = Field("Indicator Style", "Style", "ComboBox", 1, y)
  y = Field("Line Position", "Line Position", "ComboBox", 1, y)
  y = Field("Indicator Size", "Line Size", "Text", 1, y, 60)
  y = Field("Indicator Margin X", "Margin Left/Right", "Text", 1, y, 60)
  y = Field("Indicator Margin Y", "Margin Top/Bottom", "Text", 1, y, 60)
  y = Field("Animation Time", "Animation ms", "Text", 1, y, 60)
  y = y + 6
  y = Section("Colours (hex or none)", x1, y, colW)
  for _, c in ipairs({ "Background", "Text", "Active Text", "Indicator", "Divider" }) do
    y = Field("Color " .. c, c, "Text", 1, y, 90)
  end

  -- Right column: navigation and items
  y = yTop
  y = Section("Pages (Uci.SetPage)", x2, y, colW)
  y = Field("Panels", "Panels", "Text", 2, y, 190)
  y = Field("Add Panel", "Add Panel", "ComboBox", 2, y, 190)
  Label("Empty = do not switch pages.", x2, y, colW, "Left", C.Mid); y = y + ROW
  y = Section("Layers (Uci.SetLayerVisibility)", x2, y, colW)
  y = Field("UCI Name", "UCI Name", "Text", 2, y, 190)
  y = Field("Layer Transition", "Transition", "ComboBox", 2, y, 120)
  y = y + 6
  y = Section("Menu items", x2, y, colW)
  local cols = { { "Label", 70 }, { "Icon", 90 }, { "Page", 60 }, { "Layers", 70 } }
  local x = x2 + 24
  for _, c in ipairs(cols) do Label(c[1], x, y, c[2], "Left", C.Mid); x = x + c[2] + 4 end
  y = y + 20
  for i = 1, n do
    Label(tostring(i), x2, y, 20)
    x = x2 + 24
    for _, c in ipairs(cols) do
      layout[c[1] .. " " .. i] = { PrettyName = "Menu~" .. i .. "~" .. c[1],
        Style = c[1] == "Icon" and "ComboBox" or "Text", Position = { x, y }, Size = { c[2], 20 } }
      x = x + c[2] + 4
    end
    y = y + ROW
  end
  Label("Layers: comma-separated, on the item's Page.", x2, y + 4, colW, "Left", C.Mid)

elseif CurrentPage == "About" then
  local W = 560
  LevoBrand.Background(graphics, W, 440)
  local y = LevoBrand.Header(graphics, W, LevoBrand.PluginName(PluginInfo), CurrentPage) + 16
  y = LevoBrand.About(graphics, M, y, W - 2 * M, PluginInfo)
  Label("Icons: Material Symbols by Google, Apache License 2.0.", M, y + 4, W - 2 * M, "Left", C.Mid)
end
-- <<< layout.lua
  return layout, graphics
end

if Controls then
  -- >>> runtime.lua
-- (c) levo AVL | Elias Jenny - MIT License
-- Runtime: draws the menu items as SVG, animates the indicator and navigates the UCI.

local json = require("rapidjson")

local DebugLevel = ({ None = 0, Basic = 1, Verbose = 2 })[Properties["Debug Print"].Value] or 0
local function Log(level, msg)
  if level <= DebugLevel then print("[levo] " .. msg) end
end

local function SetStatus(value, text)
  Controls.Status.Value = value  -- 0 OK, 1 Compromised, 2 Fault, 3 Not present, 4 Missing, 5 Initializing
  Controls.Status.String = text or ""
end

-- Fixed configuration (properties) ---------------------------------------------
local P = function(name) return Properties[name].Value end
local N        = P("Menu Count")
local VERTICAL = P("Orientation") == "Vertical"
local BASE_W, BASE_H = P("Item Width"), P("Item Height")
local OVERLAP = 2   -- px, must match the layout (hides the inset around button icons)
-- Drawing size of one item. Width/Height Correction (Setup) enlarge the SVG when Q-SYS
-- fits it into a box with a different aspect ratio than the button.
local IW, IH = BASE_W, BASE_H
local SPAN, PITCH                     -- item length along the bar; items sit edge to edge
local function UpdateSize(wc, hc)
  IW, IH = math.max(10, BASE_W + wc), math.max(10, BASE_H + hc)
  SPAN = VERTICAL and IH or IW
  PITCH = SPAN - OVERLAP
end
UpdateSize(0, 0)
local FRAME_S = 0.03                  -- ~33 frames per second

local function Trim(s) return (s:gsub("^%s+", ""):gsub("%s+$", "")) end
local function Hex(rgb) return string.format("#%02X%02X%02X", rgb[1], rgb[2], rgb[3]) end

-- Live configuration (Setup page) ----------------------------------------------------
local CHOICES = {
  ["Content"]          = { "Text", "Icon", "Icon + Text" },
  ["Font"]             = { "Arial", "Helvetica", "Verdana", "Tahoma", "Trebuchet MS", "Georgia" },
  ["Rounded Corners"]  = { "Bar Ends", "Each Item" },
  ["Indicator Style"]  = { "None", "Line", "Pill", "Block" },
  ["Line Position"]    = { "Bottom / Right", "Top / Left" },
  ["Layer Transition"] = { "none", "fade", "left", "right", "top", "bottom" },
}

-- Written once on the first start; afterwards the user's values are kept
local DEFAULTS = {
  ["Content"] = "Icon + Text", ["Font"] = "Tahoma", ["Font Size"] = 18, ["Bold Active"] = true,
  ["Icon Size"] = 28, ["Fill Active Icon"] = true,
  ["Item Gap"] = 0, ["Width Correction"] = 0, ["Height Correction"] = 0, ["Corner Radius"] = 30, ["Rounded Corners"] = "Bar Ends",
  ["Indicator Style"] = "Pill", ["Line Position"] = "Bottom / Right",
  ["Indicator Size"] = 4, ["Indicator Margin X"] = 0, ["Indicator Margin Y"] = 0, ["Animation Time"] = 200,
  ["Dividers"] = true, ["Divider Length"] = 60, ["Divider Width"] = 2,
  ["Color Background"]  = Hex(LevoBrand.Colors.Atlantic),
  ["Color Text"]        = Hex(LevoBrand.Colors.Porcelain),
  ["Color Active Text"] = Hex(LevoBrand.Colors.Porcelain),
  ["Color Indicator"]   = Hex(LevoBrand.Colors.Amber),
  ["Color Divider"]     = Hex(LevoBrand.Colors.Porcelain),
  ["Layer Transition"]  = "none",
}

for name, list in pairs(CHOICES) do
  if Controls[name] then Controls[name].Choices = list end
end

if Controls["Defaults Set"].String == "" then
  for name, v in pairs(DEFAULTS) do
    local ctl = Controls[name]
    if ctl then
      if type(v) == "boolean" then ctl.Boolean = v
      elseif type(v) == "number" then ctl.Value = v
      else ctl.String = v end
    end
  end
  local items = {
    { "Power", "power_settings_new" }, { "Audio", "mic" },
    { "Video", "desktop_windows" }, { "Settings", "settings" },
  }
  for i = 1, N do
    local it = items[i]
    Controls.Label[i].String = it and it[1] or ("Menu " .. i)
    Controls.Icon[i].String = it and it[2] or ""
  end
  Controls["Defaults Set"].String = "1"
end

local function S(name) return Controls[name].String end
local function V(name) return math.floor(Controls[name].Value + 0.5) end
local function B(name) return Controls[name].Boolean end

local GAP, RADIUS, EACH_ITEM, CONTENT, FONT, FONT_SIZE, BOLD, ICON_SIZE, FILL_ICON
local IND_STYLE, LINE_END, IND_SIZE, MX, MY, DIVIDERS, DIV_LEN, DIV_W, ANIM_MS, TRANSITION
local COLORS, ITEMS = {}, {}

local function LoadConfig()
  UpdateSize(V("Width Correction"), V("Height Correction"))
  GAP        = V("Item Gap") / 2       -- half the gap on each side of an item
  RADIUS     = V("Corner Radius")
  EACH_ITEM  = S("Rounded Corners") == "Each Item"
  CONTENT    = S("Content")
  FONT       = S("Font") ~= "" and S("Font") or "Arial"
  FONT_SIZE  = V("Font Size")
  BOLD       = B("Bold Active")
  ICON_SIZE  = V("Icon Size")
  FILL_ICON  = B("Fill Active Icon")
  IND_STYLE  = S("Indicator Style")
  LINE_END   = S("Line Position") ~= "Top / Left"
  IND_SIZE   = V("Indicator Size")
  MX         = V("Indicator Margin X")
  MY         = V("Indicator Margin Y")
  DIVIDERS   = B("Dividers")
  DIV_LEN    = V("Divider Length") / 100
  DIV_W      = V("Divider Width")
  ANIM_MS    = V("Animation Time")
  TRANSITION = Controls["Layer Transition"] and S("Layer Transition") or "fade"
  if TRANSITION == "" then TRANSITION = "fade" end

  -- colours: hex or "none"; anything else falls back to the levo colour
  for _, name in ipairs({ "Background", "Text", "Active Text", "Indicator", "Divider" }) do
    local s = S("Color " .. name):gsub("%s", "")
    if s:match("^#%x%x%x%x%x%x$") or s:match("^#%x%x%x$") or s:lower() == "none" then
      COLORS[name] = s
    else
      COLORS[name] = DEFAULTS["Color " .. name]
    end
  end

  for i = 1, N do
    local icon = Trim(Controls.Icon[i].String)
    ITEMS[i] = {
      label  = Trim(Controls.Label[i].String),
      icon   = icon ~= "" and icon ~= "(none)" and icon or nil,
      page   = Controls.Page and Trim(Controls.Page[i].String) or "",
      layers = Controls.Layers and Controls.Layers[i].String or "",
    }
  end
end
LoadConfig()

local function Color(name) return COLORS[name] end

local function Fill(color)
  return color:lower() == "none" and 'fill="none"' or ('fill="' .. color .. '"')
end

-- State --------------------------------------------------------------------------
local current = math.max(1, math.min(N, math.floor(Controls["Active Menu"].Value + 0.5)))
local pos     = (current - 1) * PITCH         -- indicator position along the bar in px
local anim    = { from = pos, to = pos, t0 = 0, dur = 0 }
local animTimer = Timer.New()
local navError = nil

-- SVG helpers ----------------------------------------------------------------------
local function Escape(s)
  return (s:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub('"', "&quot;"))
end

-- Rectangle with individual corner radii: tl, tr, br, bl
local function RoundRect(x, y, w, h, tl, tr, br, bl, attrs)
  local max = math.min(w, h) / 2
  tl, tr, br, bl = math.min(tl, max), math.min(tr, max), math.min(br, max), math.min(bl, max)
  return string.format(
    '<path d="M%.1f,%.1f H%.1f A%.1f,%.1f 0 0 1 %.1f,%.1f V%.1f A%.1f,%.1f 0 0 1 %.1f,%.1f ' ..
    'H%.1f A%.1f,%.1f 0 0 1 %.1f,%.1f V%.1f A%.1f,%.1f 0 0 1 %.1f,%.1f Z" %s/>',
    x + tl, y, x + w - tr, tr, tr, x + w, y + tr,
    y + h - br, br, br, x + w - br, y + h,
    x + bl, bl, bl, x, y + h - bl,
    y + tl, tl, tl, x + tl, y, attrs)
end

-- Corner radii of item i: rounded outer ends of the bar, or every item
local function Corners(i)
  if RADIUS == 0 then return 0, 0, 0, 0 end
  if EACH_ITEM then return RADIUS, RADIUS, RADIUS, RADIUS end
  local first, last = (i == 1), (i == N)
  if VERTICAL then
    return first and RADIUS or 0, first and RADIUS or 0, last and RADIUS or 0, last and RADIUS or 0
  end
  return first and RADIUS or 0, last and RADIUS or 0, last and RADIUS or 0, first and RADIUS or 0
end

-- Polygons: the indicator is clipped to the item's own shape, so a line or pill never
-- sticks out over rounded corners or into the gap. Kept cheap: Q-SYS limits the number of
-- instructions per event.
local SEG = 6   -- segments per corner arc
local COS, SIN = {}, {}
for k = 0, 4 * SEG do
  local a = math.rad(180 + 90 * k / SEG)
  COS[k], SIN[k] = math.cos(a), math.sin(a)
end

local function RoundRectPoly(x, y, w, h, tl, tr, br, bl)
  local max = math.min(w, h) / 2
  local pts = {}
  local function arc(cx, cy, r, q)          -- q = quadrant 0..3, starting at 180 deg
    if r <= 0 then pts[#pts + 1] = { cx, cy }; return end
    r = math.min(r, max)
    for k = q * SEG, q * SEG + SEG do pts[#pts + 1] = { cx + r * COS[k], cy + r * SIN[k] } end
  end
  tl, tr, br, bl = math.min(tl, max), math.min(tr, max), math.min(br, max), math.min(bl, max)
  arc(x + tl, y + tl, tl, 0)
  arc(x + w - tr, y + tr, tr, 1)
  arc(x + w - br, y + h - br, br, 2)
  arc(x + bl, y + h - bl, bl, 3)
  return pts
end

-- Sutherland-Hodgman: clip polygon subj by the convex polygon clip (same winding)
local function ClipPoly(subj, clip)
  local out = subj
  local nc = #clip
  for e = 1, nc do
    if #out == 0 then return out end
    local a, b = clip[e], clip[e % nc + 1]
    local ax, ay = a[1], a[2]
    local ex, ey = b[1] - ax, b[2] - ay
    if ex ~= 0 or ey ~= 0 then
      local input = out
      out = {}
      local prev = input[#input]
      local pin = ex * (prev[2] - ay) - ey * (prev[1] - ax) >= -1e-6
      for _, cur in ipairs(input) do
        local cin = ex * (cur[2] - ay) - ey * (cur[1] - ax) >= -1e-6
        if cin ~= pin then
          local dx, dy = cur[1] - prev[1], cur[2] - prev[2]
          local den = dx * ey - dy * ex
          local t = den ~= 0 and ((ax - prev[1]) * ey - (ay - prev[2]) * ex) / den or 0
          out[#out + 1] = { prev[1] + t * dx, prev[2] + t * dy }
        end
        if cin then out[#out + 1] = cur end
        prev, pin = cur, cin
      end
    end
  end
  return out
end

local function PolyPath(pts, attrs)
  if #pts < 3 then return "" end
  local d = {}
  for k, p in ipairs(pts) do d[k] = string.format("%s%.1f,%.1f", k == 1 and "M" or "L", p[1], p[2]) end
  return '<path d="' .. table.concat(d, " ") .. ' Z" ' .. attrs .. '/>'
end

-- Item shape (after the gap inset)
local function ItemBox(i)
  local gx, gy = VERTICAL and 0 or GAP, VERTICAL and GAP or 0
  return gx, gy, IW - 2 * gx, IH - 2 * gy
end

-- Clip polygon per item, rebuilt when the look changes
local clipCache = {}
local function ClipShape(i)
  if not clipCache[i] then
    local bx, by, bw, bh = ItemBox(i)
    clipCache[i] = RoundRectPoly(bx, by, bw, bh, Corners(i))
  end
  return clipCache[i]
end

-- Indicator shape for an item, d = indicator start relative to this item (px along the bar).
-- MX / MY keep it away from the left/right and top/bottom edges of the item.
local function Indicator(i, d)
  if IND_STYLE == "None" then return "" end
  local col = Fill(Color("Indicator"))
  if d >= SPAN or d <= -SPAN then return "" end   -- indicator not on this item
  local bx, by, bw, bh = ItemBox(i)
  local x0 = (VERTICAL and 0 or d) + bx + MX
  local y0 = (VERTICAL and d or 0) + by + MY
  local w, h = bw - 2 * MX, bh - 2 * MY
  if w <= 0 or h <= 0 then return "" end

  local shape
  if IND_STYLE == "Line" then
    local r = IND_SIZE / 2
    if VERTICAL then
      local lx = LINE_END and (x0 + w - IND_SIZE) or x0
      shape = RoundRectPoly(lx, y0, IND_SIZE, h, r, r, r, r)
    else
      local ly = LINE_END and (y0 + h - IND_SIZE) or y0
      shape = RoundRectPoly(x0, ly, w, IND_SIZE, r, r, r, r)
    end
  elseif IND_STYLE == "Pill" then
    local r = math.min(w, h) / 2
    shape = RoundRectPoly(x0, y0, w, h, r, r, r, r)
  else
    -- Block takes the shape of the item it rests on (square unless that item is rounded)
    local k = math.max(1, math.min(N, math.floor(pos / PITCH + 0.5) + 1))
    local tl, tr, br, bl = Corners(k)
    local m = math.min(MX, MY)
    local function R(c) return math.max(0, c - m) end
    shape = RoundRectPoly(x0, y0, w, h, R(tl), R(tr), R(br), R(bl))
  end
  -- square item without gap: the SVG viewport already clips, no polygon work needed
  local tl, tr, br, bl = Corners(i)
  if GAP == 0 and tl + tr + br + bl == 0 then return PolyPath(shape, col) end
  return PolyPath(ClipPoly(shape, ClipShape(i)), col)
end

-- Divider on boundary k (between item k and k+1), drawn in item i's coordinates.
-- Neighbouring buttons overlap by 2 px; both items draw it at the same spot, whichever lies on top shows it.
local function DividerAt(i, k)
  if k < 1 or k >= N then return "" end
  -- no divider where a Pill or Block covers the edge (also while it slides)
  local edge = k * PITCH + OVERLAP / 2 - DIV_W / 2   -- start of the divider along the bar
  if IND_STYLE == "Pill" or IND_STYLE == "Block" then
    if edge + DIV_W >= pos - 1 and edge <= pos + SPAN + 1 then return "" end
  end
  local at = edge - (i - 1) * PITCH                   -- relative to item i
  local col = Fill(Color("Divider"))
  if VERTICAL then
    local len = IW * DIV_LEN
    return string.format('<rect x="%.1f" y="%.1f" width="%.1f" height="%d" %s/>',
      (IW - len) / 2, at, len, DIV_W, col)
  end
  local len = IH * DIV_LEN
  return string.format('<rect x="%.1f" y="%.1f" width="%d" height="%.1f" %s/>',
    at, (IH - len) / 2, DIV_W, len, col)
end

local function Divider(i)
  if not DIVIDERS then return "" end
  return DividerAt(i, i - 1) .. DividerAt(i, i)
end

local function IconSvg(i, cx, top, color, active)
  local icon = ITEMS[i].icon and MenuIcons[ITEMS[i].icon]
  if not icon then return "" end
  local s = ICON_SIZE / 960
  return string.format('<g transform="translate(%.1f,%.1f) scale(%.5f)"><path d="%s" %s/></g>',
    cx - ICON_SIZE / 2, top + ICON_SIZE, s, (active and FILL_ICON) and icon.f or icon.o, Fill(color))
end

local function TextSvg(text, cx, baseline, color, active)
  return string.format(
    '<text x="%.1f" y="%.1f" %s font-family="%s, Arial, sans-serif" font-size="%d" font-weight="%s" ' ..
    'text-anchor="middle">%s</text>',
    cx, baseline, Fill(color), FONT, FONT_SIZE, (active and BOLD) and "bold" or "normal", Escape(text))
end

-- Content (icon and/or text), centred in the item
local function Content(i, active)
  local color = active and Color("Active Text") or Color("Text")
  local cx, cy = IW / 2, IH / 2
  local label = CONTENT ~= "Icon" and ITEMS[i].label or ""
  -- 0.35 em below the centre puts the cap height in the middle
  if CONTENT == "Text" then
    return TextSvg(label, cx, cy + FONT_SIZE * 0.35, color, active)
  elseif CONTENT == "Icon" then
    return IconSvg(i, cx, cy - ICON_SIZE / 2, color, active)
  end
  if label == "" then return IconSvg(i, cx, cy - ICON_SIZE / 2, color, active) end
  local gap = math.floor(FONT_SIZE * 0.3)
  local top = cy - (ICON_SIZE + gap + FONT_SIZE) / 2
  return IconSvg(i, cx, top, color, active) ..
    TextSvg(label, cx, top + ICON_SIZE + gap + FONT_SIZE * 0.8, color, active)
end

-- Drawing ------------------------------------------------------------------------
local function Background(tl, tr, br, bl)
  local bx, by, bw, bh = ItemBox()
  return RoundRect(bx, by, bw, bh, tl, tr, br, bl, Fill(Color("Background")))
end

local function Render(i)
  local active = (i == current)
  local tl, tr, br, bl = Corners(i)
  local opacity = Controls.Lock.Boolean and ' opacity="0.45"' or ""
  local svg = string.format(
    '<svg xmlns="http://www.w3.org/2000/svg" width="%d" height="%d" viewBox="0 0 %d %d" ' ..
    'preserveAspectRatio="none"><g%s>%s%s%s%s</g></svg>',
    IW, IH, IW, IH, opacity,
    Background(tl, tr, br, bl),
    Indicator(i, pos - (i - 1) * PITCH),
    Divider(i),
    Content(i, active))
  Controls.Menu[i].Style = json.encode({
    IconData = Crypto.Base64Encode(svg), DrawChrome = false, Margin = 0, Padding = 0, StrokeWidth = 0, Legend = "",
  })
end

local function RenderAll()
  for i = 1, N do Render(i) end
end

-- Redraw only the items the indicator touched between a and b
local function RenderRange(a, b)
  local lo, hi = math.min(a, b) - 2, math.max(a, b) + SPAN + 2   -- +-2 px: neighbours' dividers
  for i = 1, N do
    local s = (i - 1) * PITCH
    if s < hi and s + SPAN > lo then Render(i) end
  end
end

local function Ease(t) return t < 0.5 and 2 * t * t or 1 - (-2 * t + 2) ^ 2 / 2 end

animTimer.EventHandler = function()
  local t = (Timer.Now() - anim.t0) / anim.dur
  local last = pos
  if t >= 1 then
    pos = anim.to
    animTimer:Stop()
  else
    pos = anim.from + (anim.to - anim.from) * Ease(t)
  end
  RenderRange(last, pos)
end

local function SlideTo(target)
  animTimer:Stop()
  if ANIM_MS <= 0 or IND_STYLE == "None" or target == pos then
    local last = pos
    pos = target
    RenderRange(last, pos)
    return
  end
  anim.from, anim.to, anim.t0, anim.dur = pos, target, Timer.Now(), ANIM_MS / 1000
  animTimer:Start(FRAME_S)
end

-- Navigation ---------------------------------------------------------------------
local function SplitList(s)
  local list = {}
  for item in s:gmatch("[^,;]+") do
    item = Trim(item)
    if item ~= "" then table.insert(list, item) end
  end
  return list
end

-- Uci.SetPage needs the Inventory name. A status block's code name often differs
-- (e.g. "UCI_Viewer_UCI_Viewer-1" for the Inventory name "UCI_Viewer_1"), so we try a few
-- variants once and remember the one that works.
local resolved = {}

local function Candidates(name)
  local list, seen = {}, {}
  local function add(c) if c ~= "" and not seen[c] then seen[c] = true; table.insert(list, c) end end
  local bases = { name }
  for _, prefix in ipairs({ "UCI_Viewer_", "TSC_Status_", "Touch_Screen_Status_", "TSC_" }) do
    if name:sub(1, #prefix) == prefix then table.insert(bases, name:sub(#prefix + 1)) end
  end
  for _, b in ipairs(bases) do
    add(b); add((b:gsub("%-", "_"))); add((b:gsub("_", "-")))
  end
  return list
end

local function SetPage(panel, page)
  if resolved[panel] then return pcall(Uci.SetPage, resolved[panel], page) end
  local lastErr
  for _, name in ipairs(Candidates(panel)) do
    local ok, err = pcall(Uci.SetPage, name, page)
    if ok then
      resolved[panel] = name
      if name ~= panel then Log(1, ('Panel "%s" found as "%s"'):format(panel, name)) end
      return true
    end
    lastErr = err
  end
  return false, lastErr
end

local function NavigatePage(i)
  local page = ITEMS[i].page
  if page == "" then return end
  local panels = SplitList(S("Panels"))
  if #panels == 0 then navError = "No panel set"; return end
  for _, panel in ipairs(panels) do
    local ok, err = SetPage(panel, page)
    if ok then
      Log(2, ('SetPage "%s" -> "%s"'):format(resolved[panel] or panel, page))
    else
      navError = ('Page "%s" on "%s": %s'):format(page, panel, tostring(err))
      Log(1, navError)
    end
  end
end

local function NavigateLayers(i)
  local uci = Trim(S("UCI Name"))
  if uci == "" then navError = "No UCI name set"; return end
  -- layers of the selected item stay visible even if other items list them too
  local keep = {}
  local selPage = ITEMS[i].page
  for _, layer in ipairs(SplitList(ITEMS[i].layers)) do keep[selPage .. "\0" .. layer] = true end

  local function Set(page, layer, visible)
    local ok, err = pcall(Uci.SetLayerVisibility, uci, page, layer, visible, TRANSITION)
    if not ok then
      navError = ('Layer "%s" on "%s": %s'):format(layer, page, tostring(err))
      Log(1, navError)
    else
      Log(2, ('Layer "%s" on "%s" %s'):format(layer, page, visible and "shown" or "hidden"))
    end
  end

  for n = 1, N do
    local page = ITEMS[n].page
    if n ~= i and page ~= "" then
      for _, layer in ipairs(SplitList(ITEMS[n].layers)) do
        if not keep[page .. "\0" .. layer] then Set(page, layer, false) end
      end
    end
  end
  if selPage ~= "" then
    for _, layer in ipairs(SplitList(ITEMS[i].layers)) do Set(selPage, layer, true) end
  elseif Trim(ITEMS[i].layers) ~= "" then
    navError = ("Menu %d: Layers need a Page"):format(i)
  end
end

local function Navigate(i)
  navError = nil
  -- both are optional: pages switch when Panels is set, layers when the item lists some
  if Trim(S("Panels")) ~= "" then NavigatePage(i) end
  local anyLayers = false
  for n = 1, N do if Trim(ITEMS[n].layers) ~= "" then anyLayers = true end end
  if anyLayers then NavigateLayers(i) end
end

local function UpdateStatus()
  if navError then
    SetStatus(1, navError)
  elseif Controls.Lock.Boolean then
    SetStatus(0, "Locked")
  else
    SetStatus(0, "Menu " .. current)
  end
end

local function SyncOutputs()
  for n = 1, N do
    Controls.Menu[n].Boolean = (n == current)
    Controls["Menu Active"][n].Boolean = (n == current)
  end
  Controls["Active Menu"].Value = current
end

local function Select(i, navigate)
  i = math.max(1, math.min(N, i))
  local old = current
  current = i
  SyncOutputs()
  if old ~= i then Render(old) end
  SlideTo((i - 1) * PITCH)
  Render(i)
  if navigate then Navigate(i) end
  UpdateStatus()
end

-- Event handlers -------------------------------------------------------------------
for n = 1, N do
  Controls.Menu[n].EventHandler = function()
    if Controls.Lock.Boolean then
      SyncOutputs()               -- undo the press while locked
      return
    end
    Select(n, true)
  end
end

Controls["Active Menu"].EventHandler = function(ctl)
  Select(math.floor(ctl.Value + 0.5), true)
end

Controls.Lock.EventHandler = function()
  RenderAll()
  UpdateStatus()
end

-- Every look setting is live: reload and redraw
local function Live()
  LoadConfig()
  clipCache = {}
  animTimer:Stop()
  pos = (current - 1) * PITCH
  RenderAll()
end
for name in pairs(DEFAULTS) do
  if Controls[name] then Controls[name].EventHandler = Live end
end

local iconChoices = { "(none)" }
for _, name in ipairs(MenuIconNames) do table.insert(iconChoices, name) end
for n = 1, N do
  Controls.Icon[n].Choices = iconChoices
  Controls.Icon[n].EventHandler = Live
  Controls.Label[n].EventHandler = Live
  Controls.Page[n].EventHandler = LoadConfig
  Controls.Layers[n].EventHandler = LoadConfig
end

-- Panel discovery (Page mode): touch panels / UCI viewers with Script Access
do
  local found = {}
  for _, comp in ipairs(Component.GetComponents()) do
    local t = tostring(comp.Type):lower()
    Log(2, ('Component "%s" type "%s"'):format(comp.Name, comp.Type))
    if t:find("uci") or t:find("touch") or t:find("tsc") or t:find("panel") then
      table.insert(found, comp.Name)
    end
  end
  table.sort(found)
  Controls["Add Panel"].Choices = found
  if #found > 0 then
    Log(1, #found .. " panel(s) found: " .. table.concat(found, ", "))
  else
    Log(1, "No panels found. Enable Script Access on the touch panel / UCI viewer status block, or type the Inventory name into Panels.")
  end

  Controls["Add Panel"].EventHandler = function(ctl)
    local name = Trim(ctl.String)
    if name == "" then return end
    local list = SplitList(S("Panels"))
    for _, p in ipairs(list) do if p == name then ctl.String = ""; return end end
    table.insert(list, name)
    Controls.Panels.String = table.concat(list, ", ")
    ctl.String = ""
  end
end

-- Start ----------------------------------------------------------------------------
SyncOutputs()
RenderAll()
UpdateStatus()
Log(1, ("Menu Bar started: %d items, %s"):format(N, VERTICAL and "vertical" or "horizontal"))
-- <<< runtime.lua
end
