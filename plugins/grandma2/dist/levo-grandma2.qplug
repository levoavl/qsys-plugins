LevoAssets = {
  wordmark_atlantic = { Width = 360, Height = 82,
    Data = "" },
  wordmark_porcelain = { Width = 360, Height = 81,
    Data = "" },
}
-- <<< levo_assets.lua

LevoBrand = {
  Company = "levo AVL",
  Author  = "levo AVL | Elias Jenny",
  Address = { "Printzstraße 4", "76139 Karlsruhe", "Germany" },
  Web     = "www.levo.de",
  Mail    = "hello@levo.de",
  Repo    = "github.com/levoavl/qsys-plugins",
  License = "MIT License",

  -- levo AVL colour system (RGB for digital use)
  Colors = {
    Atlantic  = { 0, 70, 140 },     -- primary
    Amber     = { 255, 184, 48 },   -- accent, highlights, call-to-action
    Porcelain = { 245, 245, 243 },  -- light background
    Onyx      = { 25, 25, 25 },     -- text, contrast
    Mid       = { 120, 120, 120 },  -- secondary text (derived)
    AmberSoft = { 255, 219, 150 },  -- amber at reduced intensity, e.g. fading states (derived)
    Line      = { 214, 214, 210 },  -- hairlines, frames (derived from Porcelain)
    Haze      = { 172, 196, 222 },  -- secondary text on Atlantic (derived)
  },

  HeaderHeight = 40,
}

local C = LevoBrand.Colors

local function Image(asset, x, y, w)
  local h = math.floor(w * asset.Height / asset.Width + 0.5)
  return { Type = "Image", Image = asset.Data, Position = { x, y }, Size = { w, h } }, h
end

local function Text(text, x, y, w, h, size, color, style, align)
  return {
    Type = "Text", Text = text,
    Position = { x, y }, Size = { w, h },
    FontSize = size, FontStyle = style or "Regular",
    HTextAlign = align or "Left",
    Color = color or C.Onyx,
  }
end

-- Page background in Porcelain. Call first so everything else draws on top.
function LevoBrand.Background(graphics, width, height)
  table.insert(graphics, {
    Type = "GroupBox", Fill = C.Porcelain, StrokeWidth = 0, CornerRadius = 0,
    Position = { 0, 0 }, Size = { width, height },
  })
end

-- Atlantic header bar: small porcelain wordmark on the left, plugin name (bold)
-- and the current page on the right. Returns the y coordinate where page content
-- can start. `title` = plugin name, `subtitle` = page name (both optional).
function LevoBrand.Header(graphics, width, title, subtitle)
  local h = LevoBrand.HeaderHeight
  table.insert(graphics, {
    Type = "GroupBox", Fill = C.Atlantic, StrokeWidth = 0, CornerRadius = 0,
    Position = { 0, 0 }, Size = { width, h },
  })
  local logo, logoH = Image(LevoAssets.wordmark_porcelain, 12, 0, 68)
  logo.Position[2] = math.floor((h - logoH) / 2)
  table.insert(graphics, logo)
  if title and subtitle then
    table.insert(graphics, Text(title, 96, 4, width - 108, 18, 14, C.Porcelain, "Bold", "Right"))
    table.insert(graphics, Text(subtitle, 96, 21, width - 108, 14, 10, C.Haze, "Regular", "Right"))
  elseif title then
    table.insert(graphics, Text(title, 96, 0, width - 108, h, 14, C.Porcelain, "Bold", "Right"))
  end
  -- thin amber accent line under the header
  table.insert(graphics, {
    Type = "GroupBox", Fill = C.Amber, StrokeWidth = 0, CornerRadius = 0,
    Position = { 0, h }, Size = { width, 2 },
  })
  return h + 2
end

-- Plugin name without the "levo AVL~" library folder
function LevoBrand.PluginName(info)
  return (info.Name:gsub("^.-~", ""))
end

-- Content of the "About" page. `info` is the plugin's PluginInfo table.
function LevoBrand.About(graphics, x, y, width, info)
  local line = 18
  local logo, logoH = Image(LevoAssets.wordmark_atlantic, x, y, 160)
  table.insert(graphics, logo)
  y = y + logoH + 16

  local name = info.Name:gsub("^.-~", "")  -- strip the "levo AVL~" library folder
  table.insert(graphics, Text(name, x, y, width, 22, 16, C.Atlantic, "Bold"))
  y = y + 24
  table.insert(graphics, Text("Version " .. (info.BuildVersion or info.Version), x, y, width, line, 11, C.Mid))
  y = y + line + 12

  local rows = {
    LevoBrand.Company,
    LevoBrand.Address[1],
    LevoBrand.Address[2] .. ", " .. LevoBrand.Address[3],
    LevoBrand.Web .. "  ·  " .. LevoBrand.Mail,
  }
  for _, r in ipairs(rows) do
    table.insert(graphics, Text(r, x, y, width, line, 12, C.Onyx))
    y = y + line
  end
  y = y + 12

  table.insert(graphics, Text("Author: " .. LevoBrand.Author, x, y, width, line, 11, C.Onyx))
  y = y + line
  table.insert(graphics, Text("Source & updates: " .. LevoBrand.Repo, x, y, width, line, 11, C.Onyx))
  y = y + line
  table.insert(graphics, Text("Licensed under the " .. LevoBrand.License .. ". Provided as is, without warranty.",
    x, y, width, line, 11, C.Mid))
  y = y + line + 12

  table.insert(graphics, Text(
    "Not affiliated with or endorsed by QSC, LLC or the manufacturer of the controlled device. "
      .. "All trademarks belong to their respective owners.",
    x, y, width, line * 2, 10, C.Mid))
  return y + line * 2
end
-- <<< levo_brand.lua

-- Slot counts from the properties (also used at runtime via `Properties`)
function SlotCounts(props)
  local function n(name)
    local p = props[name]
    return math.max(0, math.floor(tonumber(p and p.Value) or 0))
  end
  return {
    Faders = n("Fader Count"),
    Buttons = n("Button Count"),
    Macros = n("Macro Count"),
    Commands = n("Command Count"),
  }
end

-- Pages without slots are hidden
function PageList(props)
  local c = SlotCounts(props)
  local pages = {}
  if c.Faders > 0 then pages[#pages + 1] = "Faders" end
  if c.Buttons > 0 then pages[#pages + 1] = "Buttons" end
  if c.Macros > 0 then pages[#pages + 1] = "Macros" end
  if c.Commands > 0 then pages[#pages + 1] = "Commands" end
  pages[#pages + 1] = "Setup"
  pages[#pages + 1] = "About"
  return pages
end

function GetColor(props)
  return LevoBrand.Colors.Atlantic
end

function GetPrettyName(props)
  return PluginInfo.Name:gsub("^.-~", "") .. "\n" .. PluginInfo.BuildVersion
end

function GetPages(props)
  local pages = {}
  for _, name in ipairs(PageList(props)) do
    table.insert(pages, { name = name })
  end
  return pages
end

function GetProperties()
  local props = {}
  -- >>> properties.lua
-- (c) levo AVL | Elias Jenny - MIT License
table.insert(props, { Name = "Fader Count",   Type = "integer", Min = 0, Max = 64,  Value = 8 })
table.insert(props, { Name = "Button Count",  Type = "integer", Min = 0, Max = 128, Value = 16 })
table.insert(props, { Name = "Macro Count",   Type = "integer", Min = 0, Max = 64,  Value = 8 })
table.insert(props, { Name = "Command Count", Type = "integer", Min = 0, Max = 32,  Value = 4 })
table.insert(props, { Name = "Poll Interval (ms)", Type = "integer", Min = 100, Max = 2000, Value = 250 })
table.insert(props, {
  Name = "Debug Print",
  Type = "enum",
  Choices = { "None", "Basic", "Verbose" },
  Value = "None",
})
-- <<< properties.lua
  return props
end

function RectifyProperties(props)
  -- >>> rectify.lua
-- (c) levo AVL | Elias Jenny - MIT License
if props.plugin_show_debug.Value == false then
  props["Debug Print"].IsHidden = true
end
-- <<< rectify.lua
  return props
end

function GetPins(props)
  local pins = {}
  return pins
end

function GetControls(props)
  local ctrls = {}
  -- >>> controls.lua
-- (c) levo AVL | Elias Jenny - MIT License
local counts = SlotCounts(props)

local function Add(def)
  def.Count = def.Count or 1
  if def.UserPin == nil then def.UserPin = true end
  table.insert(ctrls, def)
end
local function TextOut(name) Add({ Name = name, ControlType = "Indicator", IndicatorType = "Text", PinStyle = "Output" }) end
local function Led(name)     Add({ Name = name, ControlType = "Indicator", IndicatorType = "Led", PinStyle = "Output" }) end
local function Percent(name, pinStyle)
  Add({ Name = name, ControlType = "Knob", ControlUnit = "Percent", Min = 0, Max = 100, PinStyle = pinStyle })
end
local function Int(name, max)
  -- 0 = not set yet, the runtime fills in a default on start
  Add({ Name = name, ControlType = "Knob", ControlUnit = "Integer", Min = 0, Max = max, PinStyle = "Both" })
end
local function Momentary(name) Add({ Name = name, ControlType = "Button", ButtonType = "Momentary", PinStyle = "Both" }) end
local function Trigger(name)   Add({ Name = name, ControlType = "Button", ButtonType = "Trigger", PinStyle = "Input" }) end
local function TextIn(name, pinStyle) Add({ Name = name, ControlType = "Text", PinStyle = pinStyle or "Both" }) end

-- Connection / global
TextIn("IP Address")
Int("Port", 65535)
TextIn("Username")
TextIn("Password", "Input")
Trigger("Reconnect")
Add({ Name = "Status", ControlType = "Indicator", IndicatorType = "Status", PinStyle = "Output" })
Led("Connected")
Led("Logged In")
TextIn("Command TX", "Input")
TextOut("Session")
TextOut("Last Error")
TextOut("Reconnects")

-- Fader executors
for i = 1, counts.Faders do
  local p = "Fader " .. i .. " "
  Percent(p .. "Level", "Both")
  for b = 1, 3 do
    Momentary(p .. "Button " .. b)
    TextOut(p .. "Button " .. b .. " Label")
  end
  TextOut(p .. "Name")
  TextOut(p .. "Cue")
  TextOut(p .. "Function")
  Led(p .. "Active")
  Led(p .. "Fading")
  TextOut(p .. "State")
  Percent(p .. "Progress", "Output")
  TextIn(p .. "Exec")  -- "page.exec" as in MA, e.g. "1.101"
end

-- Button executors
for i = 1, counts.Buttons do
  local p = "Button " .. i .. " "
  Momentary(p .. "Press")
  TextOut(p .. "Name")
  TextOut(p .. "Cue")
  TextOut(p .. "Function")
  Led(p .. "Active")
  Led(p .. "Fading")
  TextOut(p .. "State")
  Percent(p .. "Progress", "Output")
  TextIn(p .. "Exec")  -- "page.exec" as in MA, e.g. "1.101"
end

-- Macros
for i = 1, counts.Macros do
  Trigger("Macro " .. i .. " Trigger")
  Int("Macro " .. i .. " Number", 9999)
end

-- Free commands
for i = 1, counts.Commands do
  TextIn("Command " .. i .. " Text")
  Trigger("Command " .. i .. " Send")
end
-- <<< controls.lua
  return ctrls
end

function GetControlLayout(props)
  local layout, graphics = {}, {}
  local CurrentPage = PageList(props)[props["page_index"].Value] or "Setup"
  -- >>> layout.lua
-- (c) levo AVL | Elias Jenny - MIT License
local C = LevoBrand.Colors
local counts = SlotCounts(props)
local M = 16  -- page margin

local function Label(text, x, y, w, h, opts)
  opts = opts or {}
  table.insert(graphics, {
    Type = "Text", Text = text, Position = { x, y }, Size = { w, h or 18 },
    FontSize = opts.size or 11, FontStyle = opts.style or "Regular",
    HTextAlign = opts.align or "Left", Color = opts.color or C.Onyx,
  })
end

local function Section(text, x, y, w)
  Label(text, x, y, w, 20, { size = 13, style = "Bold", color = C.Atlantic })
  table.insert(graphics, {
    Type = "GroupBox", Fill = C.Amber, StrokeWidth = 0, CornerRadius = 0,
    Position = { x, y + 20 }, Size = { w, 2 },
  })
  return y + 28
end

local function Place(name, pretty, x, y, w, h, extra)
  local def = { PrettyName = pretty, Position = { x, y }, Size = { w, h } }
  for k, v in pairs(extra or {}) do def[k] = v end
  layout[name] = def
end

-- Page size depends on the slot counts; background and header are added at the
-- end (prepended to `graphics`) once W and H are known.
local W, H = 640, 400
local y = LevoBrand.HeaderHeight + 2 + 10

-- Executor strips: columns separated by hairlines, like the executor bar in MA.
-- The state lives in one place only - the colour of the main button.
local function Hairline(x, y1, w, h)
  table.insert(graphics, {
    Type = "GroupBox", Fill = C.Line, StrokeWidth = 0, CornerRadius = 0,
    Position = { x, y1 }, Size = { w, h },
  })
end

local function SlotHead(p, g, i, x, cy, cw)
  Label(tostring(i), x + 6, cy + 6, 24, 18, { size = 10, color = C.Mid })
  Place(p .. "Exec", g .. "Exec", x + cw - 54, cy + 6, 48, 18, { Style = "Text", FontSize = 10 })
end

-- read-only text that should look like a label, not like a field
local FLAT = { Style = "Text", Color = C.Porcelain, StrokeWidth = 0, CornerRadius = 0 }
local function Flat(extra)
  local t = {}
  for k, v in pairs(FLAT) do t[k] = v end
  for k, v in pairs(extra) do t[k] = v end
  return t
end

local function NameCue(p, g, x, yy, cw)
  Place(p .. "Name", g .. "Name", x + 4, yy, cw - 8, 18, Flat({ FontSize = 12, FontStyle = "Bold", TextColor = C.Onyx }))
  Place(p .. "Cue", g .. "Cue", x + 4, yy + 18, cw - 8, 15, Flat({ FontSize = 10, TextColor = C.Mid }))
  -- fade progress sits directly under the cue, as in MA
  Place(p .. "Progress", g .. "Progress", x + 6, yy + 34, cw - 12, 6, { Style = "Fader", IsReadOnly = true, Color = C.Amber })
  return yy + 46
end

if CurrentPage == "Faders" then
  local cols, cw = 8, 92
  local cellH = 344
  for i = 1, counts.Faders do
    local col, row = (i - 1) % cols, (i - 1) // cols
    local x, cy = M + col * cw, y + row * (cellH + 12)
    local p, g = "Fader " .. i .. " ", "Faders~Fader " .. i .. "~"
    if col > 0 then Hairline(x, cy + 4, 1, cellH - 8) end
    SlotHead(p, g, i, x, cy, cw)
    local yy = NameCue(p, g, x, cy + 30, cw)
    for _, b in ipairs({ 3, 2 }) do
      Place(p .. "Button " .. b, g .. "Button " .. b, x + 6, yy, cw - 12, 24,
        { Style = "Button", Legend = "", FontSize = 10, Color = C.Line }); yy = yy + 28
    end
    Place(p .. "Level", g .. "Level", x + (cw - 32) // 2, yy + 2, 32, 150, { Style = "Fader", Color = C.Atlantic }); yy = yy + 158
    -- main button below the fader, coloured by the executor state at runtime
    Place(p .. "Button 1", g .. "Button 1", x + 6, yy, cw - 12, 34,
      { Style = "Button", Legend = "", FontSize = 11, FontStyle = "Bold", Color = C.Amber }); yy = yy + 38
    Place(p .. "Function", g .. "Function", x + 4, yy, cw - 8, 14, Flat({ FontSize = 9, TextColor = C.Mid }))
  end
  local rows = math.max(1, math.ceil(counts.Faders / cols))
  W = math.max(W, M * 2 + math.min(counts.Faders, cols) * cw)
  H = y + rows * (cellH + 12) + M

elseif CurrentPage == "Buttons" then
  local cols, cw = 6, 112
  local cellH = 136
  for i = 1, counts.Buttons do
    local col, row = (i - 1) % cols, (i - 1) // cols
    local x, cy = M + col * cw, y + row * cellH
    local p, g = "Button " .. i .. " ", "Buttons~Button " .. i .. "~"
    if col > 0 then Hairline(x, cy + 4, 1, cellH - 8) end
    if row > 0 then Hairline(x + 4, cy, cw - 8, 1) end
    SlotHead(p, g, i, x, cy, cw)
    Place(p .. "Press", g .. "Press", x + 6, cy + 30, cw - 12, 48,
      { Style = "Button", Legend = "", FontSize = 11, Color = C.Amber })
    NameCue(p, g, x, cy + 82, cw)
  end
  local rows = math.max(1, math.ceil(counts.Buttons / cols))
  W = math.max(W, M * 2 + math.min(counts.Buttons, cols) * cw)
  H = y + rows * cellH + M

elseif CurrentPage == "Macros" then
  local cols, cw, gap = 4, 150, 12
  for i = 1, counts.Macros do
    local col, row = (i - 1) % cols, (i - 1) // cols
    local x, ry = M + col * (cw + gap), y + row * 28
    Label("Macro " .. i, x, ry + 2, 50, 18)
    Place("Macro " .. i .. " Trigger", "Macros~Macro " .. i .. "~Trigger", x + 50, ry, 50, 22, { Style = "Button", Legend = "Go", Color = C.Amber })
    Place("Macro " .. i .. " Number", "Macros~Macro " .. i .. "~Number", x + 104, ry + 1, 44, 20, { Style = "Text" })
  end
  Label("Number = MA macro pool number. Sends \"Go Macro <n>\" - no running feedback from the console.",
    M, y + math.ceil(counts.Macros / cols) * 28 + 4, 600, 18, { size = 10, color = C.Mid })
  H = y + math.ceil(counts.Macros / cols) * 28 + 40

elseif CurrentPage == "Commands" then
  for i = 1, counts.Commands do
    local ry = y + (i - 1) * 28
    Label(tostring(i), M, ry + 2, 24, 18, { align = "Right" })
    Place("Command " .. i .. " Text", "Commands~Command " .. i .. "~Text", M + 32, ry, 480, 22, { Style = "Text" })
    Place("Command " .. i .. " Send", "Commands~Command " .. i .. "~Send", M + 520, ry, 70, 22, { Style = "Button", Legend = "Send", Color = C.Amber })
  end
  H = y + counts.Commands * 28 + M

elseif CurrentPage == "Setup" then
  local lw, fx = 110, M + 118
  y = Section("Connection", M, y, 608)
  local function Row(label, name, pretty, w, extra)
    Label(label, M, y + 1, lw, 20, { align = "Right" })
    Place(name, pretty, fx, y, w, 22, extra)
    y = y + 28
  end
  Row("IP Address", "IP Address", "Setup~IP Address", 160, { Style = "Text" })
  Row("Port", "Port", "Setup~Port", 70, { Style = "Text" })
  Row("Username", "Username", "Setup~Username", 160, { Style = "Text" })
  Row("Password", "Password", "Setup~Password", 160, { Style = "Text" })
  Label("Status", M, y + 1, lw, 20, { align = "Right" })
  Place("Status", "Status", fx, y, 300, 22)
  Place("Reconnect", "Setup~Reconnect", fx + 310, y, 90, 22, { Style = "Button", Legend = "Reconnect", Color = C.Amber })
  y = y + 28
  Label("Connected", M, y, lw, 18, { align = "Right" })
  Place("Connected", "Connected", fx, y + 1, 16, 16, { Color = C.Amber })
  Label("Logged In", fx + 30, y, 70, 18, { align = "Right" })
  Place("Logged In", "Logged In", fx + 106, y + 1, 16, 16, { Color = C.Amber })
  y = y + 26
  Row("Command TX", "Command TX", "Setup~Command TX", 300, { Style = "Text" })
  Label("Executors are assigned in each slot (field top right): page.exec as in MA, e.g. 1.101.",
    M, y, 608, 18, { size = 10, color = C.Mid })
  y = y + 18
  Label("Web remote must be enabled: Setup > Console > Global Settings > Remotes = Login Enabled.",
    M, y, 608, 18, { size = 10, color = C.Mid })
  y = y + 26

  y = Section("Debug", M, y, 608)
  Row("Session", "Session", "Debug~Session", 120, { Style = "Text" })
  Row("Reconnects", "Reconnects", "Debug~Reconnects", 120, { Style = "Text" })
  Row("Last Error", "Last Error", "Debug~Last Error", 480, { Style = "Text" })
  y = y + 6

  H = y + M

elseif CurrentPage == "About" then
  y = y + 4
  local endY = LevoBrand.About(graphics, M, y, W - 2 * M, PluginInfo)
  Label("WebSocket / web remote handling based on \"MA2 Remote\" by Locimation Pty Ltd (MIT License).",
    M, endY + 8, W - 2 * M, 18, { size = 10, color = C.Mid })
  H = endY + 40
end

-- Background and header go below everything else: prepend them.
local front = {}
LevoBrand.Background(front, W, H)
LevoBrand.Header(front, W, LevoBrand.PluginName(PluginInfo), CurrentPage)
for i = #front, 1, -1 do table.insert(graphics, 1, front[i]) end
-- <<< layout.lua
  return layout, graphics
end

if Controls then
  -- >>> levo_websocket.lua
-- (c) levo AVL | Elias Jenny - MIT License
--
-- Minimal WebSocket client (RFC 6455) on top of the Q-SYS TcpSocket.
-- Text frames only, client-to-server frames are masked, fragmented messages and
-- frames split across TCP packets are reassembled. Ping is answered with pong.
--
-- Usage:
--   local ws = LevoWebSocket.New({
--     OnOpen    = function() end,
--     OnMessage = function(text) end,
--     OnClose   = function(reason) end,   -- socket closed, error or timeout
--     Log       = function(level, msg) end, -- optional, level 1 basic / 2 verbose
--   })
--   ws:Connect("192.168.1.10", 80, "/?ma=1")
--   ws:Send('{"session":0}')
--   ws:Close()
--
-- Reconnecting is left to the caller (OnClose), so it can apply its own backoff.

LevoWebSocket = {}

local OP_CONT, OP_TEXT, OP_BIN, OP_CLOSE, OP_PING, OP_PONG = 0x0, 0x1, 0x2, 0x8, 0x9, 0xA
LevoWebSocket.Opcodes = { Cont = OP_CONT, Text = OP_TEXT, Binary = OP_BIN, Close = OP_CLOSE, Ping = OP_PING, Pong = OP_PONG }

local function RandomBytes(n)
  local t = {}
  for i = 1, n do t[i] = string.char(math.random(0, 255)) end
  return table.concat(t)
end

-- Big-endian unsigned integer of `n` bytes as string
local function UInt(value, n)
  local t = {}
  for i = n, 1, -1 do
    t[i] = string.char(value % 256)
    value = value // 256
  end
  return table.concat(t)
end

-- Encode one (final) frame. `maskKey` is a 4-byte string, nil = unmasked.
function LevoWebSocket.EncodeFrame(opcode, payload, maskKey)
  payload = payload or ""
  local len = #payload
  local maskBit = maskKey and 0x80 or 0
  local head = string.char(0x80 | opcode)
  if len <= 125 then
    head = head .. string.char(maskBit | len)
  elseif len <= 0xFFFF then
    head = head .. string.char(maskBit | 126) .. UInt(len, 2)
  else
    head = head .. string.char(maskBit | 127) .. UInt(len, 8)
  end
  if not maskKey then return head .. payload end
  local k = { maskKey:byte(1, 4) }
  local out, chunk = {}, {}
  for i = 1, len do
    chunk[#chunk + 1] = string.char(payload:byte(i) ~ k[(i - 1) % 4 + 1])
    if #chunk == 4096 then out[#out + 1] = table.concat(chunk); chunk = {} end
  end
  out[#out + 1] = table.concat(chunk)
  return head .. maskKey .. table.concat(out)
end

-- Parse as many complete frames as possible from `buf`.
-- Returns a list of { fin, opcode, payload } and the unconsumed remainder.
function LevoWebSocket.ParseFrames(buf)
  local frames, pos, size = {}, 1, #buf
  while true do
    if size - pos + 1 < 2 then break end
    local b1, b2 = buf:byte(pos, pos + 1)
    local fin = (b1 & 0x80) ~= 0
    local opcode = b1 & 0x0F
    local masked = (b2 & 0x80) ~= 0
    local len = b2 & 0x7F
    local hdr = 2
    if len == 126 then
      if size - pos + 1 < 4 then break end
      local x1, x2 = buf:byte(pos + 2, pos + 3)
      len = x1 * 256 + x2
      hdr = 4
    elseif len == 127 then
      if size - pos + 1 < 10 then break end
      len = 0
      for i = 2, 9 do len = len * 256 + buf:byte(pos + i) end
      hdr = 10
    end
    local maskKey
    if masked then
      if size - pos + 1 < hdr + 4 then break end
      maskKey = { buf:byte(pos + hdr, pos + hdr + 3) }
      hdr = hdr + 4
    end
    if size - pos + 1 < hdr + len then break end
    local payload = buf:sub(pos + hdr, pos + hdr + len - 1)
    if maskKey then
      local t = {}
      for i = 1, #payload do t[i] = string.char(payload:byte(i) ~ maskKey[(i - 1) % 4 + 1]) end
      payload = table.concat(t)
    end
    frames[#frames + 1] = { fin = fin, opcode = opcode, payload = payload }
    pos = pos + hdr + len
  end
  return frames, buf:sub(pos)
end

function LevoWebSocket.New(handlers)
  local self = {
    handlers = handlers or {},
    sock = nil,
    state = "closed",   -- closed | connecting | handshake | open
    buffer = "",
    fragments = nil,
    host = nil,
  }

  local function Log(level, msg)
    if self.handlers.Log then self.handlers.Log(level, msg) end
  end

  local function Fire(name, ...)
    local fn = self.handlers[name]
    if fn then
      local ok, err = pcall(fn, ...)
      if not ok then Log(1, "WebSocket " .. name .. " handler error: " .. tostring(err)) end
    end
  end

  local function Shutdown(reason)
    if self.state == "closed" then return end
    self.state = "closed"
    self.buffer, self.fragments = "", nil
    if self.sock then
      local s = self.sock
      self.sock = nil  -- the event handler ignores events from sockets other than self.sock
      pcall(function() s:Disconnect() end)
    end
    Fire("OnClose", reason)
  end

  local function WriteFrame(opcode, payload)
    if not self.sock or self.state ~= "open" then return false end
    self.sock:Write(LevoWebSocket.EncodeFrame(opcode, payload, RandomBytes(4)))
    return true
  end

  local function HandleFrames()
    local frames
    frames, self.buffer = LevoWebSocket.ParseFrames(self.buffer)
    for _, f in ipairs(frames) do
      if f.opcode == OP_PING then
        WriteFrame(OP_PONG, f.payload)
      elseif f.opcode == OP_PONG then
        -- ignore
      elseif f.opcode == OP_CLOSE then
        Log(1, "WebSocket closed by server")
        Shutdown("closed by server")
        return
      elseif f.opcode == OP_TEXT or f.opcode == OP_BIN then
        if f.fin then
          Fire("OnMessage", f.payload)
        else
          self.fragments = { f.payload }
        end
      elseif f.opcode == OP_CONT and self.fragments then
        self.fragments[#self.fragments + 1] = f.payload
        if f.fin then
          local msg = table.concat(self.fragments)
          self.fragments = nil
          Fire("OnMessage", msg)
        end
      end
      if self.state ~= "open" then return end
    end
  end

  local function OnData(sock)
    local n = sock.BufferLength
    if n and n > 0 then
      self.buffer = self.buffer .. (sock:Read(n) or "")
    end
    if self.state == "handshake" then
      local hEnd = self.buffer:find("\r\n\r\n", 1, true)
      if not hEnd then
        if #self.buffer > 16384 then Shutdown("invalid handshake response") end
        return
      end
      local header = self.buffer:sub(1, hEnd - 1)
      self.buffer = self.buffer:sub(hEnd + 4)
      local code = header:match("^HTTP/%d%.%d (%d+)")
      if code ~= "101" then
        Log(1, "WebSocket handshake failed: " .. (header:match("^[^\r\n]*") or "?"))
        Shutdown("handshake failed (HTTP " .. tostring(code) .. ")")
        return
      end
      self.state = "open"
      Log(2, "WebSocket open")
      Fire("OnOpen")
      if self.state ~= "open" then return end
    end
    if self.state == "open" then HandleFrames() end
  end

  function self:Connect(host, port, path)
    Shutdown(nil)  -- silently drop a previous connection (no OnClose when already closed)
    self.host, self.state, self.buffer = host, "connecting", ""
    local sock = TcpSocket.New()
    sock.ReadTimeout = 0
    sock.WriteTimeout = 0
    sock.ReconnectTimeout = 0  -- reconnect is handled by the caller
    self.sock = sock
    sock.EventHandler = function(s, evt, err)
      if self.sock ~= s then return end  -- stale socket
      if evt == TcpSocket.Events.Connected then
        self.state = "handshake"
        Log(2, "TCP connected, sending WebSocket upgrade")
        s:Write(table.concat({
          "GET " .. (path or "/") .. " HTTP/1.1",
          "Host: " .. host .. ":" .. tostring(port),
          "Connection: Upgrade",
          "Upgrade: websocket",
          "Sec-WebSocket-Version: 13",
          "Sec-WebSocket-Key: " .. Crypto.Base64Encode(RandomBytes(16)),
          "", "",
        }, "\r\n"))
      elseif evt == TcpSocket.Events.Data then
        OnData(s)
      elseif evt == TcpSocket.Events.Closed then
        Shutdown("connection closed")
      elseif evt == TcpSocket.Events.Error then
        Shutdown("socket error: " .. tostring(err))
      elseif evt == TcpSocket.Events.Timeout then
        Shutdown("socket timeout")
      end
    end
    Log(2, ("TCP connecting to %s:%d"):format(host, port))
    sock:Connect(host, port)
  end

  function self:Send(text)
    return WriteFrame(OP_TEXT, text)
  end

  function self:IsOpen()
    return self.state == "open"
  end

  -- Close without firing OnClose (deliberate disconnect by the caller)
  function self:Close()
    if self.state == "open" then pcall(WriteFrame, OP_CLOSE, "") end
    local h = self.handlers.OnClose
    self.handlers.OnClose = nil
    Shutdown("closed by client")
    self.handlers.OnClose = h
  end

  return self
end
-- <<< levo_websocket.lua
  -- >>> ma2_state.lua
-- (c) levo AVL | Elias Jenny - MIT License
--
-- grandMA2 web remote: parsing of "playbacks" responses and derivation of the
-- executor state (Off / Fading In / On / Fading Out). Pure Lua, no Q-SYS APIs,
-- so it can be unit tested outside the Core.
--
-- Field meanings were taken from logs of grandMA2 onPC 3.9.60.91:
--   iExec        0-based executor index (exec 101 = 100)
--   combinedItems executor width
--   isRun        1 while the executor runs, including a running fade-out
--   tt.t         executor / sequence label
--   oI.t         sequence pool number ("" = empty executor)
--   cues.items[] cue text ("    1 Szene 1") and pgs.v = fade progress 0..1
--   executorBlocks[k]  fader executors: button1..3 {t = label}, fader {v, tt = function}
--   bottomButtons.items[1]  button executors: n.t = function ("Toggle", "Go"), fader.v = master

MA2State = {}

local function Trim(s)
  return (tostring(s or ""):gsub("^%s+", ""):gsub("%s+$", ""))
end
MA2State.Trim = Trim

local function Field(t, ...)
  for _, k in ipairs({ ... }) do
    if type(t) ~= "table" then return nil end
    t = t[k]
  end
  return t
end

local function Num(v)
  return type(v) == "number" and v or nil
end

-- Returns a list of entries, one per executor (combined executors yield one
-- entry per covered executor number):
--   { page, exec (1-based, as shown in MA), empty, name, cue, running,
--     progress (0..1 or nil), func, level (0..1 or nil), labels = {b1, b2, b3} }
function MA2State.ParsePlaybacks(data)
  local out = {}
  if type(data) ~= "table" or data.responseType ~= "playbacks" then return out end
  local page = Num(data.iPage) or 1
  for _, group in ipairs(data.itemGroups or {}) do
    for _, row in ipairs(group.items or {}) do
      for _, item in ipairs(row) do
        local base = Num(item.iExec)
        if base then
          local width = math.max(1, Num(item.combinedItems) or 1)
          local name = Trim(Field(item, "tt", "t"))
          local pool = Trim(Field(item, "oI", "t"))
          local running = (Num(item.isRun) or 0) ~= 0

          -- current cue: the one with a progress value, otherwise the first one
          local cueText, progress = "", nil
          local cues = Field(item, "cues", "items")
          if type(cues) == "table" then
            for i, cue in ipairs(cues) do
              local v = Num(Field(cue, "pgs", "v"))
              if i == 1 then cueText = Trim(cue.t) end
              if v then cueText, progress = Trim(cue.t), v; break end
            end
          end

          local bottom = Field(item, "bottomButtons", "items", 1)
          for k = 1, width do
            local block = Field(item, "executorBlocks", k)
            local e = {
              page = page,
              exec = base + k,
              empty = (pool == "" and name == ""),
              name = name,
              cue = cueText,
              running = running,
              progress = progress,
              labels = {},
            }
            if type(block) == "table" then
              e.func = Trim(Field(block, "fader", "tt"))
              e.level = Num(Field(block, "fader", "v"))
              for b = 1, 3 do
                local t = Trim(Field(block, "button" .. b, "t"))
                e.labels[b] = (t == "Empty") and "" or t
              end
            elseif type(bottom) == "table" then
              e.func = Trim(Field(bottom, "n", "t"))
              e.level = Num(Field(bottom, "fader", "v"))
            end
            e.func = e.func or ""
            if e.empty then e.func, e.labels = "", { "", "", "" } end
            out[#out + 1] = e
          end
        end
      end
    end
  end
  return out
end

MA2State.States = { Empty = "Empty", Off = "Off", FadingIn = "Fading In", On = "On", FadingOut = "Fading Out", Offline = "Offline" }
local S = MA2State.States

local EPS = 0.002

-- Tracker keeps the previous sample per executor to tell fade-in from fade-out
-- and holds optimistic states after a user action until the console agrees.
function MA2State.NewTracker()
  local tracker = { last = {}, optimistic = {} }

  -- `key` identifies the executor ("page.exec"), `now` is a time in seconds.
  -- Returns { state, active, fading, progress (0..1) }
  function tracker:Update(key, e, now)
    local prev = self.last[key]
    local st
    if e.empty then
      st = S.Empty
    elseif not e.running then
      st = S.Off
    elseif e.progress == nil then
      st = S.On
    else
      local p = e.progress
      if prev and prev.progress and prev.cue == e.cue and prev.running then
        if p < prev.progress - EPS then
          st = S.FadingOut
        elseif p > prev.progress + EPS then
          st = S.FadingIn
        elseif p >= 1 - EPS then
          st = S.On
        else
          -- progress not moving (slow or paused fade): keep the direction
          st = (prev.state == S.FadingOut or prev.state == S.FadingIn) and prev.state or S.On
        end
      elseif prev and prev.running and prev.cue ~= e.cue then
        st = (p >= 1 - EPS) and S.On or S.FadingIn  -- next cue started
      else
        st = (p >= 1 - EPS) and S.On or S.FadingIn  -- first sample
      end
    end
    self.last[key] = { progress = e.progress, cue = e.cue, running = e.running, state = st }

    local active = (st == S.On or st == S.FadingIn)
    local result = {
      state = st,
      active = active,
      fading = (st == S.FadingIn or st == S.FadingOut),
      progress = (st == S.FadingIn or st == S.FadingOut) and (e.progress or 0) or (active and 1 or 0),
    }

    local opt = self.optimistic[key]
    if opt then
      if now >= opt.untilTime or opt.active == active then
        self.optimistic[key] = nil  -- console agrees or hold time is over
      else
        result.state = opt.state
        result.active = opt.active
        result.fading = (opt.state == S.FadingIn or opt.state == S.FadingOut)
      end
    end
    return result
  end

  -- Assume the result of a user action until the console confirms it.
  function tracker:SetOptimistic(key, active, now, hold)
    self.optimistic[key] = {
      active = active,
      state = active and S.FadingIn or S.FadingOut,
      untilTime = now + (hold or 1.5),
    }
  end

  function tracker:Reset()
    self.last, self.optimistic = {}, {}
  end

  return tracker
end

-- Which state a button press probably leads to, from the MA button function.
-- Returns true (on), false (off) or nil (unknown / momentary, no assumption).
function MA2State.PredictPress(func, currentlyActive)
  local f = Trim(func):lower()
  if f == "off" then return false end
  if f == "on" or f == "go" or f == "go+" then return true end
  if f == "toggle" then return not currentlyActive end
  return nil
end

-- Group executor numbers into poll requests. `slots` is a list of {page, exec}
-- (1-based, as in MA). Returns a list of requests
--   { page, itemsType (2 fader / 3 button), startIndex (0-based), itemsCount }
-- The web remote answers in blocks of 5 executors.
function MA2State.BuildPollPlan(slots, maxSpan)
  maxSpan = maxSpan or 50
  local byGroup = {}
  for _, s in ipairs(slots) do
    local page, exec = math.floor(s.page or 0), math.floor(s.exec or 0)
    if page >= 1 and exec >= 1 then
      local itemsType = (exec > 100) and 3 or 2
      local gk = page * 10 + itemsType
      byGroup[gk] = byGroup[gk] or { page = page, itemsType = itemsType, idx = {} }
      byGroup[gk].idx[exec - 1] = true
    end
  end
  local keys = {}
  for gk in pairs(byGroup) do keys[#keys + 1] = gk end
  table.sort(keys)

  local plan = {}
  for _, gk in ipairs(keys) do
    local g = byGroup[gk]
    local list = {}
    for i in pairs(g.idx) do list[#list + 1] = i end
    table.sort(list)
    local lo, hi
    local function flush()
      if not lo then return end
      local start = (lo // 5) * 5
      local count = ((hi - start) // 5 + 1) * 5
      plan[#plan + 1] = { page = g.page, itemsType = g.itemsType, startIndex = start, itemsCount = count }
    end
    for _, i in ipairs(list) do
      if lo and (i - hi <= 10) and (i - ((lo // 5) * 5) < maxSpan) then
        hi = i
      else
        flush()
        lo, hi = i, i
      end
    end
    flush()
  end
  return plan
end
-- <<< ma2_state.lua
  -- >>> runtime.lua
-- (c) levo AVL | Elias Jenny - MIT License
-- Runtime code: only runs on the Core or in Emulation mode.

local json = require("rapidjson")

local DebugLevel = ({ None = 0, Basic = 1, Verbose = 2 })[Properties["Debug Print"].Value] or 0
local Counts = SlotCounts(Properties)
local PollInterval = math.max(0.1, (tonumber(Properties["Poll Interval (ms)"].Value) or 250) / 1000)

local TICK = 0.05             -- main timer resolution (s)
local RX_TIMEOUT = 3          -- no response for this long while logged in -> reconnect
local CONNECT_TIMEOUT = 6     -- TCP + handshake + login must finish within this time
local KEEPALIVE = 10          -- session keepalive interval
local FADER_HOLD = 0.6        -- ignore fader feedback this long after a user move
local FRAMES_PER_TICK = 6     -- send rate limit
local BACKOFF = { 1, 2, 4, 8, 15, 30 }

local Now = 0                 -- monotonic time in seconds, advanced by the main timer

local function Log(level, msg)
  if level <= DebugLevel then print(("[grandMA2] %s"):format(msg)) end
end

---------------------------------------------------------------------------
-- Control helpers (only write when the value changes)
---------------------------------------------------------------------------
local function SetString(name, s)
  local c = Controls[name]
  s = s or ""
  if c and c.String ~= s then c.String = s end
end

local function SetBool(name, b)
  local c = Controls[name]
  if c and c.Boolean ~= b then c.Boolean = b end
end

local function SetPosition(name, p)
  local c = Controls[name]
  if not c then return end
  p = math.max(0, math.min(1, p or 0))
  if math.abs(c.Position - p) > 0.0005 then c.Position = p end
end

local function SetLegend(name, text)
  local c = Controls[name]
  if c then pcall(function() if c.Legend ~= text then c.Legend = text end end) end
end

local STATUS = { OK = 0, Compromised = 1, Fault = 2, NotPresent = 3, Missing = 4, Initializing = 5 }
local function SetStatus(value, text)
  local c = Controls.Status
  if c.Value ~= value then c.Value = value end
  SetString("Status", text)
end

local function SetError(text)
  SetString("Last Error", text)
  if text ~= "" then Log(1, "Error: " .. text) end
end

---------------------------------------------------------------------------
-- Defaults for slot assignments (0 = not set)
---------------------------------------------------------------------------
local function DefaultInt(name, value)
  local c = Controls[name]
  if c and (c.Value or 0) < 1 then c.Value = value end
end

DefaultInt("Port", 80)
local function DefaultText(name, value)
  local c = Controls[name]
  if c and c.String:match("^%s*$") then c.String = value end
end
for i = 1, Counts.Faders do DefaultText("Fader " .. i .. " Exec", "1." .. i) end
for i = 1, Counts.Buttons do DefaultText("Button " .. i .. " Exec", "1." .. (100 + i)) end
for i = 1, Counts.Macros do
  DefaultInt("Macro " .. i .. " Number", i)
end
if Controls.Username.String == "" then Controls.Username.String = "administrator" end

---------------------------------------------------------------------------
-- Slots: what is assigned where
---------------------------------------------------------------------------
-- slot = { kind = "Fader"|"Button", index, prefix, page, exec, key, touchedAt }
local Slots = {}
local SlotsByKey = {}   -- "page.exec" -> { slot, ... }
local PollPlan = {}

local function KeyOf(page, exec) return ("%d.%d"):format(page, exec) end

-- "1.101" -> 1, 101 ; "101" -> 1, 101 (page 1) ; invalid -> 0, 0
local function ParseExec(text)
  local s = tostring(text or ""):gsub("%s", ""):gsub(",", ".")
  local p, e = s:match("^(%d+)%.(%d+)$")
  if not p then p, e = "1", s:match("^(%d+)$") end
  p, e = tonumber(p), tonumber(e)
  if not (p and e) or p < 1 or e < 1 or p > 9999 or e > 999 then return 0, 0 end
  return math.floor(p), math.floor(e)
end

local function RebuildSlots()
  Slots, SlotsByKey = {}, {}
  local list = {}
  local function add(kind, i)
    local prefix = kind .. " " .. i .. " "
    local page, exec = ParseExec(Controls[prefix .. "Exec"].String)
    local slot = { kind = kind, index = i, prefix = prefix, page = page, exec = exec, key = KeyOf(page, exec), touchedAt = -100 }
    Slots[#Slots + 1] = slot
    if page < 1 then
      local txt = Controls[prefix .. "Exec"].String
      if not txt:match("^%s*$") then SetError(("%s: invalid executor '%s' (use page.exec, e.g. 1.101)"):format(kind .. " " .. i, txt)) end
    else
      SlotsByKey[slot.key] = SlotsByKey[slot.key] or {}
      table.insert(SlotsByKey[slot.key], slot)
      list[#list + 1] = { page = page, exec = exec }
    end
  end
  for i = 1, Counts.Faders do add("Fader", i) end
  for i = 1, Counts.Buttons do add("Button", i) end
  PollPlan = MA2State.BuildPollPlan(list)
  Log(2, ("Poll plan: %d request(s) for %d slot(s)"):format(#PollPlan, #list))
end

local function FaderSlot(i) return Slots[i] end
local function ButtonSlot(i) return Slots[Counts.Faders + i] end

---------------------------------------------------------------------------
-- Slot output
---------------------------------------------------------------------------
local Tracker = MA2State.NewTracker()
local LastEntry = {}   -- key -> last parsed entry (for predictions)
local LastResult = {}  -- key -> last derived result

-- Main button colour = executor state (the only state display in the plugin UI)
local function Hex(rgb) return ("#%02X%02X%02X"):format(rgb[1], rgb[2], rgb[3]) end
local BC = LevoBrand.Colors
local StateColor = {
  [MA2State.States.On]        = Hex(BC.Amber),
  [MA2State.States.FadingIn]  = Hex(BC.AmberSoft),
  [MA2State.States.FadingOut] = Hex(BC.AmberSoft),
  [MA2State.States.Off]       = Hex(BC.Line),
  [MA2State.States.Empty]     = Hex(BC.Porcelain),
  [MA2State.States.Offline]   = Hex(BC.Porcelain),
}

local function SetColor(name, color)
  local c = Controls[name]
  if c and color then pcall(function() if c.Color ~= color then c.Color = color end end) end
end

local function ShowSlot(slot, e, r)
  local p = slot.prefix
  SetString(p .. "Name", e and e.name or "")
  SetString(p .. "Cue", e and e.cue or "")
  SetString(p .. "Function", e and e.func or "")
  SetString(p .. "State", r.state)
  SetBool(p .. "Active", r.active)
  SetBool(p .. "Fading", r.fading)
  SetPosition(p .. "Progress", r.progress)
  if slot.kind == "Fader" then
    for b = 1, 3 do
      local label = e and e.labels[b] or ""
      SetString(p .. "Button " .. b .. " Label", label)
      SetLegend(p .. "Button " .. b, label)
    end
    SetColor(p .. "Button 1", StateColor[r.state])
    if e and e.level and (Now - slot.touchedAt) > FADER_HOLD then
      SetPosition(p .. "Level", e.level)
    end
  else
    SetLegend(p .. "Press", e and e.func or "")
    SetColor(p .. "Press", StateColor[r.state])
  end
end

local OFFLINE = { state = MA2State.States.Offline, active = false, fading = false, progress = 0 }

local function ShowAllOffline()
  Tracker:Reset()
  LastEntry, LastResult = {}, {}
  for _, slot in ipairs(Slots) do
    SetString(slot.prefix .. "State", OFFLINE.state)
    SetBool(slot.prefix .. "Active", false)
    SetBool(slot.prefix .. "Fading", false)
    SetPosition(slot.prefix .. "Progress", 0)
    SetColor(slot.prefix .. (slot.kind == "Fader" and "Button 1" or "Press"), StateColor[OFFLINE.state])
  end
end

local function ApplyEntry(e)
  local key = KeyOf(e.page, e.exec)
  local slots = SlotsByKey[key]
  if not slots then return end
  local r = Tracker:Update(key, e, Now)
  local prev = LastResult[key]
  if DebugLevel >= 2 and (not prev or prev.state ~= r.state) then
    Log(2, ("Exec %s '%s': %s -> %s%s"):format(key, e.name, prev and prev.state or "-", r.state,
      r.fading and (" (%d%%)"):format(math.floor(r.progress * 100 + 0.5)) or ""))
  end
  LastEntry[key], LastResult[key] = e, r
  for _, slot in ipairs(slots) do ShowSlot(slot, e, r) end
end

-- After an optimistic update, show it right away instead of waiting for a poll
local function RefreshKey(key)
  local e = LastEntry[key]
  if e then ApplyEntry(e) end
end

---------------------------------------------------------------------------
-- Connection
---------------------------------------------------------------------------
local Conn = {
  ws = nil,
  phase = "idle",       -- idle | connecting | login | ready | waiting (backoff)
  session = 0,
  phaseSince = 0,
  lastRx = 0,
  lastKeepalive = 0,
  retryAt = nil,
  attempt = 0,
  reconnects = 0,
  pollQueue = {},
  pollWaiting = false,
  pollSentAt = 0,
  nextCycle = 0,
}

-- Outgoing queue: list of keys + payload map, so repeated fader moves coalesce
local TxOrder, TxPayload = {}, {}
local TxSeq = 0

local function Enqueue(msg, coalesceKey)
  if not coalesceKey then
    TxSeq = TxSeq + 1
    coalesceKey = "#" .. TxSeq
  end
  if TxPayload[coalesceKey] == nil then TxOrder[#TxOrder + 1] = coalesceKey end
  TxPayload[coalesceKey] = msg
end

local function ClearQueue()
  TxOrder, TxPayload = {}, {}
end

local function SendNow(msg, quiet)
  if not (Conn.ws and Conn.ws:IsOpen()) then return false end
  local text = type(msg) == "table" and json.encode(msg) or msg
  if not quiet then Log(2, "> " .. text) end
  return Conn.ws:Send(text)
end

local function DrainQueue()
  if Conn.phase ~= "ready" then return end
  local n = 0
  while n < FRAMES_PER_TICK and #TxOrder > 0 do
    local key = table.remove(TxOrder, 1)
    local msg = TxPayload[key]
    TxPayload[key] = nil
    SendNow(msg)
    n = n + 1
  end
end

local function SetPhase(phase)
  Conn.phase, Conn.phaseSince = phase, Now
  SetBool("Connected", phase == "login" or phase == "ready")
  SetBool("Logged In", phase == "ready")
end

local OnMessage  -- forward declaration

local function ScheduleRetry(reason)
  Conn.attempt = Conn.attempt + 1
  local delay = BACKOFF[math.min(Conn.attempt, #BACKOFF)]
  Conn.retryAt = Now + delay
  SetPhase("waiting")
  ShowAllOffline()
  SetStatus(STATUS.Missing, ("%s - retry in %ds"):format(reason or "Not connected", delay))
  Log(1, ("%s, retry in %ds"):format(reason or "Disconnected", delay))
end

local function Disconnect()
  if Conn.ws then Conn.ws:Close() end
  Conn.ws = nil
  ClearQueue()
  Conn.pollQueue, Conn.pollWaiting = {}, false
end

local function Connect()
  Disconnect()
  Conn.retryAt = nil
  local ip = Controls["IP Address"].String:gsub("^%s+", ""):gsub("%s+$", "")
  if ip == "" then
    SetPhase("idle")
    ShowAllOffline()
    SetStatus(STATUS.Missing, "No IP address set")
    return
  end
  local port = math.floor(Controls.Port.Value)
  if port < 1 then port = 80 end
  Conn.session = 0
  SetString("Session", "")
  SetPhase("connecting")
  SetStatus(STATUS.Initializing, "Connecting to " .. ip)
  Log(1, ("Connecting to %s:%d"):format(ip, port))
  Conn.ws = LevoWebSocket.New({
    Log = Log,
    OnOpen = function()
      SetPhase("login")
      SetStatus(STATUS.Initializing, "Connected, logging in")
      Conn.lastRx = Now
    end,
    OnMessage = function(text) OnMessage(text) end,
    OnClose = function(reason)
      Conn.ws = nil
      SetError(reason or "connection closed")
      ScheduleRetry("Connection lost")
    end,
  })
  Conn.ws:Connect(ip, port, "/?ma=1")
end

local function Reconnect(manual)
  if manual then
    Conn.attempt = 0
    Conn.reconnects = Conn.reconnects + 1
    SetString("Reconnects", tostring(Conn.reconnects))
  end
  Connect()
end

local function SendLogin()
  local user = Controls.Username.String
  local pass = Controls.Password.String
  Log(1, "Logging in as '" .. user .. "'")
  SendNow({
    requestType = "login",
    username = user,
    password = Crypto.MD5Compute(pass),
    session = Conn.session,
    maxRequests = 10,
  }, true)
end

local function SendPoll(req)
  local isButton = req.itemsType == 3
  SendNow({
    requestType = "playbacks",
    startIndex = { req.startIndex },
    itemsCount = { req.itemsCount },
    pageIndex = req.page - 1,
    itemsType = { req.itemsType },
    view = req.itemsType,
    execButtonViewMode = isButton and 2 or 1,
    buttonsViewMode = 0,
    session = Conn.session,
    maxRequests = 10,
  }, true)
  Conn.pollWaiting, Conn.pollSentAt = true, Now
end

local function NextPoll()
  if Conn.phase ~= "ready" or Conn.pollWaiting then return end
  local req = table.remove(Conn.pollQueue, 1)
  if req then SendPoll(req) end
end

OnMessage = function(text)
  Conn.lastRx = Now
  local ok, data = pcall(json.decode, text)
  if not ok or type(data) ~= "table" then
    Log(2, "< (invalid JSON) " .. text:sub(1, 200))
    return
  end

  if data.responseType == "playbacks" then
    Conn.pollWaiting = false
    for _, e in ipairs(MA2State.ParsePlaybacks(data)) do ApplyEntry(e) end
    if Conn.phase == "ready" then
      SetStatus(STATUS.OK, "OK")
    end
    NextPoll()
    return
  end

  Log(2, "< " .. text:sub(1, 400))

  if data.status == "server ready" then
    Conn.session = 0
    SendNow({ session = 0 })
    return
  end

  if data.session ~= nil then
    local s = tonumber(data.session) or 0
    if s ~= Conn.session then
      Conn.session = s
      SetString("Session", tostring(s))
      Log(1, "Session " .. s)
    end
    if s < 0 then
      -- session rejected / expired: start a new one
      Conn.session = 0
      SetPhase("login")
      SendNow({ session = 0 })
      return
    end
  end

  if data.forceLogin then
    SetPhase("login")
    SendLogin()
    return
  end

  if data.responseType == "login" then
    if data.result then
      Log(1, "Logged in")
      SetError("")
      Conn.attempt = 0
      Conn.lastKeepalive = Now
      Conn.nextCycle = Now
      SetPhase("ready")
      SetStatus(STATUS.OK, "OK")
    else
      SetError("Login failed - check username / password")
      Disconnect()
      SetPhase("waiting")
      Conn.attempt = #BACKOFF  -- do not hammer the console with wrong credentials
      Conn.retryAt = Now + BACKOFF[#BACKOFF]
      ShowAllOffline()
      SetStatus(STATUS.Fault, "Login failed - check username / password")
    end
  end
end

---------------------------------------------------------------------------
-- Main timer
---------------------------------------------------------------------------
local MainTimer = Timer.New()
-- Keep long-lived objects reachable from a global. A timer that is only held by
-- a local variable gets garbage collected on the Core and silently stops.
GrandMA2Runtime = { Timer = MainTimer, Conn = Conn }
MainTimer.EventHandler = function()
  Now = Now + TICK

  if Conn.phase == "waiting" and Conn.retryAt and Now >= Conn.retryAt then
    Conn.reconnects = Conn.reconnects + 1
    SetString("Reconnects", tostring(Conn.reconnects))
    Connect()
    return
  end

  if (Conn.phase == "connecting" or Conn.phase == "login") and Now - Conn.phaseSince > CONNECT_TIMEOUT then
    SetError(Conn.phase == "connecting" and "No answer from console (web remote enabled?)" or "Login timed out")
    Disconnect()
    ScheduleRetry("Not reachable")
    return
  end

  if Conn.phase == "ready" then
    if Now - Conn.lastRx > RX_TIMEOUT then
      SetError("Console stopped responding")
      Disconnect()
      ScheduleRetry("Timeout")
      return
    end
    if Now - Conn.lastKeepalive >= KEEPALIVE then
      Conn.lastKeepalive = Now
      SendNow({ session = Conn.session }, true)
    end
    -- poll cycle
    if Conn.pollWaiting and Now - Conn.pollSentAt > 1 then
      Conn.pollWaiting = false  -- lost response, carry on
    end
    if Now >= Conn.nextCycle and #Conn.pollQueue == 0 then
      Conn.nextCycle = Now + PollInterval
      for _, req in ipairs(PollPlan) do Conn.pollQueue[#Conn.pollQueue + 1] = req end
    end
    DrainQueue()
    NextPoll()
  end
end

---------------------------------------------------------------------------
-- User input
---------------------------------------------------------------------------
local function UserInput(slot, t, fields, coalesceKey)
  if slot.page < 1 or slot.exec < 1 then return end
  local msg = {
    requestType = "playbacks_userInput",
    execIndex = slot.exec - 1,
    pageIndex = slot.page - 1,
    ["type"] = t,
    session = Conn.session,
    maxRequests = 0,
  }
  for k, v in pairs(fields) do msg[k] = v end
  if Conn.phase ~= "ready" then
    Log(1, ("Not connected - input on exec %s dropped"):format(slot.key))
    return
  end
  Enqueue(msg, coalesceKey)
end

local function Press(slot, buttonId, func, pressed)
  UserInput(slot, 0, { pressed = pressed, released = not pressed, buttonId = buttonId })
  if pressed and Conn.phase == "ready" then
    local r = LastResult[slot.key]
    local predicted = MA2State.PredictPress(func, r and r.active)
    if predicted ~= nil then
      Tracker:SetOptimistic(slot.key, predicted, Now)
      RefreshKey(slot.key)
    end
    Log(1, ("Exec %s button %d (%s)"):format(slot.key, buttonId + 1, func ~= "" and func or "?"))
  end
end

local function SendCommand(cmd)
  cmd = (cmd or ""):gsub("^%s+", ""):gsub("%s+$", "")
  if cmd == "" then return end
  if Conn.phase ~= "ready" then
    Log(1, "Not connected - command dropped: " .. cmd)
    return
  end
  Log(1, "Command: " .. cmd)
  Enqueue({ requestType = "command", command = cmd, session = Conn.session, maxRequests = 0 })
end

local function WireSlotHandlers()
  for i = 1, Counts.Faders do
    local p = "Fader " .. i .. " "
    Controls[p .. "Level"].EventHandler = function(c)
      local slot = FaderSlot(i)
      slot.touchedAt = Now
      UserInput(slot, 1, { faderValue = c.Position }, "fader:" .. slot.key)
    end
    for b = 1, 3 do
      Controls[p .. "Button " .. b].EventHandler = function(c)
        local slot = FaderSlot(i)
        Press(slot, b - 1, Controls[p .. "Button " .. b .. " Label"].String, c.Boolean)
      end
    end
  end
  for i = 1, Counts.Buttons do
    local p = "Button " .. i .. " "
    Controls[p .. "Press"].EventHandler = function(c)
      local slot = ButtonSlot(i)
      Press(slot, 0, Controls[p .. "Function"].String, c.Boolean)
    end
  end
  for i = 1, Counts.Macros do
    Controls["Macro " .. i .. " Trigger"].EventHandler = function()
      local n = math.floor(Controls["Macro " .. i .. " Number"].Value)
      if n >= 1 then SendCommand("Go Macro " .. n) end
    end
  end
  for i = 1, Counts.Commands do
    Controls["Command " .. i .. " Send"].EventHandler = function()
      SendCommand(Controls["Command " .. i .. " Text"].String)
    end
  end

  -- re-assignment of page / exec at runtime
  local function OnAssign()
    SetError("")
    RebuildSlots()
    Tracker:Reset()
    LastEntry, LastResult = {}, {}
    for _, slot in ipairs(Slots) do ShowSlot(slot, nil, OFFLINE) end
    Conn.pollQueue = {}
    Conn.nextCycle = Now
  end
  for _, kind in ipairs({ "Fader", "Button" }) do
    local n = kind == "Fader" and Counts.Faders or Counts.Buttons
    for i = 1, n do
      Controls[kind .. " " .. i .. " Exec"].EventHandler = OnAssign
    end
  end
end

Controls["Command TX"].EventHandler = function(c)
  local cmd = c.String
  c.String = ""
  SendCommand(cmd)
end

local function OnConnectionSetting()
  Conn.attempt = 0
  Connect()
end
Controls["IP Address"].EventHandler = OnConnectionSetting
Controls.Port.EventHandler = OnConnectionSetting
Controls.Username.EventHandler = OnConnectionSetting
Controls.Password.EventHandler = OnConnectionSetting
Controls.Reconnect.EventHandler = function() Reconnect(true) end

---------------------------------------------------------------------------
-- Start
---------------------------------------------------------------------------
SetString("Reconnects", "0")
SetError("")
RebuildSlots()  -- may report invalid assignments via Last Error
for _, slot in ipairs(Slots) do ShowSlot(slot, nil, OFFLINE) end
WireSlotHandlers()
Log(1, ("Started, build %s - %d fader(s), %d button(s), %d macro(s), %d command(s)"):format(
  PluginInfo.BuildVersion, Counts.Faders, Counts.Buttons, Counts.Macros, Counts.Commands))
MainTimer:Start(TICK)
Connect()
-- <<< runtime.lua
end
