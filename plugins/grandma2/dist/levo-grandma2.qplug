PluginInfo = {
  Name         = "levo AVL~grandMA2",  -- "Folder~Name" in the Q-SYS schematic library
  Version      = "0.1",
  BuildVersion = "0.1.0",
  Id           = "89f5e3aa-d79a-45df-99b8-71f4c6a3d200",
