-- >>> info.lua
-- (c) levo AVL | Elias Jenny - MIT License
-- Generate a NEW Id (GUID) for every plugin, e.g. python3 -c "import uuid;print(uuid.uuid4())"

PluginInfo = {
  Name         = "levo AVL~Template",  -- "Folder~Name" in the Q-SYS schematic library
  Version      = "0.1",
  BuildVersion = "0.1.0",
  Id           = "2c3d5651-bbde-4ab2-8696-d08dd0140b6a",
  Author       = "levo AVL | Elias Jenny",
  Description  = "Template plugin for levo AVL Q-SYS plugins (branding test).",
  ShowDebug    = true,
}
-- <<< info.lua
-- >>> levo_brand.lua
-- levo AVL branding for Q-SYS plugin layouts
-- Shared by all plugins in this repository; included once at the top of each
-- plugin's plugin.lua (after info.lua).
--
-- (c) levo AVL | Elias Jenny - MIT License

-- >>> levo_assets.lua
-- AUTO-GENERATED by tools/build.py from shared/assets - do not edit by hand.
-- (c) levo AVL | Elias Jenny - MIT License

LevoAssets = {
  wordmark_atlantic = { Width = 360, Height = 82,
    Data = "" },
  wordmark_porcelain = { Width = 360, Height = 81,
    Data = "" },
}
-- <<< levo_assets.lua

LevoBrand = {
  Company = "levo AVL",
  Author  = "levo AVL | Elias Jenny",
  Address = { "Printzstraße 4", "76139 Karlsruhe", "Germany" },
  Web     = "www.levo.de",
  Mail    = "hello@levo.de",
  Repo    = "github.com/levoavl/qsys-plugins",
  License = "MIT License",

  -- levo AVL colour system (RGB for digital use)
  Colors = {
    Atlantic  = { 0, 70, 140 },     -- primary
    Amber     = { 255, 184, 48 },   -- accent, highlights, call-to-action
    Porcelain = { 245, 245, 243 },  -- light background
    Onyx      = { 25, 25, 25 },     -- text, contrast
    Mid       = { 120, 120, 120 },  -- secondary text (derived)
    AmberSoft = { 255, 219, 150 },  -- amber at reduced intensity, e.g. fading states (derived)
    Line      = { 214, 214, 210 },  -- hairlines, frames (derived from Porcelain)
    Haze      = { 172, 196, 222 },  -- secondary text on Atlantic (derived)
  },

  HeaderHeight = 40,
}

local C = LevoBrand.Colors

local function Image(asset, x, y, w)
  local h = math.floor(w * asset.Height / asset.Width + 0.5)
  return { Type = "Image", Image = asset.Data, Position = { x, y }, Size = { w, h } }, h
end

local function Text(text, x, y, w, h, size, color, style, align)
  return {
    Type = "Text", Text = text,
    Position = { x, y }, Size = { w, h },
    FontSize = size, FontStyle = style or "Regular",
    HTextAlign = align or "Left",
    Color = color or C.Onyx,
  }
end

-- Page background in Porcelain. Call first so everything else draws on top.
function LevoBrand.Background(graphics, width, height)
  table.insert(graphics, {
    Type = "GroupBox", Fill = C.Porcelain, StrokeWidth = 0, CornerRadius = 0,
    Position = { 0, 0 }, Size = { width, height },
  })
end

-- Atlantic header bar: small porcelain wordmark on the left, plugin name (bold)
-- and the current page on the right. Returns the y coordinate where page content
-- can start. `title` = plugin name, `subtitle` = page name (both optional).
function LevoBrand.Header(graphics, width, title, subtitle)
  local h = LevoBrand.HeaderHeight
  table.insert(graphics, {
    Type = "GroupBox", Fill = C.Atlantic, StrokeWidth = 0, CornerRadius = 0,
    Position = { 0, 0 }, Size = { width, h },
  })
  local logo, logoH = Image(LevoAssets.wordmark_porcelain, 12, 0, 68)
  logo.Position[2] = math.floor((h - logoH) / 2)
  table.insert(graphics, logo)
  if title and subtitle then
    table.insert(graphics, Text(title, 96, 4, width - 108, 18, 14, C.Porcelain, "Bold", "Right"))
    table.insert(graphics, Text(subtitle, 96, 21, width - 108, 14, 10, C.Haze, "Regular", "Right"))
  elseif title then
    table.insert(graphics, Text(title, 96, 0, width - 108, h, 14, C.Porcelain, "Bold", "Right"))
  end
  -- thin amber accent line under the header
  table.insert(graphics, {
    Type = "GroupBox", Fill = C.Amber, StrokeWidth = 0, CornerRadius = 0,
    Position = { 0, h }, Size = { width, 2 },
  })
  return h + 2
end

-- Plugin name without the "levo AVL~" library folder
function LevoBrand.PluginName(info)
  return (info.Name:gsub("^.-~", ""))
end

-- Content of the "About" page. `info` is the plugin's PluginInfo table.
function LevoBrand.About(graphics, x, y, width, info)
  local line = 18
  local logo, logoH = Image(LevoAssets.wordmark_atlantic, x, y, 160)
  table.insert(graphics, logo)
  y = y + logoH + 16

  local name = info.Name:gsub("^.-~", "")  -- strip the "levo AVL~" library folder
  table.insert(graphics, Text(name, x, y, width, 22, 16, C.Atlantic, "Bold"))
  y = y + 24
  table.insert(graphics, Text("Version " .. (info.BuildVersion or info.Version), x, y, width, line, 11, C.Mid))
  y = y + line + 12

  local rows = {
    LevoBrand.Company,
    LevoBrand.Address[1],
    LevoBrand.Address[2] .. ", " .. LevoBrand.Address[3],
    LevoBrand.Web .. "  ·  " .. LevoBrand.Mail,
  }
  for _, r in ipairs(rows) do
    table.insert(graphics, Text(r, x, y, width, line, 12, C.Onyx))
    y = y + line
  end
  y = y + 12

  table.insert(graphics, Text("Author: " .. LevoBrand.Author, x, y, width, line, 11, C.Onyx))
  y = y + line
  table.insert(graphics, Text("Source & updates: " .. LevoBrand.Repo, x, y, width, line, 11, C.Onyx))
  y = y + line
  table.insert(graphics, Text("Licensed under the " .. LevoBrand.License .. ". Provided as is, without warranty.",
    x, y, width, line, 11, C.Mid))
  y = y + line + 12

  table.insert(graphics, Text(
    "Not affiliated with or endorsed by QSC, LLC or the manufacturer of the controlled device. "
      .. "All trademarks belong to their respective owners.",
    x, y, width, line * 2, 10, C.Mid))
  return y + line * 2
end
-- <<< levo_brand.lua

PageNames = { "Control", "Setup", "About" }

function GetColor(props)
  return LevoBrand.Colors.Atlantic
end

function GetPrettyName(props)
  return PluginInfo.Name:gsub("^.-~", "") .. "\n" .. PluginInfo.BuildVersion
end

function GetPages(props)
  local pages = {}
  for _, name in ipairs(PageNames) do
    table.insert(pages, { name = name })
  end
  return pages
end

function GetProperties()
  local props = {}
  -- >>> properties.lua
-- (c) levo AVL | Elias Jenny - MIT License
table.insert(props, {
  Name = "Debug Print",
  Type = "enum",
  Choices = { "None", "Basic", "Verbose" },
  Value = "None",
})
-- <<< properties.lua
  return props
end

function RectifyProperties(props)
  -- >>> rectify.lua
-- (c) levo AVL | Elias Jenny - MIT License
-- Hide or show properties depending on other properties here.
if props.plugin_show_debug.Value == false then
  props["Debug Print"].IsHidden = true
end
-- <<< rectify.lua
  return props
end

function GetPins(props)
  local pins = {}
  return pins
end

function GetControls(props)
  local ctrls = {}
  -- >>> controls.lua
-- (c) levo AVL | Elias Jenny - MIT License
table.insert(ctrls, {
  Name = "IPAddress",
  ControlType = "Text",
  Count = 1,
  UserPin = true,
  PinStyle = "Both",
})
table.insert(ctrls, {
  Name = "Status",
  ControlType = "Indicator",
  IndicatorType = "Status",
  Count = 1,
  UserPin = true,
  PinStyle = "Output",
})
-- <<< controls.lua
  return ctrls
end

function GetControlLayout(props)
  local layout, graphics = {}, {}
  local CurrentPage = PageNames[props["page_index"].Value]
  -- >>> layout.lua
-- (c) levo AVL | Elias Jenny - MIT License
local W, H = 420, 340
local C = LevoBrand.Colors
LevoBrand.Background(graphics, W, H)
local y = LevoBrand.Header(graphics, W, LevoBrand.PluginName(PluginInfo), CurrentPage) + 16

local function Label(text, x, ly, w)
  table.insert(graphics, {
    Type = "Text", Text = text, Position = { x, ly }, Size = { w, 20 },
    FontSize = 12, HTextAlign = "Right", Color = C.Onyx,
  })
end

if CurrentPage == "Control" then
  Label("Status", 16, y, 100)
  layout["Status"] = { PrettyName = "Status", Position = { 124, y }, Size = { 280, 20 } }

elseif CurrentPage == "Setup" then
  Label("IP Address", 16, y, 100)
  layout["IPAddress"] = {
    PrettyName = "Setup~IP Address", Style = "Text",
    Position = { 124, y }, Size = { 140, 20 },
  }

elseif CurrentPage == "About" then
  LevoBrand.About(graphics, 16, y, W - 32, PluginInfo)
end
-- <<< layout.lua
  return layout, graphics
end

if Controls then
  -- >>> runtime.lua
-- (c) levo AVL | Elias Jenny - MIT License
-- Runtime code: only runs on the Core or in Emulation mode.

local DebugLevel = ({ None = 0, Basic = 1, Verbose = 2 })[Properties["Debug Print"].Value] or 0

local function Log(level, msg)
  if level <= DebugLevel then print("[levo] " .. msg) end
end

local function SetStatus(value, text)
  Controls.Status.Value = value  -- 0 OK, 1 Compromised, 2 Fault, 3 Not present, 4 Missing, 5 Initializing
  Controls.Status.String = text or ""
end

SetStatus(0, "Template loaded")
Log(1, "Template plugin started, build " .. PluginInfo.BuildVersion)

Controls.IPAddress.EventHandler = function(ctl)
  Log(1, "IP address set to " .. ctl.String)
end
-- <<< runtime.lua
end
