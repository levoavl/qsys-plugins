-- levo AVL Q-SYS plugin - Beat Analyzer (beat / BPM detection, tempo sync to grandMA2/3)
-- Built into a single .qplug by tools/build.py (resolves the #include lines).
-- (c) levo AVL | Elias Jenny - MIT License

-- >>> info.lua
-- (c) levo AVL | Elias Jenny - MIT License

PluginInfo = {
  Name         = "levo AVL~Beat Analyzer",  -- "Folder~Name" in the Q-SYS schematic library
  Version      = "1.0",
  BuildVersion = "1.0",  -- versions are major.minor, see source/README.md
  Id           = "d47b20d7-684f-462e-b3d1-285ca6155205",
  Author       = "levo AVL | Elias Jenny",
  Description  = "Beat and BPM detection from a Q-SYS level meter, with tempo sync to grandMA2 (Telnet) or grandMA3 (OSC).",
  ShowDebug    = true,
}
-- <<< info.lua
-- >>> levo_brand.lua
-- levo AVL branding for Q-SYS plugin layouts
-- Shared by all plugins in this repository; included once at the top of each
-- plugin's plugin.lua (after info.lua).
--
-- (c) levo AVL | Elias Jenny - MIT License

-- >>> levo_assets.lua
-- AUTO-GENERATED by tools/build.py from shared/assets - do not edit by hand.
-- (c) levo AVL | Elias Jenny - MIT License

LevoAssets = {
  wordmark_atlantic = { Width = 360, Height = 82,
    Data = "" },
  wordmark_porcelain = { Width = 360, Height = 81,
    Data = "" },
}
-- <<< levo_assets.lua

LevoBrand = {
  Company = "levo AVL",
  Author  = "levo AVL | Elias Jenny",
  Address = { "Printzstraße 4", "76139 Karlsruhe", "Germany" },
  Web     = "www.levo.de",
  Mail    = "hello@levo.de",
  Repo    = "github.com/levoavl/qsys-plugins",
  License = "MIT License",

  -- levo AVL colour system (RGB for digital use)
  Colors = {
    Atlantic  = { 0, 70, 140 },     -- primary
    Amber     = { 255, 184, 48 },   -- accent, highlights, call-to-action
    Porcelain = { 245, 245, 243 },  -- light background
    Onyx      = { 25, 25, 25 },     -- text, contrast
    Mid       = { 120, 120, 120 },  -- secondary text (derived)
    AmberSoft = { 255, 219, 150 },  -- amber at reduced intensity, e.g. fading states (derived)
    Line      = { 214, 214, 210 },  -- hairlines, frames (derived from Porcelain)
    Haze      = { 172, 196, 222 },  -- secondary text on Atlantic (derived)
  },

  HeaderHeight = 40,
}

local C = LevoBrand.Colors

local function Image(asset, x, y, w)
  local h = math.floor(w * asset.Height / asset.Width + 0.5)
  return { Type = "Image", Image = asset.Data, Position = { x, y }, Size = { w, h } }, h
end

local function Text(text, x, y, w, h, size, color, style, align)
  return {
    Type = "Text", Text = text,
    Position = { x, y }, Size = { w, h },
    FontSize = size, FontStyle = style or "Regular",
    HTextAlign = align or "Left",
    Color = color or C.Onyx,
  }
end

-- Page background in Porcelain. Call first so everything else draws on top.
function LevoBrand.Background(graphics, width, height)
  table.insert(graphics, {
    Type = "GroupBox", Fill = C.Porcelain, StrokeWidth = 0, CornerRadius = 0,
    Position = { 0, 0 }, Size = { width, height },
  })
end

-- Atlantic header bar: small porcelain wordmark on the left, plugin name (bold)
-- and the current page on the right. Returns the y coordinate where page content
-- can start. `title` = plugin name, `subtitle` = page name (both optional).
function LevoBrand.Header(graphics, width, title, subtitle)
  local h = LevoBrand.HeaderHeight
  table.insert(graphics, {
    Type = "GroupBox", Fill = C.Atlantic, StrokeWidth = 0, CornerRadius = 0,
    Position = { 0, 0 }, Size = { width, h },
  })
  local logo, logoH = Image(LevoAssets.wordmark_porcelain, 12, 0, 68)
  logo.Position[2] = math.floor((h - logoH) / 2)
  table.insert(graphics, logo)
  if title and subtitle then
    table.insert(graphics, Text(title, 96, 4, width - 108, 18, 14, C.Porcelain, "Bold", "Right"))
    table.insert(graphics, Text(subtitle, 96, 21, width - 108, 14, 10, C.Haze, "Regular", "Right"))
  elseif title then
    table.insert(graphics, Text(title, 96, 0, width - 108, h, 14, C.Porcelain, "Bold", "Right"))
  end
  -- thin amber accent line under the header
  table.insert(graphics, {
    Type = "GroupBox", Fill = C.Amber, StrokeWidth = 0, CornerRadius = 0,
    Position = { 0, h }, Size = { width, 2 },
  })
  return h + 2
end

-- Plugin name without the "levo AVL~" library folder
function LevoBrand.PluginName(info)
  return (info.Name:gsub("^.-~", ""))
end

-- Content of the "About" page. `info` is the plugin's PluginInfo table.
function LevoBrand.About(graphics, x, y, width, info)
  local line = 18
  local logo, logoH = Image(LevoAssets.wordmark_atlantic, x, y, 160)
  table.insert(graphics, logo)
  y = y + logoH + 16

  local name = info.Name:gsub("^.-~", "")  -- strip the "levo AVL~" library folder
  table.insert(graphics, Text(name, x, y, width, 22, 16, C.Atlantic, "Bold"))
  y = y + 24
  table.insert(graphics, Text("Version " .. (info.BuildVersion or info.Version), x, y, width, line, 11, C.Mid))
  y = y + line + 12

  local rows = {
    LevoBrand.Company,
    LevoBrand.Address[1],
    LevoBrand.Address[2] .. ", " .. LevoBrand.Address[3],
    LevoBrand.Web .. "  ·  " .. LevoBrand.Mail,
  }
  for _, r in ipairs(rows) do
    table.insert(graphics, Text(r, x, y, width, line, 12, C.Onyx))
    y = y + line
  end
  y = y + 12

  table.insert(graphics, Text("Author: " .. LevoBrand.Author, x, y, width, line, 11, C.Onyx))
  y = y + line
  table.insert(graphics, Text("Source & updates: " .. LevoBrand.Repo, x, y, width, line, 11, C.Onyx))
  y = y + line
  table.insert(graphics, Text("Licensed under the " .. LevoBrand.License .. ". Provided as is, without warranty.",
    x, y, width, line, 11, C.Mid))
  y = y + line + 12

  table.insert(graphics, Text(
    "Not affiliated with or endorsed by QSC, LLC or the manufacturer of the controlled device. "
      .. "All trademarks belong to their respective owners.",
    x, y, width, line * 2, 10, C.Mid))
  return y + line * 2
end
-- <<< levo_brand.lua

PageNames = { "Control", "Setup", "Debug", "About" }

-- Property values used by controls, layout and runtime
function Options(props)
  local function v(name, default)
    local p = props[name]
    return p and p.Value or default
  end
  return {
    LevelSource = v("Level Source", "Wired Pin"),
    Bands = v("Inputs", "Kick") == "Kick + Snare" and 2 or 1,
    Console = v("Console Type", "grandMA2"),
  }
end

function GetColor(props)
  return LevoBrand.Colors.Atlantic
end

function GetPrettyName(props)
  return PluginInfo.Name:gsub("^.-~", "") .. "\n" .. PluginInfo.BuildVersion
end

function GetPages(props)
  local pages = {}
  for _, name in ipairs(PageNames) do
    table.insert(pages, { name = name })
  end
  return pages
end

function GetProperties()
  local props = {}
  -- >>> properties.lua
-- (c) levo AVL | Elias Jenny - MIT License
table.insert(props, {
  -- where the kick (and snare) levels come from
  Name = "Level Source",
  Type = "enum",
  Choices = { "Wired Pin", "Named Component", "Test Generator" },
  Value = "Wired Pin",
})
table.insert(props, {
  -- "Kick + Snare": a second level input is analysed together with the kick
  Name = "Inputs",
  Type = "enum",
  Choices = { "Kick", "Kick + Snare" },
  Value = "Kick",
})
table.insert(props, {
  -- where the tempo goes; "None" = detection only (pins)
  Name = "Console Type",
  Type = "enum",
  Choices = { "None", "grandMA2", "grandMA3" },
  Value = "grandMA2",
})
table.insert(props, {
  Name = "Debug Print",
  Type = "enum",
  Choices = { "None", "Basic", "Verbose" },
  Value = "None",
})
-- <<< properties.lua
  return props
end

function RectifyProperties(props)
  -- >>> rectify.lua
-- (c) levo AVL | Elias Jenny - MIT License
if props.plugin_show_debug.Value == false then
  props["Debug Print"].IsHidden = true
end
-- <<< rectify.lua
  return props
end

function GetPins(props)
  local pins = {}
  return pins
end

function GetControls(props)
  local ctrls = {}
  -- >>> controls.lua
-- (c) levo AVL | Elias Jenny - MIT License
local opt = Options(props)

local function Add(def)
  def.Count = def.Count or 1
  if def.UserPin == nil then def.UserPin = true end
  table.insert(ctrls, def)
end
local function TextOut(name) Add({ Name = name, ControlType = "Indicator", IndicatorType = "Text", PinStyle = "Output" }) end
local function Led(name)     Add({ Name = name, ControlType = "Indicator", IndicatorType = "Led", PinStyle = "Output" }) end
local function Meter(name, min, max)
  Add({ Name = name, ControlType = "Indicator", IndicatorType = "Meter", Min = min, Max = max, PinStyle = "Output" })
end
local function Trigger(name) Add({ Name = name, ControlType = "Button", ButtonType = "Trigger", PinStyle = "Input" }) end
local function Toggle(name, default)
  Add({ Name = name, ControlType = "Button", ButtonType = "Toggle", DefaultValue = default and 1 or 0, PinStyle = "Both" })
end
local function TextIn(name, pinStyle) Add({ Name = name, ControlType = "Text", PinStyle = pinStyle or "Both" }) end
local function Num(name, unit, min, max, default, pinStyle)
  Add({ Name = name, ControlType = "Knob", ControlUnit = unit, Min = min, Max = max, DefaultValue = default, PinStyle = pinStyle or "Both" })
end

-- Tempo (outputs)
Num("BPM", "Float", 0, 300, 0, "Output")
TextOut("BPM Text")
Led("Beat")
Led("Downbeat")
for i = 1, 4 do Led("Bar " .. i) end
Num("Bar Position", "Integer", 0, 4, 0, "Output")
Led("Locked")
TextOut("Detection State")
Meter("Confidence", 0, 100)
Meter("Kick Meter", -60, 0)
TextOut("Tempo Scale")

-- Tempo (user)
Trigger("Tap")
Toggle("Auto", true)
Toggle("Hold", false)
Trigger("Half")
Trigger("Double")
Trigger("Resync")
Trigger("Shift Half Beat")

-- Detection setup
if opt.LevelSource == "Wired Pin" then
  Num("Kick Level", "dB", -100, 20, -100, "Input")
  if opt.Bands == 2 then Num("Snare Level", "dB", -100, 20, -100, "Input") end
elseif opt.LevelSource == "Named Component" then
  TextIn("Kick Component", "Input")
  TextIn("Kick Control", "Input")
  if opt.Bands == 2 then
    TextIn("Snare Component", "Input")
    TextIn("Snare Control", "Input")
  end
end
if opt.Bands == 2 then
  Num("Snare Weight", "Percent", 0, 100, 50)
  Meter("Snare Meter", -60, 0)
end
Num("BPM Min", "Integer", 40, 200, 80)
Num("BPM Max", "Integer", 60, 300, 160)
Num("Sensitivity", "Percent", 0, 100, 50)
Num("Min Confidence", "Percent", 0, 100, 50)
Num("Beat Offset", "Integer", -200, 200, 0)   -- ms, positive = beat LED earlier

-- Console output
Add({ Name = "Status", ControlType = "Indicator", IndicatorType = "Status", PinStyle = "Output" })
if opt.Console ~= "None" then
  Toggle("Send Enable", true)
  Trigger("Send Now")
  TextOut("Last Sent")
  TextIn("IP Address")
  Num("Port", "Integer", 0, 65535, opt.Console == "grandMA2" and 30000 or 8000)
  if opt.Console == "grandMA2" then
    TextIn("Username")
    TextIn("Password", "Input")
    Led("Connected")
    Led("Logged In")
    Trigger("Reconnect")
  else
    TextIn("OSC Prefix")
  end
  Num("Speed Master", "Integer", 1, 16, 1)
  TextIn("Command Template")
  Num("Send Hysteresis", "Float", 0.1, 5, 0.5)
  Toggle("Whole BPM", true)   -- send whole numbers (DJ tracks are almost always on whole BPM)
  TextOut("Last Command")
  TextOut("Last Reply")
end
TextOut("Last Error")

-- Debug
TextOut("Level Updates")
Led("Onset")
Meter("Onset Strength", 0, 40)
TextOut("Onset Threshold")
TextOut("Onset Count")
TextOut("Tempo Candidates")
if opt.LevelSource == "Test Generator" then
  Num("Test BPM", "Float", 40, 220, 128)
  Num("Test Jitter", "Integer", 0, 60, 5)          -- ms
  Num("Test Dropout", "Percent", 0, 80, 10)
  Num("Test Update", "Integer", 10, 100, 20)       -- simulated meter update interval, ms
  Toggle("Test Breakdown", false)
end
-- <<< controls.lua
  return ctrls
end

function GetControlLayout(props)
  local layout, graphics = {}, {}
  local CurrentPage = PageNames[props["page_index"].Value] or "Control"
  -- >>> layout.lua
-- (c) levo AVL | Elias Jenny - MIT License
local C = LevoBrand.Colors
local opt = Options(props)
local hasConsole = opt.Console ~= "None"
local W = 520
local M = 16  -- page margin

-- Content is collected first; background and header go underneath once the page
-- height is known.
local items = {}

local function Label(text, x, y, w, h, o)
  o = o or {}
  table.insert(items, {
    Type = "Text", Text = text, Position = { x, y }, Size = { w, h or 18 },
    FontSize = o.size or 11, FontStyle = o.style or "Regular",
    HTextAlign = o.align or "Left", Color = o.color or C.Onyx,
  })
end

local function Section(text, y)
  Label(text, M, y, W - 2 * M, 20, { size = 13, style = "Bold", color = C.Atlantic })
  table.insert(items, {
    Type = "GroupBox", Fill = C.Amber, StrokeWidth = 0, CornerRadius = 0,
    Position = { M, y + 20 }, Size = { W - 2 * M, 2 },
  })
  return y + 30
end

local function Place(name, pretty, x, y, w, h, extra)
  local def = { PrettyName = pretty, Position = { x, y }, Size = { w, h } }
  for k, v in pairs(extra or {}) do def[k] = v end
  layout[name] = def
end

-- read-only text that should look like a label, not like a field
local function Flat(extra)
  local t = { Style = "Text", Color = C.Porcelain, StrokeWidth = 0, CornerRadius = 0, TextColor = C.Onyx }
  for k, v in pairs(extra or {}) do t[k] = v end
  return t
end

-- label left, control right; returns next y
local LW = 150
local function Row(label, name, pretty, y, w, extra, h)
  h = h or 20
  Label(label, M, y + (h - 18) // 2, LW - 8, 18, { align = "Right" })
  Place(name, pretty, M + LW, y, w, h, extra)
  return y + h + 6
end

local function Field(extra)
  local t = { Style = "Text", FontSize = 11 }
  for k, v in pairs(extra or {}) do t[k] = v end
  return t
end

local function Button(legend, extra)
  local t = { Style = "Button", Legend = legend, FontSize = 11, Color = C.Atlantic }
  for k, v in pairs(extra or {}) do t[k] = v end
  return t
end

local y = LevoBrand.HeaderHeight + 2 + 12

if CurrentPage == "Control" then
  -- Tempo overview
  y = Section("Tempo", y)
  Place("BPM Text", "Tempo~BPM", M, y, 250, 72, Flat({ FontSize = 56, FontStyle = "Bold", HTextAlign = "Left" }))
  Label("BPM", M + 4, y + 70, 60, 16, { size = 10, color = C.Mid })
  Place("Beat", "Tempo~Beat", W - M - 84, y + 2, 72, 72, { Color = C.Amber })
  Label("Beat", W - M - 84, y + 76, 72, 16, { size = 10, color = C.Mid, align = "Center" })
  y = y + 98
  -- bar position 1..4
  Label("Bar", M, y, 40, 22, { color = C.Mid })
  for i = 1, 4 do
    local x = M + 44 + (i - 1) * 44
    Place("Bar " .. i, "Tempo~Bar " .. i, x, y, 22, 22, { Color = i == 1 and C.Amber or C.Atlantic })
    Label(tostring(i), x - 4, y + 22, 30, 14, { size = 10, color = C.Mid, align = "Center" })
  end
  Place("Locked", "Tempo~Locked", W - M - 150, y + 2, 18, 18, { Color = C.Atlantic })
  Place("Detection State", "Tempo~Detection State", W - M - 126, y, 126, 22, Flat({ FontSize = 12, FontStyle = "Bold", HTextAlign = "Left" }))
  y = y + 44
  Label("Confidence", M, y, 80, 18, { color = C.Mid })
  Place("Confidence", "Tempo~Confidence", M + 84, y + 3, 180, 12, { Color = C.Atlantic, ShowTextbox = false, CornerRadius = 0 })
  Label("Kick", W - M - 200, y, 44, 18, { color = C.Mid, align = "Right" })
  Place("Kick Meter", "Tempo~Kick Meter", W - M - 150, y + 3, 150, 12, { Color = C.Amber, ShowTextbox = false, CornerRadius = 0 })
  y = y + 30

  -- Manual control
  y = Section("Tempo Control", y)
  Place("Tap", "Tempo Control~Tap", M, y, 110, 52, Button("TAP", { FontSize = 16, FontStyle = "Bold", Color = C.Amber }))
  local bx, bw = M + 122, 84
  Place("Resync", "Tempo Control~Resync", bx, y, bw, 24, Button("Resync"))
  Place("Shift Half Beat", "Tempo Control~Shift Half Beat", bx + bw + 8, y, bw, 24, Button("Shift ½"))
  Place("Auto", "Tempo Control~Auto", bx + 2 * (bw + 8), y, bw, 24, Button("Auto", { Color = C.Amber }))
  Place("Half", "Tempo Control~Half", bx, y + 28, bw, 24, Button("½ Tempo"))
  Place("Double", "Tempo Control~Double", bx + bw + 8, y + 28, bw, 24, Button("2× Tempo"))
  Place("Hold", "Tempo Control~Hold", bx + 2 * (bw + 8), y + 28, bw, 24, Button("Hold", { Color = C.Amber }))
  Place("Tempo Scale", "Tempo Control~Tempo Scale", W - M - 40, y + 28, 40, 24, Flat({ FontSize = 11, HTextAlign = "Center", TextColor = C.Mid }))
  y = y + 66

  -- Console
  y = Section(hasConsole and opt.Console or "Output", y)
  if hasConsole then
    Place("Send Enable", "Console~Send Enable", M, y, 110, 24, Button("Send Tempo", { Color = C.Amber }))
    Place("Send Now", "Console~Send Now", M + 118, y, 84, 24, Button("Send Now"))
    Label("Last sent", M + 214, y + 3, 64, 18, { color = C.Mid })
    Place("Last Sent", "Console~Last Sent", M + 280, y, W - 2 * M - 280, 24, Flat({ FontSize = 13, FontStyle = "Bold", HTextAlign = "Left" }))
    y = y + 32
  end
  Place("Status", "Status", M, y, W - 2 * M, 22)
  y = y + 34

elseif CurrentPage == "Setup" then
  y = Section("Level Input", y)
  if opt.LevelSource == "Wired Pin" then
    y = Row("Kick Level (dB)", "Kick Level", "Level Input~Kick Level", y, 80, { Style = "Text", FontSize = 11 })
    Label("Wire a meter's output pin here (kick band, e.g. 45-120 Hz).", M + LW, y - 4, W - M - LW - M, 16, { size = 10, color = C.Mid })
    y = y + 16
    if opt.Bands == 2 then
      y = Row("Snare Level (dB)", "Snare Level", "Level Input~Snare Level", y, 80, { Style = "Text", FontSize = 11 })
      Label("Snare band, e.g. 150-400 Hz (a hi-hat band works too).", M + LW, y - 4, W - M - LW - M, 16, { size = 10, color = C.Mid })
      y = y + 16
    end
  elseif opt.LevelSource == "Named Component" then
    y = Row("Kick Component", "Kick Component", "Level Input~Kick Component", y, 200, Field())
    y = Row("Kick Control", "Kick Control", "Level Input~Kick Control", y, 200, Field())
    Label("Code Name of the meter, Script Access enabled. Control: e.g. meter.1", M + LW, y - 4, W - M - LW - M, 16, { size = 10, color = C.Mid })
    y = y + 16
    if opt.Bands == 2 then
      y = Row("Snare Component", "Snare Component", "Level Input~Snare Component", y, 200, Field())
      y = Row("Snare Control", "Snare Control", "Level Input~Snare Control", y, 200, Field())
    end
  else
    Label("Test Generator active - settings on the Debug page.", M + LW, y, W - M - LW - M, 18, { color = C.Mid })
    y = y + 26
  end
  if opt.Bands == 2 then
    y = Row("Snare Weight", "Snare Weight", "Level Input~Snare Weight", y, 180, { Style = "Fader", Color = C.Atlantic })
    Label("Snare", M + LW + 190, y - 26, 50, 18, { color = C.Mid })
    Place("Snare Meter", "Level Input~Snare Meter", M + LW + 240, y - 23, W - 2 * M - LW - 240, 12, { Color = C.Amber, ShowTextbox = false, CornerRadius = 0 })
  end
  y = y + 6

  y = Section("Detection", y)
  y = Row("BPM Min", "BPM Min", "Detection~BPM Min", y, 80, Field())
  y = Row("BPM Max", "BPM Max", "Detection~BPM Max", y, 80, Field())
  y = Row("Sensitivity", "Sensitivity", "Detection~Sensitivity", y, 180, { Style = "Fader", Color = C.Atlantic })
  y = Row("Min Confidence", "Min Confidence", "Detection~Min Confidence", y, 180, { Style = "Fader", Color = C.Atlantic })
  y = Row("Beat Offset (ms)", "Beat Offset", "Detection~Beat Offset", y, 80, Field())
  Label("Positive = beat earlier (compensates meter latency).", M + LW, y - 4, W - M - LW - M, 16, { size = 10, color = C.Mid })
  y = y + 22

  if hasConsole then
    y = Section(opt.Console .. (opt.Console == "grandMA2" and " (Telnet)" or " (OSC)"), y)
    y = Row("IP Address", "IP Address", "Console~IP Address", y, 160, Field())
    y = Row("Port", "Port", "Console~Port", y, 80, Field())
    if opt.Console == "grandMA2" then
      y = Row("Username", "Username", "Console~Username", y, 160, Field())
      y = Row("Password", "Password", "Console~Password", y, 160, Field())
    else
      y = Row("OSC Prefix", "OSC Prefix", "Console~OSC Prefix", y, 160, Field())
    end
    y = Row("Speed Master", "Speed Master", "Console~Speed Master", y, 80, Field())
    y = Row("Command", "Command Template", "Console~Command Template", y, W - M - LW - M, Field())
    Label("{master} and {bpm} are replaced.", M + LW, y - 4, W - M - LW - M, 16, { size = 10, color = C.Mid })
    y = y + 16
    y = Row("Send Hysteresis", "Send Hysteresis", "Console~Send Hysteresis", y, 80, Field())
    y = Row("Whole BPM", "Whole BPM", "Console~Whole BPM", y, 80, Button("Whole BPM", { Color = C.Amber }))
    if opt.Console == "grandMA2" then
      Label("Connected", M + LW, y, 70, 18)
      Place("Connected", "Console~Connected", M + LW + 72, y + 1, 16, 16, { Color = C.Atlantic })
      Label("Logged in", M + LW + 100, y, 70, 18)
      Place("Logged In", "Console~Logged In", M + LW + 172, y + 1, 16, 16, { Color = C.Atlantic })
      Place("Reconnect", "Console~Reconnect", W - M - 90, y - 2, 90, 22, Button("Reconnect"))
      y = y + 28
    end
  end
  Place("Status", "Status", M, y, W - 2 * M, 22)
  y = y + 34

elseif CurrentPage == "Debug" then
  y = Section("Analysis", y)
  y = Row("Level Updates", "Level Updates", "Debug~Level Updates", y, 240, Flat({ HTextAlign = "Left" }))
  Label("Onset", M, y, LW - 8, 18, { align = "Right" })
  Place("Onset", "Debug~Onset", M + LW, y + 1, 16, 16, { Color = C.Amber })
  y = y + 26
  y = Row("Onset Strength", "Onset Strength", "Debug~Onset Strength", y, 240, { Color = C.Atlantic, ShowTextbox = false, CornerRadius = 0 }, 14)
  y = Row("Threshold", "Onset Threshold", "Debug~Onset Threshold", y, 120, Flat({ HTextAlign = "Left" }))
  y = Row("Onsets", "Onset Count", "Debug~Onset Count", y, 120, Flat({ HTextAlign = "Left" }))
  y = Row("Tempo Candidates", "Tempo Candidates", "Debug~Tempo Candidates", y, W - M - LW - M, Flat({ HTextAlign = "Left" }))
  y = Row("Bar Position", "Bar Position", "Debug~Bar Position", y, 60, Field())
  y = Row("BPM (value)", "BPM", "Debug~BPM", y, 80, Field())
  y = Row("Downbeat", "Downbeat", "Debug~Downbeat", y, 16, { Color = C.Amber }, 16)
  y = y + 6

  y = Section("Messages", y)
  if hasConsole then
    y = Row("Last Command", "Last Command", "Debug~Last Command", y, W - M - LW - M, Flat({ HTextAlign = "Left" }))
    y = Row("Last Reply", "Last Reply", "Debug~Last Reply", y, W - M - LW - M, Flat({ HTextAlign = "Left" }))
  end
  y = Row("Last Error", "Last Error", "Debug~Last Error", y, W - M - LW - M, Flat({ HTextAlign = "Left" }))
  y = y + 6

  if opt.LevelSource == "Test Generator" then
    y = Section("Test Generator", y)
    y = Row("Test BPM", "Test BPM", "Test Generator~Test BPM", y, 80, Field())
    y = Row("Jitter (ms)", "Test Jitter", "Test Generator~Test Jitter", y, 80, Field())
    y = Row("Dropout", "Test Dropout", "Test Generator~Test Dropout", y, 80, Field())
    y = Row("Meter Update (ms)", "Test Update", "Test Generator~Test Update", y, 80, Field())
    y = Row("Breakdown", "Test Breakdown", "Test Generator~Test Breakdown", y, 90, Button("Breakdown", { Color = C.Amber }))
  end
  y = y + 10

elseif CurrentPage == "About" then
  y = LevoBrand.About(items, M, y, W - 2 * M, PluginInfo) + 16
end

-- background and header underneath the content
local H = math.max(y, 300)
LevoBrand.Background(graphics, W, H)
LevoBrand.Header(graphics, W, LevoBrand.PluginName(PluginInfo), CurrentPage)
for _, g in ipairs(items) do table.insert(graphics, g) end
-- <<< layout.lua
  return layout, graphics
end

if Controls then
  -- >>> beat_engine.lua
-- (c) levo AVL | Elias Jenny - MIT License
--
-- Beat Analyzer beat engine. Pure Lua 5.3, no Q-SYS APIs, so it can be tested offline.
-- All functions take the time `t` in seconds from a monotonic clock.
--
-- Signal path:
--   level (dB, low band)  ->  onset detection  ->  tempo histogram  ->  beat clock (PLL)
--
-- Onset detection works in the dB domain: the onset strength is how far the level
-- rose above its minimum of the last ~120 ms. Working in dB makes it independent of
-- the overall volume (no gain tracking needed). The threshold adapts to the running
-- mean and spread of the strength, with a floor set by the sensitivity.
--
-- Tempo: every onset votes for the intervals to its last few predecessors, folded
-- into the BPM range by octaves, into a decaying histogram. The peak is the tempo,
-- the share of all votes near the peak is the confidence.
--
-- Beat clock: free-running oscillator. Onsets close to a predicted beat pull its phase;
-- a linear regression over the last on-beat onsets refines the period far below the
-- meter update resolution. The beat keeps going through breakdowns, and single missed
-- or extra kicks barely move it.

BeatEngine = {}
BeatEngine.__index = BeatEngine

local BIN = 0.5             -- histogram resolution in BPM
local SPREAD = 2            -- minimum vote spread in bins (gaussian sigma)
local HIST_TAU = 6          -- histogram decay time constant (s)
local MIN_WINDOW = 0.12     -- window for the level minimum (s)
local STAT_TAU = 2.0        -- time constant of the strength statistics (s)
local GATE_DB = -60         -- below this the input counts as silence
local MAX_IOI = 2.5         -- intervals longer than this are ignored (s)
local LOCK_TIMEOUT = 2.0    -- no onset for this long -> free running (s)
local TAP_RESET = 2.0       -- tap gap that starts a new tap sequence (s)
local TAP_HOLD = 4.0        -- detection does not correct the clock this long after a tap (s)
local PHASE_GAIN = 0.15     -- phase correction per on-beat onset
local FIT_MIN = 8           -- on-beat onsets needed before the regression sets the tempo
local FIT_MAX = 32          -- on-beat onsets kept for the regression
local FIT_AGE = 16          -- ... and not older than this (s)
local PERIOD_SPAN = 0.04    -- PLL period may deviate this much from the histogram tempo
local OFFBEAT_DB = 1.5      -- offbeat onsets this much louder (on average) -> the clock is on the offbeat
local JUMP_BPM = 4          -- histogram tempo this far off -> tempo change
local JUMP_CONFIRM = 6      -- ... confirmed by this many onsets in a row
-- Weight of the interval to the k-th previous onset. Only k = 1 and 2: further back,
-- missed kicks make the interval an odd number of beats (3, 5), which folds to a wrong
-- tempo (3/2, 5/4) and can win the histogram when meter updates are coarse.
local IOI_WEIGHTS = { 1.0, 0.5 }

local function clamp(x, a, b) if x < a then return a elseif x > b then return b else return x end end
local function lerp(a, b, f) return a + (b - a) * f end

function BeatEngine.New(cfg)
  local self = setmetatable({}, BeatEngine)
  self:Configure(cfg or {})
  self:Reset()
  return self
end

-- cfg: bpmMin, bpmMax, sensitivity (0..1), minConfidence (0..1)
function BeatEngine:Configure(cfg)
  local lo = clamp(tonumber(cfg.bpmMin) or 80, 30, 300)
  local hi = clamp(tonumber(cfg.bpmMax) or 160, 30, 300)
  if hi < lo * 2 then hi = lo * 2 end   -- folding by octaves needs at least one octave
  local changed = (lo ~= self.bpmMin or hi ~= self.bpmMax)
  self.bpmMin, self.bpmMax = lo, hi
  self.sensitivity = clamp(tonumber(cfg.sensitivity) or 0.5, 0, 1)
  self.minConfidence = clamp(tonumber(cfg.minConfidence) or 0.35, 0, 1)
  if changed and self.hist then self:ClearTempo() end
end

function BeatEngine:Reset()
  self.levels = {}          -- { t, db } of the last MIN_WINDOW
  self.levels2 = {}         -- same for the second band
  self.strength = 0
  self.statMean, self.statVar = 1, 1
  self.armed = true
  self.lastOnset = -100
  self.onsets = {}          -- recent onset times
  self.onsetCount = 0
  self.onsetDb, self.onsetOpenUntil = -100, nil
  self.threshold = 0
  self.lastLevelT = nil
  self.lastDb, self.lastChangeT = nil, nil
  self.updateInterval = 0.02  -- measured interval between level changes (s)
  self:ClearTempo()
  -- clock
  self.period = nil         -- detected beat period (s), before scale
  self.nextBeat = nil
  self.beatNo = 0           -- absolute number of `nextBeat`
  self.fit = {}             -- onsets { n = beat number, t, on, db } for the regression
  self.gridHits = {}        -- did the last onsets fit the clock grid?
  self.bar = 0
  self.scale = 1
  self.hold = false
  self.auto = true
  self.taps = {}
  self.tapUntil = -100
  self.resyncPending = false
  self.everLocked = false
  self.silentSince = nil
end

function BeatEngine:ClearTempo()
  local n = math.floor((self.bpmMax - self.bpmMin) / BIN + 0.5) + 1
  self.hist, self.histN = {}, n
  for i = 1, n do self.hist[i] = 0 end
  self.histT = nil
  self.histBpm, self.confidence, self.histMass = nil, 0, 0
  self.jumpCount = 0
  self.refined = false      -- tempo refined by the regression (not only the histogram)
end

---------------------------------------------------------------------------
-- Histogram
---------------------------------------------------------------------------
function BeatEngine:Decay(t)
  if self.histT then
    local f = math.exp(-(t - self.histT) / HIST_TAU)
    if f < 0.9999 then
      for i = 1, self.histN do self.hist[i] = self.hist[i] * f end
    end
  end
  self.histT = t
end

function BeatEngine:Fold(bpm)
  if bpm <= 0 then return nil end
  while bpm < self.bpmMin do bpm = bpm * 2 end
  while bpm > self.bpmMax do bpm = bpm / 2 end
  if bpm < self.bpmMin then return nil end
  return bpm
end

-- One tempo vote. `sigma` is the uncertainty of the vote in BPM; precise votes are
-- narrow and high, imprecise ones wide and flat (same total weight).
function BeatEngine:Vote(bpm, weight, sigma)
  local raw = bpm
  bpm = self:Fold(bpm)
  if not bpm then return end
  sigma = (sigma or 0) * bpm / raw                     -- folding scales the uncertainty too
  local sb = math.max(SPREAD, sigma / BIN)             -- sigma in bins
  local pos = (bpm - self.bpmMin) / BIN + 1
  local c = math.floor(pos + 0.5)
  local w = clamp(weight * SPREAD / sb, 0, weight)     -- keep the area constant
  local reach = math.ceil(2.5 * sb)
  for i = c - reach, c + reach do
    if i >= 1 and i <= self.histN then
      local d = (i - pos) / sb
      self.hist[i] = self.hist[i] + w * math.exp(-0.5 * d * d)
    end
  end
end

-- Peak, confidence and the strongest other candidates
function BeatEngine:Analyse()
  local h, n = self.hist, self.histN
  local best, bi, total = 0, nil, 0
  for i = 1, n do
    total = total + h[i]
    if h[i] > best then best, bi = h[i], i end
  end
  self.histMass = total
  if not bi or total <= 0 then
    self.histBpm, self.confidence = nil, 0
    return
  end
  -- weighted centre around the peak for sub-bin precision
  local sw, sx, near = 0, 0, 0
  for i = math.max(1, bi - 2), math.min(n, bi + 2) do
    sw = sw + h[i]; sx = sx + h[i] * i
  end
  -- the peak is as wide as a single vote: measure its share over that width
  local peakBpm = self.bpmMin + (bi - 1) * BIN
  local dt = math.max(0.01, self.updateInterval * 0.6)
  local sigma2 = peakBpm * dt / (2 * 60 / peakBpm) / BIN      -- two-beat interval, in bins
  local win = math.ceil(math.max(2 * SPREAD, 2 * sigma2))
  for i = math.max(1, bi - win), math.min(n, bi + win) do near = near + h[i] end
  self.histBpm = self.bpmMin + (sx / sw - 1) * BIN
  -- the peak's share of all votes; a clean 4/4 track reaches ~0.5..0.8
  self.confidence = clamp(near / total * 1.4, 0, 1)
  -- a few votes are not enough, whatever the share
  self.confidence = self.confidence * clamp(total / 8, 0, 1)
end

-- Up to `count` histogram peaks as { bpm, share }
function BeatEngine:Candidates(count)
  local h, n, out = self.hist, self.histN, {}
  local total = self.histMass > 0 and self.histMass or 1
  for i = 2, n - 1 do
    if h[i] > 0.01 and h[i] >= h[i - 1] and h[i] > h[i + 1] then
      out[#out + 1] = { bpm = self.bpmMin + (i - 1) * BIN, share = h[i] / total }
    end
  end
  table.sort(out, function(a, b) return a.share > b.share end)
  while #out > (count or 3) do table.remove(out) end
  return out
end

---------------------------------------------------------------------------
-- Onset detection
---------------------------------------------------------------------------
-- Rise of `db` above its minimum over the last MIN_WINDOW, per band
local function Rise(list, t, db)
  list[#list + 1] = { t, db }
  while #list > 1 and list[1][1] < t - MIN_WINDOW do table.remove(list, 1) end
  local minDb = db
  for i = 1, #list do if list[i][2] < minDb then minDb = list[i][2] end end
  return db - minDb
end

-- Feed the current level (dB) of the kick band, and optionally of a second band
-- (e.g. snare) with its weight 0..1. The onset strength is the weighted sum of the
-- rises of both bands - like a two-band spectral flux. Returns true on an onset.
function BeatEngine:Feed(t, db, db2, weight2)
  db = tonumber(db) or -100
  local s = Rise(self.levels, t, db)
  local gateDb = db
  db2 = tonumber(db2)
  if db2 and (weight2 or 0) > 0 then
    self.levels2 = self.levels2 or {}
    local s2 = db2 >= GATE_DB and Rise(self.levels2, t, db2) or 0
    s = s + weight2 * s2
    gateDb = math.max(db, db2)   -- band 2 alone keeps the gate open
  end
  self.strength = s

  -- strength statistics (exponential, time based so the tick rate does not matter)
  local dt = self.lastLevelT and clamp(t - self.lastLevelT, 0, 0.5) or 0
  self.lastLevelT = t
  if db ~= self.lastDb then
    if self.lastChangeT then
      local iv = clamp(t - self.lastChangeT, 0.005, 0.2)
      self.updateInterval = self.updateInterval + 0.05 * (iv - self.updateInterval)
    end
    self.lastDb, self.lastChangeT = db, t
  end
  local a = 1 - math.exp(-dt / STAT_TAU)
  -- statistics of the background only: onsets are capped at the threshold, otherwise
  -- the kicks themselves would raise the threshold above the kicks
  local floor = lerp(10, 3, self.sensitivity)
  local x = math.min(s, 2 * floor)
  local diff = x - self.statMean
  self.statMean = self.statMean + a * diff
  self.statVar = (1 - a) * (self.statVar + a * diff * diff)

  -- threshold: adaptive, with a floor given by the sensitivity
  local k = lerp(3.0, 1.0, self.sensitivity)
  local thr = math.max(floor, self.statMean + k * math.sqrt(self.statVar))
  self.threshold = thr

  if gateDb < GATE_DB then
    self.silentSince = self.silentSince or t
  else
    self.silentSince = nil
  end

  if self.onsetOpenUntil and t <= self.onsetOpenUntil and db > self.onsetDb then
    self.onsetDb = db
    local last = self.fit[#self.fit]
    if last and last.t == self.lastOnset then last.db = db end
  end
  if s < thr * 0.5 then self.armed = true end
  local refractory = 0.6 * 60 / self.bpmMax
  if self.armed and s >= thr and gateDb >= GATE_DB and (t - self.lastOnset) >= refractory then
    self.armed = false
    -- loudest level of this onset (the meter may still rise in the next updates)
    self.onsetDb = db
    self.onsetOpenUntil = t + 0.06
    self:OnOnset(t)
    return true
  end
  return false
end

function BeatEngine:OnOnset(t)
  self.lastOnset = t
  self.onsetCount = self.onsetCount + 1
  if self.hold then return end

  -- tempo votes
  self:Decay(t)
  local on = self.onsets
  for k = 1, #IOI_WEIGHTS do
    local prev = on[#on - k + 1]
    if not prev then break end
    local d = t - prev
    if d > MAX_IOI then break end
    if IOI_WEIGHTS[k] > 0 then
      -- timing of each onset is uncertain by about one meter update
      local dt = math.max(0.01, self.updateInterval * 0.6)
      self:Vote(60 / d, IOI_WEIGHTS[k], 60 / d * dt / d)
    end
  end
  on[#on + 1] = t
  while #on > 8 do table.remove(on, 1) end
  self:Analyse()
  self:FollowTempo(t)

  -- phase
  if self.resyncPending then
    self.resyncPending = false
    if self.period then
      self.nextBeat = t
      self.bar = 0
      self.fit = {}
    end
    return
  end
  if self.auto and t >= self.tapUntil then self:CorrectPhase(t) end
end

-- Take over the histogram tempo into the clock
function BeatEngine:FollowTempo(t)
  if not self.auto or t < self.tapUntil then return end
  local bpm = self.histBpm
  if not bpm or self.confidence < self.minConfidence * 0.7 then return end
  if not self.period then
    self.period = 60 / bpm
    self.nextBeat = t + self.period
    self.bar = 0
    self.fit = {}
    return
  end
  local cur = 60 / self.period
  local fitting = 0
  for _, h in ipairs(self.gridHits) do if h then fitting = fitting + 1 end end
  local stillFits = #self.gridHits >= 6 and fitting / #self.gridHits >= 0.6
  if math.abs(bpm - cur) > JUMP_BPM and self.confidence >= self.minConfidence and not stillFits then
    self.jumpCount = self.jumpCount + 1
    if self.jumpCount >= JUMP_CONFIRM then
      self.period = 60 / bpm
      self.jumpCount = 0
      self.fit, self.gridHits = {}, {}
      self.refined = false
    end
  else
    self.jumpCount = 0
    -- keep the PLL period inside a narrow band around the histogram tempo
    local p0 = 60 / bpm
    self.period = clamp(self.period, p0 * (1 - PERIOD_SPAN), p0 * (1 + PERIOD_SPAN))
  end
end

function BeatEngine:ClockPeriod()
  return self.period and self.period / self.scale or nil
end

function BeatEngine:CorrectPhase(t)
  local P = self:ClockPeriod()
  if not P or not self.nextBeat then return end
  -- Onsets are placed on a half-beat grid: with a folded tempo (e.g. 174 BPM shown
  -- as 87) or offbeat bass, onsets land between the beats - still exact timing.
  -- The beat number is counted from the previous onset, not read off the clock, so a
  -- clock that is still slightly off cannot shift the numbering.
  local half = P / 2
  local fit = self.fit
  local last = fit[#fit]
  local n
  if last and t - last.t < 4 then
    local x = (t - last.t) / half
    local h = math.floor(x + 0.5)
    if h < 1 or math.abs(x - h) > 0.35 then return end   -- off the grid (syncopation)
    n = last.n + h / 2
  else
    -- `nextBeat` may already lie in the past by less than one tick
    local k2 = math.floor((t - self.nextBeat) / half + 0.5)
    n = self.beatNo + k2 / 2
  end
  local onBeat = (n % 1 == 0)
  -- does the onset still fit the running clock? (guards against false tempo jumps)
  local eh = (t - self.nextBeat) / half
  eh = eh - math.floor(eh + 0.5)
  local hits = self.gridHits
  hits[#hits + 1] = math.abs(eh) < 0.3
  while #hits > 8 do table.remove(hits, 1) end
  -- only on-beat onsets pull the phase, otherwise the clock could slide onto the offbeat
  if onBeat then
    local e = t - (self.nextBeat + (n - self.beatNo) * P)
    if math.abs(e) < 0.25 * P then self.nextBeat = self.nextBeat + PHASE_GAIN * e end
  end

  -- Tempo by linear regression over the recent onsets: t = a + b * n. Single onsets
  -- are only as exact as the meter update rate; the fit over many beats averages that out.
  fit[#fit + 1] = { n = n, t = t, on = onBeat, db = self.onsetDb }
  while #fit > FIT_MAX or (#fit > 0 and fit[1].t < t - FIT_AGE) do table.remove(fit, 1) end
  if #fit < FIT_MIN then return end
  -- The clock sits on the offbeat when clearly more onsets fall between the beats than
  -- on them, or - with about as many on both (kick vs. offbeat bass) - when the onsets
  -- between the beats are clearly louder in the kick band.
  local nOn, nOff, dbOn, dbOff = 0, 0, 0, 0
  for _, p in ipairs(fit) do
    if p.on then nOn = nOn + 1; dbOn = dbOn + p.db else nOff = nOff + 1; dbOff = dbOff + p.db end
  end
  local moreOff = nOff > 1.4 * nOn + 1
  local comparable = nOn >= 6 and nOff >= 6 and nOff >= 0.7 * nOn and nOn >= 0.7 * nOff
  local louderOff = comparable and (dbOff / nOff) > (dbOn / nOn) + OFFBEAT_DB
  if (moreOff or louderOff) and t >= (self.noFlipUntil or 0) then
    -- renumber instead of starting over: the timing data stays valid
    self.nextBeat = self.nextBeat + half
    for _, p in ipairs(fit) do p.n = p.n - 0.5; p.on = not p.on end
    return
  end
  local sn, st, snn, snt = 0, 0, 0, 0
  for _, p in ipairs(fit) do sn = sn + p.n; st = st + p.t end
  local mn, mt = sn / #fit, st / #fit
  for _, p in ipairs(fit) do
    local dn = p.n - mn
    snn = snn + dn * dn; snt = snt + dn * (p.t - mt)
  end
  if snn <= 0 then return end
  local b = snt / snn                  -- clock period
  local period = b * self.scale        -- detected (unscaled) period
  if self.histBpm then
    local p0 = 60 / self.histBpm
    if period < p0 * (1 - PERIOD_SPAN) or period > p0 * (1 + PERIOD_SPAN) then return end
  end
  self.period = period
  self.refined = true
  -- move the phase towards the fitted grid as well
  local fitted = mt + (self.beatNo - mn) * b
  self.nextBeat = self.nextBeat + 0.3 * (fitted - self.nextBeat)
end

---------------------------------------------------------------------------
-- Clock: call every tick. Returns list of beat events { bar = 1..4 }.
---------------------------------------------------------------------------
function BeatEngine:Update(t, lead)
  local events = {}
  local P = self:ClockPeriod()
  if not P or not self.nextBeat then return events end
  lead = lead or 0
  -- catch up after a long pause without firing a burst of beats
  if t + lead - self.nextBeat > 4 * P then
    local skip = math.floor((t + lead - self.nextBeat) / P)
    self.nextBeat = self.nextBeat + skip * P
    self.beatNo = self.beatNo + skip
    self.bar = (self.bar + skip) % 4
  end
  while t + lead >= self.nextBeat do
    self.bar = self.bar % 4 + 1
    events[#events + 1] = { bar = self.bar, time = self.nextBeat }
    self.nextBeat = self.nextBeat + P
    self.beatNo = self.beatNo + 1
  end
  return events
end

---------------------------------------------------------------------------
-- User functions
---------------------------------------------------------------------------
function BeatEngine:Tap(t)
  local taps = self.taps
  if #taps > 0 and t - taps[#taps] > TAP_RESET then self.taps = {}; taps = self.taps end
  taps[#taps + 1] = t
  while #taps > 7 do table.remove(taps, 1) end
  if #taps < 2 then return end
  local iv = {}
  for i = 2, #taps do iv[#iv + 1] = taps[i] - taps[i - 1] end
  table.sort(iv)
  local p = iv[(#iv + 1) // 2]
  if #iv % 2 == 0 then p = (iv[#iv // 2] + iv[#iv // 2 + 1]) / 2 end
  self.period = p * self.scale     -- tapped tempo is what the user hears / wants
  self.nextBeat = t + p
  self.fit = {}
  -- the first tap of a sequence is the downbeat
  self.bar = (#taps - 1) % 4
  self.tapUntil = t + TAP_HOLD
  if self.auto then
    -- hint for the detection: strengthens the tapped octave
    self:Decay(t)
    self:Vote(60 / self.period, 3)
    self:Analyse()
  end
end

-- Next onset (or now, without signal) becomes beat 1
function BeatEngine:Resync(t)
  if not self.period then return end
  self.fit = {}
  if self.silentSince or (t - self.lastOnset) > LOCK_TIMEOUT then
    self.nextBeat = t
    self.bar = 0
  else
    self.resyncPending = true
  end
end

-- Move the beat by half a beat (clock sits on the offbeat)
function BeatEngine:ShiftHalf()
  local P = self:ClockPeriod()
  if not P or not self.nextBeat then return end
  self.nextBeat = self.nextBeat + P / 2
  for _, p in ipairs(self.fit) do p.n = p.n - 0.5; p.on = not p.on end
  self.noFlipUntil = (self.lastLevelT or 0) + 30   -- the user decided: no automatic flip back
end

function BeatEngine:SetScale(f)
  self.scale = clamp(f, 0.25, 4)
  self.fit = {}
end

function BeatEngine:SetHold(b) self.hold = b and true or false end
function BeatEngine:SetAuto(b) self.auto = b and true or false end

---------------------------------------------------------------------------
-- Readout
---------------------------------------------------------------------------
function BeatEngine:Bpm()
  local P = self:ClockPeriod()
  return P and 60 / P or nil
end

-- Tempo good enough to send to a console: refined by the regression, tapped or manual
function BeatEngine:IsPrecise(t)
  if not self:IsLocked(t) then return false end
  return self.refined or t < self.tapUntil or not self.auto
end

function BeatEngine:IsLocked(t)
  if self.hold or not self.period then return false end
  if t < self.tapUntil then return true end
  if not self.auto then return true end
  return self.confidence >= self.minConfidence and (t - self.lastOnset) <= LOCK_TIMEOUT
end

-- "No Signal" | "Searching" | "Locked" | "Free Running" | "Hold" | "Tap" | "Manual"
function BeatEngine:State(t)
  if self.hold then return "Hold" end
  if t < self.tapUntil then return "Tap" end
  if not self.auto then return self.period and "Manual" or "No Tempo" end
  if self:IsLocked(t) then self.everLocked = true; return "Locked" end
  if self.period and self.everLocked then return "Free Running" end
  if self.silentSince and t - self.silentSince > 2 then return "No Signal" end
  return "Searching"
end
-- <<< beat_engine.lua
  -- >>> ma_output.lua
-- (c) levo AVL | Elias Jenny - MIT License
--
-- Command-line output to MA consoles.
--   grandMA2: Telnet (TCP, default port 30000), login with user/password, replies are
--             read line by line (Telnet negotiation and ANSI codes stripped).
--   grandMA3: OSC over UDP (default port 8000), address "/cmd" or "/<prefix>/cmd",
--             type string. MA3 sends no reply - "sent" is all we can know.
--
-- Commands are queued with a coalescing key (a newer tempo replaces a pending one) and
-- sent no faster than MIN_SPACING. Reconnect with backoff is handled here.
--
--   local out = MAOutput.New("grandMA2", {
--     Log = function(level, msg) end,
--     OnState = function(state) end,    -- { code, text, connected, loggedIn }
--     OnReply = function(line) end,     -- MA2 only
--     OnError = function(text) end,
--   })
--   out:Configure({ ip = "10.0.0.5", port = 30000, user = "administrator", pass = "" })
--   out:Tick(now)                       -- call regularly (main timer)
--   out:Send("SpecialMaster 3.1 At 128", "tempo")

MAOutput = {}
MAOutput.__index = MAOutput

local STATUS = { OK = 0, Compromised = 1, Fault = 2, Missing = 4, Initializing = 5 }
MAOutput.Status = STATUS

local BACKOFF = { 1, 2, 4, 8, 15, 30 }
local CONNECT_TIMEOUT = 6     -- TCP connect must finish within this time (s)
local LOGIN_GRACE = 3         -- no login answer within this time: assume logged in (s)
local KEEPALIVE = 20          -- empty line to the MA2 command line (s)
local MIN_SPACING = 0.25      -- minimum time between two commands (s)

local function trim(s) return (tostring(s or ""):gsub("^%s+", ""):gsub("%s+$", "")) end

-- Remove Telnet negotiation (IAC sequences) and ANSI escape codes
function MAOutput.CleanTelnet(data)
  data = data:gsub("\255\250.-\255\240", "")         -- IAC SB ... IAC SE
  data = data:gsub("\255[\251-\254].", "")           -- IAC WILL/WONT/DO/DONT opt
  data = data:gsub("\255[\241-\249]", "")            -- other two-byte IAC commands
  data = data:gsub("\27%[[%d;?]*[%a]", "")           -- ANSI CSI
  return data
end

-- OSC message with a single string argument
function MAOutput.EncodeOsc(address, text)
  local function pad(s)
    s = s .. "\0"
    return s .. string.rep("\0", (4 - #s % 4) % 4)
  end
  return pad(address) .. pad(",s") .. pad(text)
end

function MAOutput.New(kind, handlers)
  local self = setmetatable({
    kind = kind,
    h = handlers or {},
    cfg = {},
    now = 0,
    phase = "idle",         -- idle | connecting | login | ready | waiting
    phaseSince = 0,
    attempt = 0,
    retryAt = nil,
    sock = nil,
    udp = nil,
    buffer = "",
    lastTx = -100,
    lastKeepalive = 0,
    order = {}, pending = {}, seq = 0,
    state = { code = STATUS.Initializing, text = "Starting", connected = false, loggedIn = false },
  }, MAOutput)
  return self
end

function MAOutput:Log(level, msg)
  if self.h.Log then self.h.Log(level, msg) end
end

function MAOutput:SetState(code, text, connected, loggedIn)
  local s = self.state
  if s.code == code and s.text == text and s.connected == connected and s.loggedIn == loggedIn then return end
  self.state = { code = code, text = text, connected = connected, loggedIn = loggedIn }
  if self.h.OnState then self.h.OnState(self.state) end
end

function MAOutput:Error(text)
  self:Log(1, "Error: " .. text)
  if self.h.OnError then self.h.OnError(text) end
end

function MAOutput:SetPhase(p)
  self.phase, self.phaseSince = p, self.now
end

-- cfg: ip, port, user, pass (MA2), prefix (MA3). Reconnects only when something changed.
function MAOutput:Configure(cfg)
  local c = {
    ip = trim(cfg.ip), port = math.floor(tonumber(cfg.port) or 0),
    user = trim(cfg.user), pass = cfg.pass or "", prefix = trim(cfg.prefix),
  }
  local o = self.cfg
  if o.ip == c.ip and o.port == c.port and o.user == c.user and o.pass == c.pass and o.prefix == c.prefix then return end
  self.cfg = c
  self.attempt = 0
  self:Start()
end

function MAOutput:Start()
  self:Close()
  self.retryAt = nil
  local c = self.cfg
  if c.ip == "" then
    self:SetPhase("idle")
    self:SetState(STATUS.Missing, "No IP address set", false, false)
    return
  end
  if self.kind == "grandMA3" then
    self:StartOsc()
  else
    self:StartTelnet()
  end
end

function MAOutput:Close()
  if self.sock then
    local s = self.sock
    self.sock = nil   -- the event handler ignores events from other sockets
    pcall(function() s:Disconnect() end)
  end
  self.buffer = ""
end

function MAOutput:ScheduleRetry(reason)
  self:Close()
  self.attempt = self.attempt + 1
  local delay = BACKOFF[math.min(self.attempt, #BACKOFF)]
  self.retryAt = self.now + delay
  self:SetPhase("waiting")
  self:SetState(STATUS.Missing, ("%s - retry in %ds"):format(reason, delay), false, false)
  self:Log(1, ("%s, retry in %ds"):format(reason, delay))
end

function MAOutput:Reconnect()
  self.attempt = 0
  self:Start()
end

---------------------------------------------------------------------------
-- grandMA3: OSC over UDP
---------------------------------------------------------------------------
function MAOutput:StartOsc()
  if not self.udp then
    local udp = UdpSocket.New()
    -- Open() without arguments binds to any local interface and a free port.
    local ok, err = pcall(function() udp:Open() end)
    if not ok then
      self:SetPhase("idle")
      self:SetState(STATUS.Fault, "UDP socket could not be opened", false, false)
      self:Error("UDP open failed: " .. tostring(err))
      return
    end
    self.udp = udp
  end
  self:SetPhase("ready")
  local port = self.cfg.port > 0 and self.cfg.port or 8000
  self:SetState(STATUS.OK, ("Sending OSC to %s:%d (MA3 sends no reply)"):format(self.cfg.ip, port), true, true)
end

---------------------------------------------------------------------------
-- grandMA2: Telnet
---------------------------------------------------------------------------
function MAOutput:StartTelnet()
  local c = self.cfg
  local port = c.port > 0 and c.port or 30000
  local sock = TcpSocket.New()
  sock.ReadTimeout = 0
  sock.WriteTimeout = 0
  sock.ReconnectTimeout = 0  -- reconnect is handled here
  self.sock = sock
  self:SetPhase("connecting")
  self:SetState(STATUS.Initializing, ("Connecting to %s:%d"):format(c.ip, port), false, false)
  self:Log(1, ("Telnet connecting to %s:%d"):format(c.ip, port))
  sock.EventHandler = function(s, evt, err)
    if self.sock ~= s then return end  -- stale socket
    if evt == TcpSocket.Events.Connected then
      self:OnConnected()
    elseif evt == TcpSocket.Events.Data then
      local n = s.BufferLength
      if n and n > 0 then self:OnData(s:Read(n) or "") end
    elseif evt == TcpSocket.Events.Closed then
      self:Error("connection closed by console")
      self:ScheduleRetry("Connection lost")
    elseif evt == TcpSocket.Events.Error then
      self:Error("socket error: " .. tostring(err))
      self:ScheduleRetry("Connection error")
    elseif evt == TcpSocket.Events.Timeout then
      self:ScheduleRetry("Socket timeout")
    end
  end
  sock:Connect(c.ip, port)
end

function MAOutput:WriteLine(line, quiet)
  if not self.sock then return false end
  if not quiet then self:Log(2, "> " .. line) end
  self.sock:Write(line .. "\r\n")
  return true
end

function MAOutput:OnConnected()
  self.lastKeepalive = self.now
  local c = self.cfg
  if c.user == "" then
    self:SetPhase("ready")
    self:SetState(STATUS.OK, "Connected (no login)", true, true)
    return
  end
  self:SetPhase("login")
  self:SetState(STATUS.Initializing, "Connected, logging in as " .. c.user, true, false)
  local function q(s) return '"' .. tostring(s):gsub('"', "") .. '"' end
  self:WriteLine("Login " .. q(c.user) .. " " .. q(c.pass), true)
  self:Log(2, "> Login " .. q(c.user) .. " \"***\"")
end

function MAOutput:OnData(data)
  self.buffer = self.buffer .. MAOutput.CleanTelnet(data)
  if #self.buffer > 16384 then self.buffer = self.buffer:sub(-4096) end
  while true do
    local i = self.buffer:find("[\r\n]")
    if not i then break end
    local line = trim(self.buffer:sub(1, i - 1))
    self.buffer = self.buffer:sub(i + 1)
    if line ~= "" then self:OnLine(line) end
  end
end

function MAOutput:OnLine(line)
  self:Log(2, "< " .. line)
  if self.h.OnReply then self.h.OnReply(line) end
  local lower = line:lower()
  if self.phase == "login" then
    if lower:find("logged in") then
      self:SetPhase("ready")
      self:SetState(STATUS.OK, "Logged in as " .. self.cfg.user, true, true)
      return
    end
    if lower:find("error") or lower:find("denied") or lower:find("failed") or lower:find("wrong") then
      self:SetPhase("idle")
      self:Close()
      self:SetState(STATUS.Fault, "Login failed - check user and password", false, false)
      self:Error("login failed: " .. line)
      return
    end
  end
  if lower:find("^error") or lower:find("error #") then self:Error(line) end
end

---------------------------------------------------------------------------
-- Queue and timer
---------------------------------------------------------------------------
-- Queue a command line. Commands with the same key replace each other while pending.
function MAOutput:Send(cmd, key)
  cmd = trim(cmd)
  if cmd == "" then return end
  if not key then self.seq = self.seq + 1; key = "#" .. self.seq end
  if self.pending[key] == nil then self.order[#self.order + 1] = key end
  self.pending[key] = cmd
end

function MAOutput:IsReady()
  return self.phase == "ready"
end

function MAOutput:Transmit(cmd)
  if self.kind == "grandMA3" then
    local c = self.cfg
    local address = (c.prefix ~= "" and ("/" .. c.prefix:gsub("^/+", ""):gsub("/+$", "")) or "") .. "/cmd"
    local port = c.port > 0 and c.port or 8000
    local ok, err = pcall(function() self.udp:Send(c.ip, port, MAOutput.EncodeOsc(address, cmd)) end)
    if not ok then
      self:Error("UDP send failed: " .. tostring(err))
      self:SetState(STATUS.Fault, "UDP send failed", false, false)
      return false
    end
    self:Log(2, ("> %s %s"):format(address, cmd))
    return true
  end
  return self:WriteLine(cmd)
end

function MAOutput:Tick(now)
  self.now = now
  if self.phase == "waiting" and self.retryAt and now >= self.retryAt then
    self:Start()
  elseif self.phase == "connecting" and now - self.phaseSince > CONNECT_TIMEOUT then
    self:Error("connect timeout")
    self:ScheduleRetry("No answer from console")
  elseif self.phase == "login" and now - self.phaseSince > LOGIN_GRACE then
    -- the MA2 login answer is not documented; no error within the grace time = logged in
    self:Log(1, "No login confirmation received, assuming logged in")
    self:SetPhase("ready")
    self:SetState(STATUS.OK, "Connected as " .. self.cfg.user, true, true)
  end

  if self.phase ~= "ready" then return end
  if self.kind == "grandMA2" and now - self.lastKeepalive >= KEEPALIVE then
    self.lastKeepalive = now
    self:WriteLine("", true)
  end
  if #self.order > 0 and now - self.lastTx >= MIN_SPACING then
    local key = table.remove(self.order, 1)
    local cmd = self.pending[key]
    self.pending[key] = nil
    if cmd and self:Transmit(cmd) then
      self.lastTx = now
      if self.h.OnSent then self.h.OnSent(cmd) end
    end
  end
end
-- <<< ma_output.lua
  -- >>> runtime.lua
-- (c) levo AVL | Elias Jenny - MIT License
-- Runtime code: only runs on the Core or in Emulation mode.

local Opt = Options(Properties)
local DebugLevel = ({ None = 0, Basic = 1, Verbose = 2 })[Properties["Debug Print"].Value] or 0

local TICK = 0.01             -- main timer: level polling and beat clock (s)
local UI_INTERVAL = 0.1       -- display refresh for BPM, state, meters (s)
local NO_LEVEL_WARN = 5       -- no level change for this long -> warning (s)

local function Log(level, msg)
  if level <= DebugLevel then print(("[Beat Analyzer] %s"):format(msg)) end
end

---------------------------------------------------------------------------
-- Clock. Timer.Now() is preferred (wall time, not affected by a late timer tick);
-- if it is not available the tick count is used.
---------------------------------------------------------------------------
local ClockSource, TickTime = "tick counter", 0
local function Clock() return TickTime end
do
  local ok, v = pcall(function() return Timer.Now() end)
  if ok and type(v) == "number" then
    ClockSource = "Timer.Now"
    Clock = function() return Timer.Now() end
  end
end

---------------------------------------------------------------------------
-- Control helpers (only write when the value changes)
---------------------------------------------------------------------------
local function Ctl(name) return Controls[name] end

local function SetString(name, s)
  local c = Ctl(name)
  s = s or ""
  if c and c.String ~= s then c.String = s end
end

local function SetBool(name, b)
  local c = Ctl(name)
  if c and c.Boolean ~= b then c.Boolean = b end
end

local function SetValue(name, v, eps)
  local c = Ctl(name)
  if c and math.abs(c.Value - v) > (eps or 0) then c.Value = v end
end

local function Num(name, default)
  local c = Ctl(name)
  return c and c.Value or default
end

local function Text(name)
  local c = Ctl(name)
  return c and c.String:gsub("^%s+", ""):gsub("%s+$", "") or ""
end

local STATUS = MAOutput.Status
local function SetStatus(code, text)
  local c = Controls.Status
  if c.Value ~= code then c.Value = code end
  SetString("Status", text)
end

local LastErrorText = ""
local function SetError(text)
  LastErrorText = text or ""
  SetString("Last Error", LastErrorText)
end

---------------------------------------------------------------------------
-- Defaults for text fields (knobs and toggles get theirs from DefaultValue)
---------------------------------------------------------------------------
local DEFAULT_TEMPLATE = {
  grandMA2 = "SpecialMaster 3.{master} At {bpm}",
  grandMA3 = "Master 3.{master} At BPM {bpm}",
}
local function DefaultText(name, value)
  local c = Ctl(name)
  if c and c.String:match("^%s*$") then c.String = value end
end
DefaultText("Kick Control", "meter.1")
DefaultText("Snare Control", "meter.1")
if Opt.Console ~= "None" then DefaultText("Command Template", DEFAULT_TEMPLATE[Opt.Console]) end
if Opt.Console == "grandMA2" then DefaultText("Username", "administrator") end

---------------------------------------------------------------------------
-- Beat engine
---------------------------------------------------------------------------
local Engine = BeatEngine.New({})

local function ConfigureEngine()
  local lo, hi = math.floor(Num("BPM Min", 80)), math.floor(Num("BPM Max", 160))
  Engine:Configure({
    bpmMin = lo, bpmMax = hi,
    sensitivity = Num("Sensitivity", 50) / 100,
    minConfidence = Num("Min Confidence", 50) / 100,
  })
  if Engine.bpmMax ~= hi then
    SetError(("BPM range %d-%d is less than an octave, using %d-%d"):format(lo, hi, Engine.bpmMin, Engine.bpmMax))
  end
  Log(1, ("Detection: %d-%d BPM, sensitivity %d%%, min confidence %d%%"):format(
    Engine.bpmMin, Engine.bpmMax, math.floor(Num("Sensitivity", 50)), math.floor(Num("Min Confidence", 50))))
end
ConfigureEngine()
for _, name in ipairs({ "BPM Min", "BPM Max", "Sensitivity", "Min Confidence" }) do
  Ctl(name).EventHandler = ConfigureEngine
end

Engine:SetAuto(Controls.Auto.Boolean)
Engine:SetHold(Controls.Hold.Boolean)
Controls.Auto.EventHandler = function(c) Engine:SetAuto(c.Boolean) end
Controls.Hold.EventHandler = function(c) Engine:SetHold(c.Boolean) end

local function ScaleText(f)
  if f >= 1 then return ("x%d"):format(math.floor(f + 0.5)) end
  return ("x1/%d"):format(math.floor(1 / f + 0.5))
end
local function SetScale(f)
  Engine:SetScale(f)
  SetString("Tempo Scale", ScaleText(Engine.scale))
  Log(1, "Tempo scale " .. ScaleText(Engine.scale))
end
SetString("Tempo Scale", ScaleText(1))

Controls.Tap.EventHandler = function() Engine:Tap(Clock()) end
Controls.Half.EventHandler = function() SetScale(Engine.scale / 2) end
Controls.Double.EventHandler = function() SetScale(Engine.scale * 2) end
Controls.Resync.EventHandler = function() Engine:Resync(Clock()); Log(1, "Resync") end
Controls["Shift Half Beat"].EventHandler = function() Engine:ShiftHalf(); Log(1, "Shift half beat") end

---------------------------------------------------------------------------
-- Level sources
---------------------------------------------------------------------------
local Level = { db = -100, db2 = nil, changes = 0, lastChange = -100, rate = 0, rateT = 0, problem = nil }

-- Named components: resolved lazily, re-resolved when the names change.
-- Slot 1 = kick band, slot 2 = second band.
local Named = { {}, {} }
local function ResolveNamed(slot, now)
  local prefix = slot == 1 and "Kick" or "Snare"
  local n = Named[slot]
  local compName, ctlName = Text(prefix .. " Component"), Text(prefix .. " Control")
  local key = compName .. "|" .. ctlName
  if key == n.key and (n.ctl or now < (n.nextTry or 0)) then return n.ctl, n.problem end
  n.key, n.ctl, n.nextTry, n.problem = key, nil, now + 2, nil
  local band = slot == 1 and " (kick)" or " (snare)"
  if compName == "" then
    n.problem = "No meter component name set" .. band
    return nil, n.problem
  end
  local ok, comp = pcall(function() return Component.New(compName) end)
  if not ok or not comp then
    n.problem = ("Component '%s' not found - check its Code Name and Script Access"):format(compName)
    return nil, n.problem
  end
  local ok2, ctl = pcall(function() return comp[ctlName] end)
  if not ok2 or not ctl then
    n.problem = ("Control '%s' not found in '%s'"):format(ctlName, compName)
    return nil, n.problem
  end
  n.ctl = ctl
  Log(1, ("Reading level%s from %s / %s"):format(band, compName, ctlName))
  return ctl, nil
end

local function NamedValue(slot, now)
  local ctl, problem = ResolveNamed(slot, now)
  if not ctl then return -100, problem end
  local ok, v = pcall(function() return ctl.Value end)
  return ok and tonumber(v) or -100, nil
end

-- Test generator: kicks on every beat and, for the second band, a snare on beats 2 and 4,
-- at "Test BPM" with jitter, dropouts and a breakdown switch, sampled like a meter that
-- updates every "Test Update" ms.
local Gen = { nextHit = nil, beat = 0, lastKick = -10, lastSnare = -10, nextUpdate = 0, db = -45, db2 = -50 }
local function Decay(age, peak, len) return (age >= 0 and age < len) and (peak - age / len * 37) or -100 end
local function GeneratorLevel(now)
  local bpm = math.max(40, Num("Test BPM", 128))
  local P = 60 / bpm
  if not Gen.nextHit or Gen.nextHit < now - 1 then Gen.nextHit = now + 0.2 end
  local breakdown = Controls["Test Breakdown"].Boolean
  while now >= Gen.nextHit do
    Gen.beat = Gen.beat % 4 + 1
    local jitter = (math.random() * 2 - 1) * Num("Test Jitter", 5) / 1000
    if not breakdown and math.random() * 100 >= Num("Test Dropout", 10) then
      Gen.lastKick = Gen.nextHit + jitter
    end
    if (Gen.beat == 2 or Gen.beat == 4) and not breakdown then Gen.lastSnare = Gen.nextHit + jitter end
    Gen.nextHit = Gen.nextHit + P
  end
  if now >= Gen.nextUpdate then
    local floor = breakdown and -30 or -45
    Gen.db = math.max(Decay(now - Gen.lastKick, -8, 0.18), floor) + (math.random() * 3 - 1.5)
    Gen.db2 = math.max(Decay(now - Gen.lastSnare, -12, 0.12), floor - 5) + (math.random() * 3 - 1.5)
    Gen.nextUpdate = now + math.max(0.01, Num("Test Update", 20) / 1000)
  end
  return Gen.db, Gen.db2
end

-- Returns kick level, second band level (nil with one band), problem text
local function ReadLevel(now)
  local db, db2, p1, p2
  if Opt.LevelSource == "Test Generator" then
    db, db2 = GeneratorLevel(now)
  elseif Opt.LevelSource == "Named Component" then
    db, p1 = NamedValue(1, now)
    if Opt.Bands == 2 then db2, p2 = NamedValue(2, now) end
  else
    db = Num("Kick Level", -100)
    if Opt.Bands == 2 then db2 = Num("Snare Level", -100) end
  end
  if Opt.Bands < 2 then db2 = nil end
  return db, db2, p1 or p2
end

---------------------------------------------------------------------------
-- Console output
---------------------------------------------------------------------------
local NextUi = 0
local Out = nil
local OutState = { code = STATUS.OK, text = "Detection only", connected = false, loggedIn = false }
local LastSentBpm = nil

if Opt.Console ~= "None" then
  Out = MAOutput.New(Opt.Console, {
    Log = Log,
    OnState = function(s)
      local wasReady = OutState.code == STATUS.OK and OutState.loggedIn
      OutState = s
      NextUi = 0          -- show the new status on the next tick
      SetBool("Connected", s.connected)
      SetBool("Logged In", s.loggedIn)
      if s.code == STATUS.OK and s.loggedIn and not wasReady then
        LastSentBpm = nil   -- (re)connected: send the current tempo again
      end
    end,
    OnReply = function(line) SetString("Last Reply", line) end,
    OnError = function(text) SetError(text) end,
    OnSent = function(cmd) SetString("Last Command", cmd) end,
  })
  local function ConfigureOut()
    Out:Configure({
      ip = Text("IP Address"), port = Num("Port", 0),
      user = Text("Username"), pass = Ctl("Password") and Controls.Password.String or "",
      prefix = Text("OSC Prefix"),
    })
  end
  for _, name in ipairs({ "IP Address", "Port", "Username", "Password", "OSC Prefix" }) do
    if Ctl(name) then Ctl(name).EventHandler = ConfigureOut end
  end
  if Ctl("Reconnect") then Controls.Reconnect.EventHandler = function() Out:Reconnect() end end
  ConfigureOut()
end

local function FormatBpm(bpm) return ("%.1f"):format(bpm) end

local function WholeBpm() return Ctl("Whole BPM") ~= nil and Controls["Whole BPM"].Boolean end

-- Value as it goes to the console: whole numbers or one decimal
local function SendValue(bpm)
  if WholeBpm() then return math.floor(bpm + 0.5) end
  return math.floor(bpm * 10 + 0.5) / 10
end
local function FormatSent(v)
  return WholeBpm() and tostring(math.floor(v)) or FormatBpm(v)
end

local function TempoCommand(value)
  local template = Text("Command Template")
  if not template:find("{bpm}", 1, true) then
    SetError("Command Template needs a {bpm} placeholder")
    return nil
  end
  return (template:gsub("{master}", tostring(math.floor(Num("Speed Master", 1))))
                  :gsub("{bpm}", FormatSent(value)))
end

local function SendTempo(bpm, reason)
  local value = SendValue(bpm)
  local cmd = TempoCommand(value)
  if not cmd then return end
  Out:Send(cmd, "tempo")
  LastSentBpm = value
  SetString("Last Sent", FormatSent(value) .. " BPM")
  Log(1, ("Tempo %s BPM (%s)"):format(FormatSent(value), reason))
end

local function CheckSend(now)
  if not Out or not Controls["Send Enable"].Boolean or not Out:IsReady() then return end
  if Engine.hold then return end
  local bpm = Engine:Bpm()
  if not bpm or not Engine:IsPrecise(now) then return end
  if LastSentBpm == nil then
    SendTempo(bpm, "locked")
    return
  end
  local hyst = Num("Send Hysteresis", 0.5)
  if WholeBpm() then
    -- a new whole number only when the tempo is clearly past the half-way point,
    -- so 127.5 does not flap between 127 and 128
    hyst = math.max(hyst, 0.7)
  end
  if SendValue(bpm) ~= LastSentBpm and math.abs(bpm - LastSentBpm) >= hyst then
    SendTempo(bpm, "changed")
  end
end

if Ctl("Whole BPM") then
  Controls["Whole BPM"].EventHandler = function() LastSentBpm = nil end   -- resend in the new format
end

if Ctl("Send Now") then
  Controls["Send Now"].EventHandler = function()
    local bpm = Engine:Bpm()
    if not bpm then SetError("No tempo to send yet"); return end
    if not Out:IsReady() then SetError("Console not ready") end
    SendTempo(bpm, "manual")
  end
end

---------------------------------------------------------------------------
-- Display
---------------------------------------------------------------------------
local Pulse = { beatOff = 0, downOff = 0, onsetOff = 0 }
local ShownWhole = nil   -- whole BPM currently shown

local function UpdateDisplay(now)
  local bpm = Engine:Bpm()
  SetValue("BPM", bpm and math.floor(bpm * 10 + 0.5) / 10 or 0, 0.01)
  -- big display: whole numbers when "Whole BPM" is on (same 0.7 BPM lock as for sending);
  -- the BPM pin and the Debug page keep the exact value
  if not bpm then
    ShownWhole = nil
    SetString("BPM Text", "---")
  elseif WholeBpm() then
    if not ShownWhole or math.abs(bpm - ShownWhole) >= 0.7 then ShownWhole = math.floor(bpm + 0.5) end
    SetString("BPM Text", tostring(ShownWhole))
  else
    SetString("BPM Text", FormatBpm(bpm))
  end
  local locked = Engine:IsLocked(now)
  SetBool("Locked", locked)
  SetString("Detection State", Engine:State(now))
  SetValue("Confidence", math.floor(Engine.confidence * 100 + 0.5))
  SetValue("Kick Meter", math.max(-60, math.min(0, Level.db)), 0.1)
  if Level.db2 then SetValue("Snare Meter", math.max(-60, math.min(0, Level.db2)), 0.1) end
  SetValue("Onset Strength", math.min(40, Engine.strength), 0.1)
  SetString("Onset Threshold", ("%.1f dB"):format(Engine.threshold))
  SetString("Onset Count", tostring(Engine.onsetCount))
  SetString("Level Updates", ("%d/s (clock: %s)"):format(Level.rate, ClockSource))
  local parts = {}
  for _, c in ipairs(Engine:Candidates(3)) do
    parts[#parts + 1] = ("%.1f (%d%%)"):format(c.bpm, math.floor(c.share * 100 + 0.5))
  end
  SetString("Tempo Candidates", table.concat(parts, "  "))
end

local function UpdateStatus(now)
  local audio = Level.problem
  if not audio and Opt.LevelSource ~= "Test Generator" and now - Level.lastChange > NO_LEVEL_WARN then
    audio = Opt.LevelSource == "Wired Pin" and "No level updates on the Kick Level pin" or "No level updates from the kick meter"
  end
  if not audio and Opt.Bands == 2 and Opt.LevelSource ~= "Test Generator" and (Level.db2 or -100) <= -100 then
    audio = "No level on the snare input"
  end
  local code, text = OutState.code, OutState.text
  if audio then
    if code == STATUS.OK then code = STATUS.Compromised end
    text = (Out and (text .. " | ") or "") .. audio
  elseif not Out then
    text = "Detection only"
  end
  SetStatus(code, text)
end

---------------------------------------------------------------------------
-- Main timer
---------------------------------------------------------------------------
local MainTimer = Timer.New()
-- Keep long-lived objects reachable from a global. A timer that is only held by
-- a local variable gets garbage collected on the Core and silently stops.
BeatAnalyzerRuntime = { Timer = MainTimer, Engine = Engine, Out = Out }

local function OnTick()
  TickTime = TickTime + TICK
  local now = Clock()

  -- level in, onsets
  local db, db2, problem = ReadLevel(now)
  Level.problem = problem
  if db ~= Level.db or db2 ~= Level.db2 then
    Level.db2 = db2
    Level.changes = Level.changes + 1
    Level.lastChange = now
    Level.db = db
  end
  if now - Level.rateT >= 1 then
    Level.rate = math.floor(Level.changes / (now - Level.rateT) + 0.5)
    Level.changes, Level.rateT = 0, now
  end
  if Engine:Feed(now, db, db2, Num("Snare Weight", 50) / 100) then
    SetBool("Onset", true)
    Pulse.onsetOff = now + 0.06
    if DebugLevel >= 2 then Log(2, ("Onset %.1f dB (threshold %.1f)"):format(Engine.strength, Engine.threshold)) end
  end

  -- beat clock; a positive Beat Offset fires the beat earlier
  local lead = Num("Beat Offset", 0) / 1000
  for _, ev in ipairs(Engine:Update(now, lead)) do
    local P = Engine:ClockPeriod() or 0.5
    local len = math.max(0.05, math.min(0.15, P * 0.35))
    SetBool("Beat", true)
    Pulse.beatOff = now + len
    for i = 1, 4 do SetBool("Bar " .. i, i == ev.bar) end
    SetValue("Bar Position", ev.bar)
    if ev.bar == 1 then
      SetBool("Downbeat", true)
      Pulse.downOff = now + len
    end
  end
  if now >= Pulse.beatOff then SetBool("Beat", false) end
  if now >= Pulse.downOff then SetBool("Downbeat", false) end
  if now >= Pulse.onsetOff then SetBool("Onset", false) end
  if not Engine:Bpm() then
    for i = 1, 4 do SetBool("Bar " .. i, false) end
  end

  -- output
  CheckSend(now)
  if Out then Out:Tick(now) end

  if now >= NextUi then
    NextUi = now + UI_INTERVAL
    UpdateDisplay(now)
    UpdateStatus(now)
  end
end

MainTimer.EventHandler = function()
  local ok, err = pcall(OnTick)
  if not ok then
    SetError("Runtime error: " .. tostring(err))
    Log(1, "Runtime error: " .. tostring(err))
  end
end

---------------------------------------------------------------------------
-- Start
---------------------------------------------------------------------------
SetStatus(STATUS.Initializing, "Starting")
Level.rateT, Level.lastChange = Clock(), Clock()
Log(1, ("Beat Analyzer %s started: source %s, console %s, clock %s"):format(
  PluginInfo.BuildVersion, Opt.LevelSource, Opt.Console, ClockSource))
MainTimer:Start(TICK)
-- <<< runtime.lua
end
